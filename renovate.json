{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": ["/^clusters/homelab/.+\\.ya?ml$/"]
  },
  "nix": {
    "enabled": true
  },
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Keep OctoBot on the last image compatible with its retained config.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["drakkarsoftware/octobot"],
      "matchFileNames": ["clusters/homelab/apps/octobot/values.yaml"],
      "allowedVersions": "2.1.1"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  }
}
