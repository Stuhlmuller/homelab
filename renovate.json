{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": ["/^clusters/homelab/.+\\.ya?ml$/"]
  },
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Keep OctoBot on the last image compatible with its retained config.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["drakkarsoftware/octobot"],
      "matchFileNames": ["clusters/homelab/apps/octobot/values.yaml"],
      "allowedVersions": "2.1.1"
    },
    {
      "description": "Image Updater exclusively owns enrolled Chainguard Harbor targets.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "harbor.stinkyboi.com/homelab/chainguard-python",
        "harbor.stinkyboi.com/homelab/chainguard-curl"
      ],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
