  "installationPhases": [
    "foundation",
    "lifecycle-validation",
    "production-inactive",
    "active"
  ],
  "bootstrap": {
    "passwordFile": "/private/openclaw-enterprise/bootstrap/initial-admin-password",
    "serviceKeyFile": "/private/openclaw-enterprise/bootstrap/initial-admin-service-key.json",
    "producer": "upstream-initialization-job"
  },
  "gatewayIdentity": {
    "apiKeyParameter": "/homelab/openclaw-enterprise/gateway-api-key",
    "caProducer": "cert-manager",
    "caSecretName": "occ-private-gateway-root"
  }
