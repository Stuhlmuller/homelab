{
  "schema_version": 1,
  "imports_paused": false,
  "import_schedule": "0 * * * *",
  "verification_interval_minutes": 5,
  "images": [
    {
      "image_id": "chainguard-python",
      "source": "cgr.dev/chainguard/python:latest",
      "destination": "harbor.stinkyboi.com/homelab/chainguard-python:latest",
      "access_class": "public",
      "required_platforms": ["linux/amd64", "linux/arm64"],
      "release_recipe": "python-release-v1"
    },
    {
      "image_id": "chainguard-curl",
      "source": "cgr.dev/chainguard/curl:latest",
      "destination": "harbor.stinkyboi.com/homelab/chainguard-curl:latest",
      "access_class": "public",
      "required_platforms": ["linux/amd64", "linux/arm64"],
      "release_recipe": "curl-release-v1"
    }
  ],
  "consumers": [
    {
      "consumer_id": "harbor-vulnerability-exporter",
      "application_id": "harbor-vulnerability-exporter",
      "image_id": "chainguard-python",
      "target": "/clusters/homelab/apps/harbor/vulnerability-exporter.yaml",
      "migration_status": "candidate",
      "automation_status": "not-enrolled",
      "owner": "argocd"
    },
    {
      "consumer_id": "kiali-prometheus-readiness",
      "application_id": "kiali",
      "image_id": "chainguard-curl",
      "target": "/clusters/homelab/apps/kiali/values.yaml",
      "migration_status": "candidate",
      "automation_status": "not-enrolled",
      "owner": "argocd"
    }
  ],
  "applications": [
    {
      "application_id": "harbor-vulnerability-exporter",
      "consumer_ids": ["harbor-vulnerability-exporter"],
      "preflight_recipe": "python-workload-v1",
      "health_recipe": "python-workload-v1",
      "recovery_recipe": "stateless-recovery-v1",
      "deadline_minutes": 30,
      "evidence": {
        "preflight": {"uid": 65532, "read_only_root": true, "ca_trust": true,
          "health_endpoint": "/livez", "data_paths": ["/app", "/secrets"]},
        "health": {"uid": 65532, "read_only_root": true, "ca_trust": true,
          "health_endpoint": "/metrics", "data_paths": ["/app", "/secrets"]},
        "recovery": {"known_good_digest": "sha256:218761489de417a6eb0808e264cbdd7043ec6659fe5a61898815e9848536541d",
          "data_safety": "safe", "single_attempt": true}
      }
    },
    {
      "application_id": "kiali",
      "consumer_ids": ["kiali-prometheus-readiness"],
      "preflight_recipe": "curl-workload-v1",
      "health_recipe": "curl-workload-v1",
      "recovery_recipe": "stateless-recovery-v1",
      "deadline_minutes": 30,
      "evidence": {
        "preflight": {"command": ["curl"], "retry": 60, "timeout": 10,
          "run_as_non_root": true, "read_only_root": true,
          "health_endpoint": "http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090/-/ready"},
        "health": {"command": ["curl"], "retry": 60, "timeout": 10,
          "run_as_non_root": true, "read_only_root": true,
          "health_endpoint": "http://prometheus-kube-prometheus-prometheus.monitoring.svc.cluster.local:9090/-/ready"},
        "recovery": {"known_good_digest": "sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777",
          "data_safety": "safe", "single_attempt": true}
      }
    }
  ]
}
