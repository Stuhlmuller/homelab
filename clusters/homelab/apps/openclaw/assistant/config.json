{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/free",
        "fallbacks": []
      },
      "models": {
        "openrouter/free": {
          "alias": "free"
        }
      },
      "thinkingDefault": "medium",
      "userTimezone": "America/Los_Angeles",
      "timeoutSeconds": 3600,
      "heartbeat": {
        "every": "1h",
        "model": "openrouter/free",
        "target": "owner",
        "activeHours": {
          "start": "08:00",
          "end": "22:00",
          "timezone": "America/Los_Angeles"
        },
        "timeoutSeconds": 600,
        "prompt": "Read HEARTBEAT.md in your workspace and follow it. Only follow up on explicitly tracked work or a completed background task. Recurring homelab checks have separate automation jobs. If nothing meaningful needs the owner, reply exactly NO_REPLY."
      },
      "maxConcurrent": 4
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "group:web",
      "group:messaging",
      "automations",
      "heartbeat_respond"
    ],
    "loopDetection": {
      "enabled": true
    },
    "fs": {
      "workspaceOnly": true
    }
  },
  "cron": {
    "enabled": true,
    "sessionRetention": "24h"
  },
  "diagnostics": {
    "otel": {
      "enabled": false
    }
  },
  "secrets": {
    "providers": {
      "litellm": {
        "source": "file",
        "path": "/data/openclaw/tmp/openclaw-1000/litellm-token",
        "mode": "singleValue"
      }
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "baseUrl": "http://litellm.ai.svc.cluster.local:4000/v1",
        "api": "openai-completions",
        "headers": {
          "x-litellm-api-key": {
            "source": "file",
            "provider": "litellm",
            "id": "value"
          }
        }
      }
    }
  },
  "skills": {
    "entries": {
      "gog": {
        "enabled": true
      }
    }
  }
}
