<clickhouse>
    <!-- Corrupt diagnostic parts caused sustained NFS merge retries on 2026-10-05.
         The init container marks them detached before metadata loading.
         Keep their writers disabled; retain all files for investigation.
         Application tables, including Langfuse traces, keep their normal writers. -->
    <error_log remove="1" />
    <histogram_metric_log remove="1" />
    <opentelemetry_span_log remove="1" />
    <part_log remove="1" />
    <query_log remove="1" />
    <text_log remove="1" />
</clickhouse>
