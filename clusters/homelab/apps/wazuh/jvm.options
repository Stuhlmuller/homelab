-Xms2g
-Xmx2g

# Native override directory is read after the packaged jvm.options:
# https://github.com/wazuh/wazuh-indexer/blob/v4.14.8/distribution/tools/launchers/src/main/java/org/opensearch/tools/launchers/JvmOptionsParser.java
# Clear the packaged GC file output, restore JVM warnings, and keep its GC detail.
# https://docs.oracle.com/en/java/javase/21/docs/specs/man/java.html#enable-logging-with-the-jvm-unified-logging-framework
-Xlog:disable
-Xlog:all=warning,gc*=info,gc+age=trace,safepoint=info:stdout:utctime,level,pid,tags

# HotSpot routes the full fatal report to stdout instead of ErrorFile, once.
# https://github.com/openjdk/jdk21u/blob/master/src/hotspot/share/utilities/vmError.cpp
-XX:+ErrorFileToStdout
# HeapDumpPath remains the image default local data directory; never ship dumps.
