<group name="homelab,">
  <!-- Unmatched normal events remain searchable through archive indexing. -->
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="homelab_source">.+</field>
    <description>Homelab structured log.</description>
  </rule>
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="homelab_source">^kubernetes.container$</field>
    <field name="log">homelab_siem_canary</field>
    <description>Homelab SIEM canary reached the detection pipeline.</description>
    <group>homelab_canary,</group>
  </rule>
  <rule id="100102" level="7">
    <if_sid>100100</if_sid>
    <field name="homelab_source">^kubernetes.audit$</field>
    <field name="responseStatus.code" type="pcre2">^(401|403)$</field>
    <description>Kubernetes API rejected authentication or authorization.</description>
    <group>authentication_failed,kubernetes_audit,</group>
  </rule>
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="homelab_source">^kubernetes.event$</field>
    <field name="type">^Warning$</field>
    <description>Kubernetes warning: $(reason).</description>
    <group>kubernetes_warning,</group>
  </rule>
  <rule id="100104" level="5">
    <if_sid>100100</if_sid>
    <field name="homelab_source">^talos$</field>
    <field name="level" type="pcre2">(?i)^(error|fatal|panic)$</field>
    <description>Talos reported an error.</description>
    <group>talos_error,</group>
  </rule>
</group>
