locals {
  shared = read_terragrunt_config(find_in_parent_folders("stack-defaults.hcl")).locals
}

inputs = {
  defaults = local.shared.argocd_defaults
  spec = {
    sources = [
      {
        repoURL        = "https://bjw-s-labs.github.io/helm-charts"
        chart          = "app-template"
        path           = "."
        targetRevision = "4.4.0"
        helm = {
          releaseName = "home-assistant"
          valueFiles  = ["$values/clusters/homelab/apps/home-assistant/values.yaml"]
        }
      },
      {
        repoURL        = local.shared.repo_url
        path           = "."
        targetRevision = local.shared.target_revision
        ref            = "values"
        directory = {
          include = ".argocd-values-ref-placeholder.yaml"
        }
      },
      {
        repoURL        = local.shared.repo_url
        path           = "clusters/homelab/apps/home-assistant"
        targetRevision = local.shared.target_revision
      }
    ]
    info = [{
      name  = "rollout"
      value = "ClusterIP with authenticated Kubernetes port-forward; retained local SQLite"
    }]
  }
}
