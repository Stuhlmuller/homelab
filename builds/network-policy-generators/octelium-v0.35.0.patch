+func TestServiceUpstreamPolicyDeniesEgress(t *testing.T) {
+	policy := getServiceUpstreamNetworkPolicy()
+	if len(policy.Spec.Egress) != 0 {
+		t.Fatalf("service upstream must have no generated egress, got %d rules", len(policy.Spec.Egress))
+	}
+	if len(policy.Spec.PolicyTypes) != 2 || policy.Spec.PolicyTypes[1] != networkingv1.PolicyTypeEgress {
+		t.Fatal("service upstream policy must isolate egress")
+	}
+}
