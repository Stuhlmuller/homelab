@@ -0,0 +1,32 @@
+// Copyright Octelium Labs, LLC. All rights reserved.
+// Licensed under the Apache License, Version 2.0.
+
+package upgrade
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes/fake"
+)
+
+func TestUpgradeGenesisUsesPinnedImage(t *testing.T) {
+	client := fake.NewSimpleClientset()
+	if err := createGenesis(context.Background(), client, "example.com", "v0.35.0", ""); err == nil {
+		t.Fatal("accepted upgrade without a pinned Genesis digest")
+	}
+	jobs, err := client.BatchV1().Jobs("octelium").List(context.Background(), metav1.ListOptions{})
+	if err != nil || len(jobs.Items) != 0 {
+		t.Fatalf("invalid image created an upgrade Job: %v, %d", err, len(jobs.Items))
+	}
+	image := "harbor.stinkyboi.com/homelab/homelab-octelium-genesis@sha256:" + strings.Repeat("b", 64)
+	if err := createGenesis(context.Background(), client, "example.com", "v0.35.0", image); err != nil {
+		t.Fatal(err)
+	}
+	jobs, err = client.BatchV1().Jobs("octelium").List(context.Background(), metav1.ListOptions{})
+	if err != nil || len(jobs.Items) != 1 || jobs.Items[0].Spec.Template.Spec.Containers[0].Image != image {
+		t.Fatalf("upgrade did not create one digest-pinned Genesis Job: %v, %d", err, len(jobs.Items))
+	}
+}
