+// Copyright Octelium Labs, LLC. All rights reserved.
+// Licensed under the Apache License, Version 2.0.
+
+package genesis
+
+import (
+	"testing"
+
+	networkingv1 "k8s.io/api/networking/v1"
+)
+
+func TestWorkspacePolicyHasOnlyNamedEgress(t *testing.T) {
+	policy := (&Genesis{}).getWSNetworkPolicy()
+	if len(policy.Spec.Egress) != 3 {
+		t.Fatalf("expected three internal/DNS egress rules, got %d", len(policy.Spec.Egress))
+	}
+	if len(policy.Spec.PolicyTypes) != 2 || policy.Spec.PolicyTypes[1] != networkingv1.PolicyTypeEgress {
+		t.Fatal("workspace policy must isolate egress")
+	}
+	for _, rule := range policy.Spec.Egress {
+		if len(rule.Ports) == 0 || len(rule.To) == 0 {
+			t.Fatal("workspace egress contains an all-port or all-destination rule")
+		}
+		for _, peer := range rule.To {
+			if peer.IPBlock != nil || peer.PodSelector == nil || peer.NamespaceSelector == nil {
+				t.Fatal("workspace egress must use a pod and namespace selector")
+			}
+		}
+	}
+}
