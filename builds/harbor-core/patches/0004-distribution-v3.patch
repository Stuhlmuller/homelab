+package schema1
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/distribution/distribution/v3"
+	"github.com/docker/libtrust"
+	"github.com/opencontainers/go-digest"
+)
+
+func TestLegacyManifestPreservesPayloadAndDigest(t *testing.T) {
+	canonical := []byte("{\n   \"schemaVersion\": 1,\n   \"name\": \"library/legacy\",\n   \"tag\": \"latest\",\n   \"architecture\": \"amd64\",\n   \"fsLayers\": [{\"blobSum\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}],\n   \"history\": [{\"v1Compatibility\": \"{}\"}]\n}")
+	key, err := libtrust.GenerateECP256PrivateKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	signature, err := libtrust.NewJSONSignature(canonical)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := signature.Sign(key); err != nil {
+		t.Fatal(err)
+	}
+	signed, err := signature.PrettySignature("signatures")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mediaType := range []string{MediaTypeSignedManifest, "", "application/json"} {
+		manifest, descriptor, err := distribution.UnmarshalManifest(mediaType, signed)
+		if err != nil {
+			t.Fatalf("%q: %v", mediaType, err)
+		}
+		if descriptor.Digest != digest.FromBytes(canonical) || descriptor.Size != int64(len(canonical)) {
+			t.Fatalf("%q: descriptor does not preserve canonical identity: %+v", mediaType, descriptor)
+		}
+		contentType, payload, err := manifest.Payload()
+		if err != nil || contentType != MediaTypeSignedManifest || !bytes.Equal(payload, signed) {
+			t.Fatalf("%q: signed payload changed", mediaType)
+		}
+		refs := manifest.References()
+		if len(refs) != 1 || refs[0].Digest != "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" {
+			t.Fatalf("%q: layer references changed: %+v", mediaType, refs)
+		}
+		var decoded SignedManifest
+		if err := json.Unmarshal(payload, &decoded); err != nil || decoded.Name != "library/legacy" {
+			t.Fatalf("%q: legacy manifest fields lost: %v", mediaType, err)
+		}
+	}
+}
+
+func TestMalformedLegacyManifestRejected(t *testing.T) {
+	for _, payload := range [][]byte{[]byte("{"), []byte("{}"), []byte("{\"signatures\": [{}]}")} {
+		if _, _, err := distribution.UnmarshalManifest(MediaTypeSignedManifest, payload); err == nil {
+			t.Fatalf("accepted malformed manifest %s", payload)
+		}
+	}
+}
