 }
+
+func (m *managerTestSuite) TestCreateIdenticalRepeatedChild() {
+	m.dao.On("Create", mock.Anything).Return(1, nil)
+	m.dao.On("CreateReference").Return(1, nil).Times(4)
+	m.dao.On("CreateReference").Return(0, errors.New("duplicate key violates unique_reference")).Maybe()
+	var references []*Reference
+	for _, childID := range []int64{2, 3, 4, 5} {
+		ref := &Reference{ChildID: childID, ChildDigest: "sha256:fixture", Platform: &v1.Platform{OS: "linux", Architecture: "amd64"}, Annotations: map[string]string{"fixture": "same"}}
+		duplicate := *ref
+		duplicate.Platform = &v1.Platform{OS: "linux", Architecture: "amd64"}
+		duplicate.Annotations = map[string]string{"fixture": "same"}
+		references = append(references, ref, &duplicate)
+	}
+	art := &Artifact{Digest: "sha256:original-index", References: references}
+	id, err := m.mgr.Create(nil, art)
+	m.Require().NoError(err)
+	m.Equal(int64(1), id)
+	m.Equal("sha256:original-index", art.Digest)
+	m.Len(art.References, 8)
+	for _, reference := range art.References {
+		m.Equal(int64(1), reference.ParentID)
+	}
+	m.dao.AssertNumberOfCalls(m.T(), "CreateReference", 4)
+}
+
+func (m *managerTestSuite) TestCreateConflictingRepeatedChild() {
+	cases := map[string]*Reference{
+		"digest":      {ChildID: 2, ChildDigest: "sha256:other"},
+		"platform":    {ChildID: 2, ChildDigest: "sha256:fixture", Platform: &v1.Platform{OS: "linux", Architecture: "arm64"}},
+		"urls":        {ChildID: 2, ChildDigest: "sha256:fixture", URLs: []string{"https://fixture.invalid/blob"}},
+		"annotations": {ChildID: 2, ChildDigest: "sha256:fixture", Annotations: map[string]string{"fixture": "different"}},
+	}
+	for name, ref := range cases {
+		m.Run(name, func() {
+			art := &Artifact{References: []*Reference{{ChildID: 2, ChildDigest: "sha256:fixture"}, ref}}
+			id, err := m.mgr.Create(nil, art)
+			m.Require().ErrorContains(err, "conflicting metadata")
+			m.Zero(id)
+			m.dao.AssertNotCalled(m.T(), "Create")
+			m.dao.AssertNotCalled(m.T(), "CreateReference")
+		})
+	}
+}
