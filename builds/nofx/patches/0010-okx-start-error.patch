@@ -0,0 +1,127 @@
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { AxiosError, type InternalAxiosRequestConfig } from 'axios'
+import { MemoryRouter } from 'react-router-dom'
+import { SWRConfig } from 'swr'
+import { Toaster, toast } from 'sonner'
+import { LanguageProvider } from '../contexts/LanguageContext'
+import { AITradersPage } from './AITradersPage'
+
+const { adapter } = vi.hoisted(() => ({ adapter: vi.fn() }))
+const startupMessage =
+  "OKX could not identify this API key (50119). Check the key's account and region. US and EEA accounts require the matching regional API endpoint."
+
+// Keep the real API client and interceptors; all HTTP transport is offline.
+vi.mock('axios', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('axios')>()
+  return {
+    ...actual,
+    default: {
+      ...actual.default,
+      create: (config: object) => actual.default.create({ ...config, adapter }),
+    },
+  }
+})
+
+vi.mock('../contexts/AuthContext', () => {
+  const auth = { user: { id: 'test-user' }, token: 'test-session' }
+  return { useAuth: () => auth }
+})
+
+beforeEach(() => {
+  adapter.mockReset()
+  vi.stubGlobal('matchMedia', () => ({
+    matches: false,
+    addEventListener: vi.fn(),
+    removeEventListener: vi.fn(),
+  }))
+})
+
+afterEach(() => {
+  cleanup()
+  for (const item of toast.getToasts()) toast.dismiss(item.id)
+  vi.unstubAllGlobals()
+})
+
+it.each([
+  {
+    status: 400,
+    running: false,
+    response: startupMessage,
+    visible: startupMessage,
+  },
+  {
+    status: 500,
+    running: false,
+    response: 'private upstream diagnostic must not be displayed',
+    visible: 'Please try again later or contact support',
+  },
+  {
+    status: 400,
+    running: true,
+    response: 'stop behavior remains unchanged',
+    visible: '停止失败',
+  },
+])(
+  'shows the expected failure for HTTP $status with running=$running',
+  async ({ status, running, response, visible }) => {
+    adapter.mockImplementation(async (config: InternalAxiosRequestConfig) => {
+      const result = {
+        config,
+        headers: {},
+        status: 200,
+        statusText: 'OK',
+        data: [] as unknown,
+      }
+      if (config.url === '/api/my-traders') {
+        result.data = [
+          {
+            trader_id: 'test-trader',
+            trader_name: 'Test Trader',
+            ai_model: 'openrouter',
+            is_running: running,
+          },
+        ]
+      } else if (config.method === 'post') {
+        result.status = status
+        result.data = { error: response }
+        throw new AxiosError(
+          'Request failed',
+          'ERR_BAD_RESPONSE',
+          config,
+          undefined,
+          result
+        )
+      }
+      return result
+    })
+
+    render(
+      <MemoryRouter>
+        <SWRConfig value={{ provider: () => new Map() }}>
+          <LanguageProvider>
+            <AITradersPage />
+            <Toaster />
+          </LanguageProvider>
+        </SWRConfig>
+      </MemoryRouter>
+    )
+    fireEvent.click(
+      await screen.findByRole('button', { name: running ? 'Stop' : 'Start' })
+    )
+    expect(await screen.findByText(visible)).toBeVisible()
+    expect(screen.getAllByText(visible)).toHaveLength(1)
+    expect(screen.queryByText('Operation failed')).not.toBeInTheDocument()
+    expect(
+      adapter.mock.calls
+        .filter(([config]) => config.method === 'post')
+        .map(([config]) => config.url)
+    ).toEqual([`/api/traders/test-trader/${running ? 'stop' : 'start'}`])
+    if (response !== visible)
+      expect(screen.queryByText(response)).not.toBeInTheDocument()
+    if (status === 400)
+      expect(
+        screen.queryByText('Please try again later or contact support')
+      ).not.toBeInTheDocument()
+  }
+)
