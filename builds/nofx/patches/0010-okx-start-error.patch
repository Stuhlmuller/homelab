@@ -0,0 +1,98 @@
+package api
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"nofx/manager"
+	"nofx/store"
+
+	"github.com/gin-gonic/gin"
+)
+
+type startErrorTransport func(*http.Request) (*http.Response, error)
+
+func (transport startErrorTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	return transport(request)
+}
+
+func TestStartTraderOKX50119IsActionable(t *testing.T) {
+	for _, test := range []struct {
+		code       string
+		wantStatus int
+	}{
+		{"50119", http.StatusBadRequest},
+		{"50113", http.StatusInternalServerError},
+	} {
+		t.Run(test.code, func(t *testing.T) {
+			st := configurationTestStore(t)
+			const userID = "safety-test"
+			if err := st.User().Create(&store.User{ID: userID, Email: "fixture@example.invalid", PasswordHash: "fixture"}); err != nil {
+				t.Fatal(err)
+			}
+			if err := st.AIModel().Create(userID, "fixture-model", "fixture", "openai", true, "fixture-model-key", "https://example.invalid/api/v1"); err != nil {
+				t.Fatal(err)
+			}
+			exchangeID, err := st.Exchange().Create(userID, "okx", "fixture", true, "fixture-key", "fixture-secret", "fixture-passphrase", false, "", "", "", "", "", "", "", 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := st.Strategy().Create(&store.Strategy{ID: "fixture-strategy", UserID: userID, Name: "fixture", Config: `{"coin_source":{"source_type":"static","static_coins":["BTCUSDT"]}}`}); err != nil {
+				t.Fatal(err)
+			}
+			if err := st.Trader().Create(&store.Trader{ID: "fixture-trader", UserID: userID, Name: "fixture", AIModelID: "fixture-model", ExchangeID: exchangeID, StrategyID: "fixture-strategy", InitialBalance: 0, IsRunning: false}); err != nil {
+				t.Fatal(err)
+			}
+
+			previous := http.DefaultTransport
+			var requests []string
+			http.DefaultTransport = startErrorTransport(func(request *http.Request) (*http.Response, error) {
+				requests = append(requests, request.Method+" "+request.URL.Host+request.URL.Path)
+				if request.Method != http.MethodGet || (request.URL.Path != "/api/v5/account/config" && request.URL.Path != "/api/v5/account/balance") {
+					t.Fatalf("unexpected request: %s %s", request.Method, request.URL.Path)
+				}
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(fmt.Sprintf(`{"code":%q,"msg":"API key doesn't exist","data":[]}`, test.code))), Request: request}, nil
+			})
+			t.Cleanup(func() { http.DefaultTransport = previous })
+			server := &Server{store: st, traderManager: manager.NewTraderManager()}
+			response := httptest.NewRecorder()
+			ctx, _ := gin.CreateTestContext(response)
+			ctx.Set("user_id", userID)
+			ctx.Params = gin.Params{{Key: "id", Value: "fixture-trader"}}
+			ctx.Request = httptest.NewRequest(http.MethodPost, "/api/traders/fixture-trader/start", nil)
+			server.handleStartTrader(ctx)
+
+			saved, err := st.Trader().GetFullConfig(userID, "fixture-trader")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if saved.Trader.IsRunning {
+				t.Fatal("failed start set is_running=true")
+			}
+			if _, err := server.traderManager.GetTrader("fixture-trader"); err == nil {
+				t.Fatal("failed initialization loaded a runnable trader")
+			}
+			if len(requests) != 2 {
+				t.Fatalf("want config and balance reads only, got %v", requests)
+			}
+			t.Logf("observed status=%d is_running=%v requests=%v body=%s", response.Code, saved.Trader.IsRunning, requests, response.Body.String())
+			if response.Code != test.wantStatus {
+				t.Fatalf("want HTTP %d, got HTTP %d: %s", test.wantStatus, response.Code, response.Body.String())
+			}
+			if test.code == "50119" {
+				if !strings.Contains(response.Body.String(), "matching regional API endpoint") {
+					t.Fatal("response did not explain regional endpoint requirement")
+				}
+				if strings.Contains(response.Body.String(), "API key doesn't exist") || strings.Contains(response.Body.String(), "fixture-key") {
+					t.Fatal("response exposed raw upstream error or credential fixture")
+				}
+			} else if !strings.Contains(response.Body.String(), "code=50113,") {
+				t.Fatal("unrelated load error no longer follows existing server-error path")
+			}
+		})
+	}
+}
