@@ -0,0 +1,149 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"nofx/manager"
+	"nofx/store"
+
+	"github.com/gin-gonic/gin"
+)
+
+func positionsTestServer(t *testing.T, code string, modelEnabled bool) (*Server, *[]string) {
+	t.Helper()
+	st := configurationTestStore(t)
+	for _, err := range []error{
+		st.User().Create(&store.User{ID: "owner", Email: "owner@example.invalid", PasswordHash: "fixture"}),
+		st.AIModel().Create("owner", "model", "fixture", "openai", modelEnabled, "fixture-model-key", "https://example.invalid/api/v1"),
+		st.Strategy().Create(&store.Strategy{ID: "strategy", UserID: "owner", Name: "fixture", Config: `{"coin_source":{"source_type":"static","static_coins":["BTCUSDT"]}}`}),
+	} {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	exchangeID, err := st.Exchange().Create("owner", "okx", "fixture", true, "fixture-key", "fixture-secret", "fixture-passphrase", false, "", "", "", "", "", "", "", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := st.Trader().Create(&store.Trader{ID: "saved-trader", UserID: "owner", Name: "fixture", AIModelID: "model", ExchangeID: exchangeID, StrategyID: "strategy", InitialBalance: 1000, IsRunning: false}); err != nil {
+		t.Fatal(err)
+	}
+	previous := http.DefaultTransport
+	var requests []string
+	http.DefaultTransport = startErrorTransport(func(request *http.Request) (*http.Response, error) {
+		requests = append(requests, request.Method+" "+request.URL.Path)
+		if request.Method != http.MethodGet {
+			t.Fatalf("dashboard attempted mutation: %s", requests)
+		}
+		body := fmt.Sprintf(`{"code":%q,"msg":"private upstream detail fixture-secret","data":[]}`, code)
+		if code == "0" {
+			switch request.URL.Path {
+			case "/api/v5/account/config":
+				body = `{"code":"0","data":[{"posMode":"net_mode"}]}`
+			case "/api/v5/account/positions":
+				body = `{"code":"0","data":[]}`
+			default:
+				t.Fatalf("unexpected read: %s", requests)
+			}
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: request}, nil
+	})
+	t.Cleanup(func() { http.DefaultTransport = previous })
+	return &Server{store: st, traderManager: manager.NewTraderManager()}, &requests
+}
+
+func positionsTestRequest(handler gin.HandlerFunc, user, query string) *httptest.ResponseRecorder {
+	response := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(response)
+	ctx.Set("user_id", user)
+	ctx.Params = gin.Params{{Key: "id", Value: "1"}}
+	ctx.Request = httptest.NewRequest(http.MethodGet, "/api/positions"+query, nil)
+	handler(ctx)
+	return response
+}
+
+func TestDashboardTraderLoadFailure(t *testing.T) {
+	for _, test := range []struct {
+		code    string
+		enabled bool
+	}{{"50119", true}, {"50113", true}, {"0", false}} {
+		t.Run(fmt.Sprintf("%s/enabled-%v", test.code, test.enabled), func(t *testing.T) {
+			server, _ := positionsTestServer(t, test.code, test.enabled)
+			handlers := map[string]gin.HandlerFunc{
+				"positions": server.handlePositions, "status": server.handleStatus,
+				"account": server.handleAccount, "position-history": server.handlePositionHistory,
+				"trades": server.handleTrades, "orders": server.handleOrders,
+				"order-fills": server.handleOrderFills, "decisions": server.handleDecisions,
+				"latest-decisions": server.handleLatestDecisions, "statistics": server.handleStatistics,
+			}
+			for name, handler := range handlers {
+				t.Run(name, func(t *testing.T) {
+					response := positionsTestRequest(handler, "owner", "?trader_id=saved-trader")
+					var body struct{ Code, Error string }
+					if err := json.Unmarshal(response.Body.Bytes(), &body); err != nil {
+						t.Fatal(err)
+					}
+					if response.Code != http.StatusServiceUnavailable || body.Code != "TRADER_UNAVAILABLE" {
+						t.Fatalf("want trader unavailable (503), got %d %s", response.Code, response.Body.String())
+					}
+					if test.code == "50119" && !strings.Contains(body.Error, "50119") {
+						t.Fatal("missing actionable OKX guidance")
+					}
+					if strings.Contains(body.Error, "private upstream") || strings.Contains(body.Error, "fixture-") {
+						t.Fatal("raw load error leaked")
+					}
+				})
+			}
+			saved, err := server.store.Trader().GetByID("saved-trader")
+			if err != nil || saved.IsRunning {
+				t.Fatalf("dashboard started trader: %v", err)
+			}
+		})
+	}
+}
+
+func TestDashboardTraderOwnershipAndRecovery(t *testing.T) {
+	server, requests := positionsTestServer(t, "0", true)
+	// A valid stopped trader can load and return a real empty positions result.
+	response := positionsTestRequest(server.handlePositions, "owner", "?trader_id=saved-trader")
+	var positions []any
+	if err := json.Unmarshal(response.Body.Bytes(), &positions); err != nil {
+		t.Fatal(err)
+	}
+	if response.Code != 200 || len(positions) != 0 {
+		t.Fatalf("positions: %d %s", response.Code, response.Body.String())
+	}
+	for _, test := range []struct{ user, query string }{
+		{"owner", "?trader_id=missing"}, {"other", "?trader_id=saved-trader"}, {"other", ""},
+	} {
+		*requests = nil
+		response = positionsTestRequest(server.handlePositions, test.user, test.query)
+		if response.Code != 404 || len(*requests) != 0 {
+			t.Fatalf("invalid or foreign trader: %d, requests=%v", response.Code, *requests)
+		}
+	}
+	response = positionsTestRequest(server.handlePositions, "owner", "")
+	if response.Code != 200 {
+		t.Fatalf("own default trader: %d", response.Code)
+	}
+	saved, err := server.store.Trader().GetByID("saved-trader")
+	if err != nil || saved.IsRunning {
+		t.Fatalf("dashboard started trader: %v", err)
+	}
+}
+
+func TestEquityHistoryDoesNotNeedLoadedTrader(t *testing.T) {
+	server, requests := positionsTestServer(t, "50119", true)
+	server = NewServer(server.traderManager, server.store, nil, nil, 0)
+	response := httptest.NewRecorder()
+	server.router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/api/equity-history?trader_id=saved-trader", nil))
+	if response.Code != 200 || len(*requests) != 0 {
+		t.Fatalf("public history required authentication or exchange access: %d, requests=%v", response.Code, *requests)
+	}
+}
