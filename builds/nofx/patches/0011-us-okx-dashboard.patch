+  const actual = await importOriginal<typeof import('axios')>()
+  return {
+    ...actual,
+    default: {
+      ...actual.default,
+      create: (config: object) => actual.default.create({ ...config, adapter }),
+    },
+  }
+})
+
+beforeEach(() => {
+  adapter.mockReset()
+  vi.spyOn(toast, 'error').mockReturnValue('test-toast')
+})
+
