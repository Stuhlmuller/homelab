@@ -0,0 +1,40 @@
+package trader
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestOKXRequestsUseUSRegion(t *testing.T) {
+	for _, test := range []struct {
+		method, path string
+		body         interface{}
+	}{
+		{http.MethodGet, okxAccountConfigPath, nil},
+		{http.MethodGet, okxPositionPath + "?instType=SWAP", nil},
+		{http.MethodPost, okxLeveragePath, map[string]string{"instId": "BTC-USDT-SWAP", "lever": "1", "mgnMode": "cross"}},
+	} {
+		t.Run(test.method+test.path, func(t *testing.T) {
+			requests := 0
+			transport := okxInitializationTransport(func(request *http.Request) (*http.Response, error) {
+				requests++
+				if request.URL.Scheme != "https" || request.URL.Host != "us.okx.com" || request.Method != test.method || request.URL.RequestURI() != test.path {
+					t.Fatalf("unexpected regional request: %s %s", request.Method, request.URL)
+				}
+				if request.Header.Get("OK-ACCESS-KEY") != "fixture-key" || request.Header.Get("OK-ACCESS-PASSPHRASE") != "fixture-passphrase" || request.Header.Get("OK-ACCESS-SIGN") == "" || request.Header.Get("OK-ACCESS-TIMESTAMP") == "" {
+					t.Fatal("regional request lost authentication")
+				}
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"code":"0","data":[]}`)), Request: request}, nil
+			})
+			trader := &OKXTrader{apiKey: "fixture-key", secretKey: "fixture-secret", passphrase: "fixture-passphrase", httpClient: &http.Client{Transport: transport}}
+			if _, err := trader.doRequest(test.method, test.path, test.body); err != nil {
+				t.Fatal(err)
+			}
+			if requests != 1 {
+				t.Fatalf("expected one regional request, got %d", requests)
+			}
+		})
+	}
+}
