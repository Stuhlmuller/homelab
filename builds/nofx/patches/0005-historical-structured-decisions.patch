@@ -0,0 +1,109 @@
+package mcp
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type structuredFixtureTransport func(*http.Request) (*http.Response, error)
+
+func (f structuredFixtureTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestHistoricalStructuredRequestWire(t *testing.T) {
+	for _, structured := range []bool{false, true} {
+		t.Run(map[bool]string{false: "legacy", true: "structured"}[structured], func(t *testing.T) {
+			calls := 0
+			transport := structuredFixtureTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.URL.String() != "https://openrouter.ai/api/v1/chat/completions" {
+					t.Fatal("wrong request endpoint")
+				}
+				var body map[string]any
+				if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+					t.Fatal(err)
+				}
+				if body["model"] != "openrouter/free" {
+					t.Fatal("wrong model")
+				}
+				if structured {
+					format, ok := body["response_format"].(map[string]any)
+					if !ok || format["type"] != "json_schema" {
+						t.Fatal("missing schema format")
+					}
+					schema := format["json_schema"].(map[string]any)
+					if schema["strict"] != true || schema["name"] != "fixture" || schema["schema"].(map[string]any)["type"] != "object" {
+						t.Fatal("schema altered")
+					}
+					if body["provider"].(map[string]any)["require_parameters"] != true {
+						t.Fatal("provider capability not required")
+					}
+				} else if body["response_format"] != nil || body["provider"] != nil {
+					t.Fatal("legacy request changed")
+				}
+				return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{"choices":[{"finish_reason":"stop","message":{"content":"fixture"}}]}`)), Header: make(http.Header)}, nil
+			})
+			client := NewClient(WithProvider(ProviderCustom), WithAPIKey("fixture"), WithBaseURL("https://openrouter.ai/api/v1"), WithModel("openrouter/free"), WithMaxRetries(1), WithHTTPClient(&http.Client{Transport: transport}))
+			req := &Request{Messages: []Message{NewUserMessage("fixture")}}
+			if structured {
+				req.ResponseFormat = &ResponseFormat{Type: "json_schema", JSONSchema: JSONSchema{Name: "fixture", Strict: true, Schema: map[string]any{"type": "object"}}}
+				req.Provider = &ProviderPreferences{RequireParameters: true}
+			}
+			if _, err := client.CallWithRequest(req); err != nil {
+				t.Fatal(err)
+			}
+			if calls != 1 {
+				t.Fatalf("request count=%d", calls)
+			}
+		})
+	}
+}
+
+func TestHistoricalStructuredResponseFailures(t *testing.T) {
+	cases := map[string]string{
+		"refused":   `{"choices":[{"finish_reason":"stop","message":{"content":"{}","refusal":"fixture refusal"}}]}`,
+		"truncated": `{"choices":[{"finish_reason":"length","message":{"content":"{}"}}]}`,
+		"filtered":  `{"choices":[{"finish_reason":"content_filter","message":{"content":"{}"}}]}`,
+		"empty":     `{"choices":[{"finish_reason":"stop","message":{"content":""}}]}`,
+		"null":      `{"choices":[{"finish_reason":"stop","message":{"content":null}}]}`,
+		"missing":   `{"choices":[]}`,
+		"malformed": `not json`,
+	}
+	for name, body := range cases {
+		t.Run(name, func(t *testing.T) {
+			if err := validateStructuredCompletion([]byte(body)); err == nil {
+				t.Fatal("bad completion accepted")
+			}
+		})
+	}
+	if err := validateStructuredCompletion([]byte(`{"choices":[{"finish_reason":"stop","message":{"content":"{}","refusal":null}}]}`)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestHistoricalStructuredProviderErrorDoesNotEchoBody(t *testing.T) {
+	calls := 0
+	client := NewClient(WithAPIKey("fixture"), WithMaxRetries(1), WithHTTPClient(&http.Client{Transport: structuredFixtureTransport(func(*http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 429, Body: io.NopCloser(strings.NewReader("private-request-fixture")), Header: make(http.Header)}, nil
+	})}))
+	_, err := client.CallWithRequest(&Request{ResponseFormat: &ResponseFormat{Type: "json_schema"}})
+	if err == nil || !strings.Contains(err.Error(), "429") || strings.Contains(err.Error(), "private-request-fixture") || calls != 1 {
+		t.Fatalf("error/count mismatch: %v, %d", err, calls)
+	}
+}
+
+func TestHistoricalStructuredTransientErrorIsOneAttempt(t *testing.T) {
+	calls := 0
+	client := NewClient(WithAPIKey("fixture"), WithMaxRetries(1), WithHTTPClient(&http.Client{Transport: structuredFixtureTransport(func(*http.Request) (*http.Response, error) {
+		calls++
+		return nil, errors.New("temporary failure")
+	})}))
+	_, err := client.CallWithRequest(&Request{ResponseFormat: &ResponseFormat{Type: "json_schema"}})
+	if err == nil || calls != 1 {
+		t.Fatalf("transient error silently retried: err=%v calls=%d", err, calls)
+	}
+}
