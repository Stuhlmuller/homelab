+func TestHistoricalFreeRouterSelection(t *testing.T) {
+	cases := []struct {
+		model, url string
+		want       bool
+	}{
+		{"openrouter/free", "https://openrouter.ai/api/v1", true},
+		{"openrouter/free", "https://openrouter.ai/api/v1/", true},
+		{"other/free", "https://openrouter.ai/api/v1", false},
+		{"openrouter/free", "http://openrouter.ai/api/v1", false},
+		{"openrouter/free", "https://openrouter.ai.evil.example/api/v1", false},
+		{"openrouter/free", "https://evil.example/api/v1", false},
+		{"openrouter/free", "https://user@openrouter.ai/api/v1", false},
+		{"openrouter/free", "https://openrouter.ai:444/api/v1", false},
+		{"openrouter/free", "https://openrouter.ai/api/v1?x=1", false},
+		{"openrouter/free", "https://openrouter.ai/api/v1?", false},
+		{"openrouter/free", "https://openrouter.ai/api/v1#other", false},
+		{"openrouter/free", "https://openrouter.ai/api/v1/responses", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.url+tc.model, func(t *testing.T) {
+			cfg := BacktestConfig{AICfg: AIConfig{Provider: "openai", APIKey: "fixture", Model: tc.model, BaseURL: tc.url}}
+			client, err := configureMCPClient(cfg, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, got := client.(mcp.StructuredOutputClient)
+			if got != tc.want {
+				t.Fatalf("structured=%v want=%v", got, tc.want)
+			}
+		})
+	}
+}
+
+type historicalRequestCapture struct {
+	mcp.AIClient
+	request *mcp.Request
+}
+
+func (c *historicalRequestCapture) CallWithRequest(req *mcp.Request) (string, error) {
+	c.request = req
+	return "fixture", nil
+}
+func TestHistoricalFreeRouterRequest(t *testing.T) {
+	capture := &historicalRequestCapture{}
+	client := &historicalFreeRouterClient{AIClient: capture}
+	_, err := client.CallWithStructuredOutput("system", "user", map[string]any{"type": "object"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	req := capture.request
+	if req.Model != "openrouter/free" || req.ResponseFormat.Type != "json_schema" || !req.ResponseFormat.JSONSchema.Strict || !req.Provider.RequireParameters || len(req.Messages) != 2 {
+		t.Fatal("incomplete structured request")
+	}
+}
+
+type failingHistoricalModel struct {
+	mcp.AIClient
+	calls int
+	err   error
+}
+
+func (m *failingHistoricalModel) CallWithStructuredOutput(system, user string, schema map[string]any) (string, error) {
+	m.calls++
+	return "User Safety: safe", m.err
+}
+func TestHistoricalStructuredFailureIsOneAttempt(t *testing.T) {
+	for _, failure := range []error{nil, errors.New("provider unavailable")} {
+		cfg := store.GetDefaultStrategyConfig("en")
+		model := &failingHistoricalModel{err: failure}
+		r := &Runner{mcpClient: model, strategyEngine: kernel.NewStrategyEngine(&cfg)}
+		ctx := &kernel.Context{SimulationTimeMS: 1577847600000, Account: kernel.AccountInfo{TotalEquity: 1000}, MarketDataMap: map[string]*market.Data{"BTCUSDT": {Symbol: "BTCUSDT", CurrentPrice: 100}}}
+		if fd, err := r.invokeAIWithRetry(ctx); err == nil || fd != nil || model.calls != 1 {
+			t.Fatalf("failure retried/accepted: %v, calls=%d", err, model.calls)
+		}
+	}
+}
+
+func TestHistoricalLeverageCapAtExecution(t *testing.T) {
+	for _, symbol := range []string{"BTCUSDT", "ETHUSDT", "SOLUSDT"} {
+		for _, action := range []string{"open_long", "open_short"} {
+			t.Run(symbol+action, func(t *testing.T) {
+				r := &Runner{cfg: BacktestConfig{Leverage: LeverageConfig{BTCETHLeverage: 1, AltcoinLeverage: 1}}, feed: &DataFeed{}, account: NewBacktestAccount(1000, 5, 2), state: &BacktestState{Equity: 1000}}
+				record, trades, _, err := r.executeDecision(kernel.Decision{Symbol: symbol, Action: action, Leverage: 20, PositionSizeUSD: 100}, map[string]float64{symbol: 100}, 1577847600000, 1)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if record.Leverage != 1 || len(trades) != 1 || trades[0].Leverage != 1 || len(r.account.Positions()) != 1 || r.account.Positions()[0].Leverage != 1 {
+					t.Fatal("configured cap bypassed by model leverage")
+				}
+			})
+		}
+	}
+	r := &Runner{cfg: BacktestConfig{Leverage: LeverageConfig{BTCETHLeverage: 3, AltcoinLeverage: 2}}}
+	for _, tc := range []struct {
+		requested int
+		symbol    string
+		want      int
+	}{{0, "BTCUSDT", 3}, {1, "BTCUSDT", 1}, {20, "BTCUSDT", 3}, {20, "SOLUSDT", 2}, {1, "SOLUSDT", 1}} {
+		if got := r.resolveLeverage(tc.requested, tc.symbol); got != tc.want {
+			t.Fatalf("leverage=%d want=%d", got, tc.want)
+		}
+	}
+}
