+		"bad_confidence": strings.ReplaceAll(structuredWaitFixture, `"confidence":50`, `"confidence":101`),
+		"negative":       strings.ReplaceAll(structuredWaitFixture, `"risk_usd":0`, `"risk_usd":-1`),
+		"empty_reason":   strings.ReplaceAll(structuredWaitFixture, "No signal.", " "),
+		"trailing":       structuredWaitFixture + ` {}`,
+		"bare_array":     `[{"symbol":"BTCUSDT","action":"wait","reasoning":"fixture"}]`,
+	}
+	for name, response := range cases {
+		t.Run(name, func(t *testing.T) {
+			if fd, err := parseHistoricalStructuredDecision(response, ctx); err == nil || fd != nil {
+				t.Fatal("malformed decision became success")
+			}
+		})
+	}
+}
+
+type structuredDecisionFixtureClient struct {
+	mcp.AIClient
+	structuredCalls, legacyCalls int
+	response, system             string
+	schema                       map[string]any
+}
+
+func (c *structuredDecisionFixtureClient) CallWithStructuredOutput(system, user string, schema map[string]any) (string, error) {
+	c.structuredCalls++
+	c.system = system
+	c.schema = schema
+	return c.response, nil
+}
+func (c *structuredDecisionFixtureClient) CallWithMessages(system, user string) (string, error) {
+	c.legacyCalls++
+	return `<decision>[{"symbol":"BTCUSDT","action":"wait","reasoning":"fixture"}]</decision>`, nil
+}
+
+func TestHistoricalStructuredDecisionPath(t *testing.T) {
+	for _, historical := range []bool{false, true} {
+		t.Run(map[bool]string{false: "live_unchanged", true: "historical"}[historical], func(t *testing.T) {
+			cfg := store.GetDefaultStrategyConfig("en")
+			engine := NewStrategyEngine(&cfg)
+			engine.nofxosClient = nil
+			ctx := structuredContextFixture()
+			if !historical {
+				ctx.SimulationTimeMS = 0
+			}
+			client := &structuredDecisionFixtureClient{response: structuredWaitFixture}
+			fd, err := GetFullDecisionWithStrategy(ctx, client, engine, "baseline")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if historical {
+				if client.structuredCalls != 1 || client.legacyCalls != 0 || fd.RawResponse != structuredWaitFixture || !strings.Contains(client.system, "replaces earlier XML") {
+					t.Fatal("historical path/response mismatch")
+				}
+				encoded, _ := json.Marshal(client.schema)
+				if !strings.Contains(string(encoded), `"enum":["BTCUSDT"]`) || strings.Contains(string(encoded), "ALL") {
+					t.Fatal("incorrect symbol enum")
+				}
+			} else if client.structuredCalls != 0 || client.legacyCalls != 1 {
+				t.Fatal("live path changed")
+			}
+		})
+	}
+	cfg := store.GetDefaultStrategyConfig("en")
+	engine := NewStrategyEngine(&cfg)
+	engine.nofxosClient = nil
+	client := &structuredDecisionFixtureClient{response: "User Safety: safe"}
+	if fd, err := GetFullDecisionWithStrategy(structuredContextFixture(), client, engine, "baseline"); err == nil || fd != nil || client.structuredCalls != 1 {
+		t.Fatal("prose became ALL wait success")
+	}
+}
