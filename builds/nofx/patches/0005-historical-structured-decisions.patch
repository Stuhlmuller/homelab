diff --git a/kernel/historical_structured.go b/kernel/historical_structured.go
new file mode 100644
index 0000000..22bd4ea
--- /dev/null
+++ b/kernel/historical_structured.go
@@ -0,0 +1,149 @@
+package kernel
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+)
+
+const historicalStructuredOutputInstruction = `
+
+Historical simulation output contract: return ONLY the JSON object defined by the supplied schema, containing a non-empty decisions array. This replaces earlier XML, markdown, or free-text output formatting instructions. Use zero for numeric fields irrelevant to an action. Each reasoning field must contain one brief explanation; do not include a reasoning trace. Use an explicit wait decision for a configured symbol when taking no action.`
+
+var historicalDecisionActions = []string{"open_long", "open_short", "close_long", "close_short", "hold", "wait"}
+var historicalDecisionFields = []string{"symbol", "action", "leverage", "position_size_usd", "stop_loss", "take_profit", "confidence", "risk_usd", "reasoning"}
+
+func historicalDecisionSchema(ctx *Context) map[string]any {
+	symbols := make([]string, 0, len(ctx.MarketDataMap))
+	for symbol := range ctx.MarketDataMap {
+		symbols = append(symbols, symbol)
+	}
+	sort.Strings(symbols)
+	properties := map[string]any{
+		"symbol":            map[string]any{"type": "string", "enum": symbols},
+		"action":            map[string]any{"type": "string", "enum": historicalDecisionActions},
+		"leverage":          map[string]any{"type": "integer", "minimum": 0},
+		"position_size_usd": map[string]any{"type": "number", "minimum": 0},
+		"stop_loss":         map[string]any{"type": "number", "minimum": 0},
+		"take_profit":       map[string]any{"type": "number", "minimum": 0},
+		"confidence":        map[string]any{"type": "integer", "minimum": 0, "maximum": 100},
+		"risk_usd":          map[string]any{"type": "number", "minimum": 0},
+		"reasoning":         map[string]any{"type": "string", "minLength": 1, "description": "One brief explanation of the simulation action."},
+	}
+	return map[string]any{
+		"type": "object", "additionalProperties": false, "required": []string{"decisions"},
+		"properties": map[string]any{"decisions": map[string]any{
+			"type": "array", "minItems": 1,
+			"items": map[string]any{"type": "object", "additionalProperties": false, "required": historicalDecisionFields, "properties": properties},
+		}},
+	}
+}
+
+// Pointers distinguish omitted/null fields from valid zero values. The strict
+// local decoder is required even when a provider advertises JSON-schema support.
+type historicalWireDecision struct {
+	Symbol          *string  `json:"symbol"`
+	Action          *string  `json:"action"`
+	Leverage        *int     `json:"leverage"`
+	PositionSizeUSD *float64 `json:"position_size_usd"`
+	StopLoss        *float64 `json:"stop_loss"`
+	TakeProfit      *float64 `json:"take_profit"`
+	Confidence      *int     `json:"confidence"`
+	RiskUSD         *float64 `json:"risk_usd"`
+	Reasoning       *string  `json:"reasoning"`
+}
+
+func parseHistoricalStructuredDecision(response string, ctx *Context) (*FullDecision, error) {
+	// encoding/json accepts case-insensitive struct fields and last-wins duplicates.
+	// Check exact, unique object keys first so those extensions cannot bypass schema.
+	envelopeFields, err := historicalUniqueObject([]byte(response), []string{"decisions"})
+	if err != nil {
+		return nil, err
+	}
+	var rawDecisions []json.RawMessage
+	if json.Unmarshal(envelopeFields["decisions"], &rawDecisions) != nil {
+		return nil, fmt.Errorf("historical decision response requires a decisions array")
+	}
+	for _, raw := range rawDecisions {
+		if _, err := historicalUniqueObject(raw, historicalDecisionFields); err != nil {
+			return nil, err
+		}
+	}
+	var envelope struct {
+		Decisions []historicalWireDecision `json:"decisions"`
+	}
+	decoder := json.NewDecoder(strings.NewReader(response))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&envelope); err != nil {
+		return nil, fmt.Errorf("historical decision response does not match JSON schema")
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return nil, fmt.Errorf("historical decision response contains trailing content")
+	}
+	if len(envelope.Decisions) == 0 {
+		return nil, fmt.Errorf("historical decision response requires a non-empty decisions array")
+	}
+	result := &FullDecision{Decisions: make([]Decision, 0, len(envelope.Decisions))}
+	for i, wire := range envelope.Decisions {
+		if wire.Symbol == nil || wire.Action == nil || wire.Leverage == nil || wire.PositionSizeUSD == nil || wire.StopLoss == nil || wire.TakeProfit == nil || wire.Confidence == nil || wire.RiskUSD == nil || wire.Reasoning == nil {
+			return nil, fmt.Errorf("historical decision #%d has missing or null fields", i+1)
+		}
+		if _, allowed := ctx.MarketDataMap[*wire.Symbol]; !allowed {
+			return nil, fmt.Errorf("historical decision #%d uses an unconfigured symbol", i+1)
+		}
+		allowedAction := false
+		for _, action := range historicalDecisionActions {
+			if *wire.Action == action {
+				allowedAction = true
+				break
+			}
+		}
+		if !allowedAction {
+			return nil, fmt.Errorf("historical decision #%d has an invalid action", i+1)
+		}
+		if *wire.Leverage < 0 || *wire.PositionSizeUSD < 0 || *wire.StopLoss < 0 || *wire.TakeProfit < 0 || *wire.RiskUSD < 0 || *wire.Confidence < 0 || *wire.Confidence > 100 || strings.TrimSpace(*wire.Reasoning) == "" {
+			return nil, fmt.Errorf("historical decision #%d has invalid schema values", i+1)
+		}
+		result.Decisions = append(result.Decisions, Decision{Symbol: *wire.Symbol, Action: *wire.Action, Leverage: *wire.Leverage, PositionSizeUSD: *wire.PositionSizeUSD, StopLoss: *wire.StopLoss, TakeProfit: *wire.TakeProfit, Confidence: *wire.Confidence, RiskUSD: *wire.RiskUSD, Reasoning: *wire.Reasoning})
+	}
+	return result, nil
+}
+
+// historicalUniqueObject validates field names without relying on Go's lenient
+// struct matching. JSON escape sequences resolve before uniqueness is checked.
+func historicalUniqueObject(data []byte, allowedFields []string) (map[string]json.RawMessage, error) {
+	decoder := json.NewDecoder(strings.NewReader(string(data)))
+	token, err := decoder.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, fmt.Errorf("historical decision response requires JSON objects")
+	}
+	allowed := make(map[string]bool, len(allowedFields))
+	for _, field := range allowedFields {
+		allowed[field] = true
+	}
+	fields := make(map[string]json.RawMessage, len(allowedFields))
+	for decoder.More() {
+		token, err := decoder.Token()
+		field, ok := token.(string)
+		if err != nil || !ok || !allowed[field] {
+			return nil, fmt.Errorf("historical decision response has a non-schema field name")
+		}
+		if _, duplicate := fields[field]; duplicate {
+			return nil, fmt.Errorf("historical decision response has a duplicate field")
+		}
+		var value json.RawMessage
+		if decoder.Decode(&value) != nil {
+			return nil, fmt.Errorf("historical decision response contains invalid JSON")
+		}
+		fields[field] = value
+	}
+	if token, err := decoder.Token(); err != nil || token != json.Delim('}') {
+		return nil, fmt.Errorf("historical decision response contains invalid JSON")
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return nil, fmt.Errorf("historical decision response contains trailing content")
+	}
+	return fields, nil
+}
