new file mode 100644
index 0000000..b65950e
--- /dev/null
+++ b/mcp/structured_response.go
@@ -0,0 +1,36 @@
+package mcp
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+// Only requests explicitly opting into JSON schema use these checks. A refusal,
+// incomplete generation, or error response must not become a simulated wait.
+func validateStructuredCompletion(body []byte) error {
+	var response struct {
+		Choices []struct {
+			FinishReason string `json:"finish_reason"`
+			Message      struct {
+				Content *string         `json:"content"`
+				Refusal json.RawMessage `json:"refusal"`
+			} `json:"message"`
+		} `json:"choices"`
+	}
+	if json.Unmarshal(body, &response) != nil || len(response.Choices) != 1 {
+		return fmt.Errorf("structured AI response requires one completion")
+	}
+	choice := response.Choices[0]
+	refusal := strings.TrimSpace(string(choice.Message.Refusal))
+	if refusal != "" && refusal != "null" && refusal != `""` {
+		return fmt.Errorf("structured AI response was refused")
+	}
+	if choice.FinishReason != "stop" {
+		return fmt.Errorf("structured AI response did not finish normally")
+	}
+	if choice.Message.Content == nil || strings.TrimSpace(*choice.Message.Content) == "" {
+		return fmt.Errorf("structured AI response has no content")
+	}
+	return nil
+}
