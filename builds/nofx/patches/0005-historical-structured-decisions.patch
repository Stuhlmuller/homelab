+package backtest
+
+import (
+	"net/url"
+	"strings"
+
+	"nofx/mcp"
+)
+
+// The exact free router at its official origin is opt-in only for historical runs.
+// Do not infer support from a model name alone or alter clients used by live traders.
+func isHistoricalFreeRouter(cfg AIConfig) bool {
+	if cfg.Model != "openrouter/free" {
+		return false
+	}
+	u, err := url.Parse(cfg.BaseURL)
+	return err == nil && u.Scheme == "https" && u.Host == "openrouter.ai" &&
+		u.User == nil && u.RawQuery == "" && !u.ForceQuery && u.Fragment == "" &&
+		u.RawPath == "" && strings.TrimRight(u.Path, "/") == "/api/v1"
+}
+
+type historicalFreeRouterClient struct{ mcp.AIClient }
+
+func newHistoricalFreeRouterClient(cfg AIConfig) mcp.AIClient {
+	return &historicalFreeRouterClient{AIClient: mcp.NewClient(
+		mcp.WithProvider(mcp.ProviderCustom), mcp.WithAPIKey(cfg.APIKey),
+		mcp.WithBaseURL("https://openrouter.ai/api/v1"), mcp.WithModel("openrouter/free"),
+		mcp.WithTemperature(cfg.Temperature), mcp.WithMaxRetries(1),
+	)}
+}
+
+func (c *historicalFreeRouterClient) CallWithStructuredOutput(systemPrompt, userPrompt string, schema map[string]any) (string, error) {
+	return c.AIClient.CallWithRequest(&mcp.Request{
+		Model:    "openrouter/free",
+		Messages: []mcp.Message{mcp.NewSystemMessage(systemPrompt), mcp.NewUserMessage(userPrompt)},
+		ResponseFormat: &mcp.ResponseFormat{Type: "json_schema", JSONSchema: mcp.JSONSchema{
+			Name: "historical_decisions", Strict: true, Schema: schema,
+		}},
+		Provider: &mcp.ProviderPreferences{RequireParameters: true},
+	})
+}
