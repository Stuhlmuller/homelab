+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { httpClient } from '../lib/httpClient'
+import type { AIModel, Exchange, TraderConfigData } from '../types'
+import { TraderConfigModal } from './TraderConfigModal'
+
+vi.mock('../lib/httpClient', () => ({
+  httpClient: { get: vi.fn() },
+}))
+vi.mock('../contexts/LanguageContext', () => ({
+  useLanguage: () => ({ language: 'en' }),
+}))
+vi.mock('sonner', () => ({
+  toast: { promise: (value: Promise<unknown>) => value, success: vi.fn() },
+}))
+
+const models: AIModel[] = [
+  { id: 'model', name: 'OpenRouter', provider: 'openai', enabled: true },
+]
+const exchanges: Exchange[] = [
+  {
+    id: 'old-okx',
+    exchange_type: 'okx',
+    account_name: 'Shared account',
+    name: 'OKX Futures',
+    type: 'cex',
+    enabled: true,
+  },
+  {
+    id: 'other-exchange',
+    exchange_type: 'binance',
+    account_name: 'Separate account',
+    name: 'Binance Futures',
+    type: 'cex',
+    enabled: true,
+  },
+]
+const legacyTrader: TraderConfigData = {
+  trader_id: 'agent',
+  trader_name: 'Trend',
+  ai_model: 'model',
+  exchange_id: 'old-okx',
+  initial_balance: 123,
+  is_cross_margin: true,
+  show_in_competition: false,
+  scan_interval_minutes: 5,
+  is_running: false,
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  vi.mocked(httpClient.get).mockImplementation(async (path) => ({
+    success: true,
+    data:
+      path === '/api/strategies' ? { strategies: [] } : { total_equity: 77 },
+  }))
+})
+afterEach(cleanup)
+
+describe('Trader cash-spot configuration', () => {
+  it.each([true, false])(
+    'uses explicit allocations without legacy capital or margin fields (edit=%s)',
+    async (isEditMode) => {
+      const onSave = vi.fn().mockResolvedValue(undefined)
+      render(
+        <TraderConfigModal
+          isOpen
+          isEditMode={isEditMode}
+          traderData={isEditMode ? legacyTrader : null}
+          availableModels={models}
+          availableExchanges={exchanges}
+          onSave={onSave}
+          onClose={vi.fn()}
+        />
+      )
+      await screen.findByText(/Configure the shared capital cap/)
+      expect(
+        screen.getByRole('option', {
+          name: 'OKX US Cash Spot - Shared account',
+        })
+      ).toBeInTheDocument()
+      expect(screen.queryByText(/OKX FUTURES/i)).not.toBeInTheDocument()
+      expect(screen.queryByText('保证金模式')).not.toBeInTheDocument()
+      expect(screen.queryByText('初始余额 ($)')).not.toBeInTheDocument()
+      expect(
+        screen.queryByRole('button', { name: '获取当前余额' })
+      ).not.toBeInTheDocument()
+      expect(
+        screen.queryByText('系统将自动获取您的账户净值作为初始余额')
+      ).not.toBeInTheDocument()
+      expect(
+        screen.getByText(/Spot allocations on the exchange card/)
+      ).toBeInTheDocument()
+      if (!isEditMode) {
+        fireEvent.change(screen.getByPlaceholderText('请输入交易员名称'), {
+          target: { value: 'New agent' },
+        })
+      }
+      fireEvent.click(
+        screen.getByRole('button', {
+          name: isEditMode ? '保存修改' : '创建交易员',
+        })
+      )
+      await waitFor(() => expect(onSave).toHaveBeenCalledOnce())
+      const [payload] = onSave.mock.calls[0]
+      expect(payload.exchange_id).toBe('old-okx')
+      expect(payload).not.toHaveProperty('initial_balance')
+      expect(payload).not.toHaveProperty('is_cross_margin')
+      expect(httpClient.get).toHaveBeenCalledExactlyOnceWith('/api/strategies')
+    }
+  )
+
+  it('restores non-OKX controls and balance fetch after switching back to the saved exchange', async () => {
+    const onSave = vi.fn().mockResolvedValue(undefined)
+    const savedTrader = { ...legacyTrader, exchange_id: 'other-exchange' }
+    render(
+      <TraderConfigModal
+        isOpen
+        isEditMode
+        traderData={savedTrader}
+        availableModels={models}
+        availableExchanges={exchanges}
+        onSave={onSave}
+        onClose={vi.fn()}
+      />
+    )
+    const option = await screen.findByRole('option', {
+      name: 'OKX US Cash Spot - Shared account',
+    })
+    fireEvent.change(option.closest('select')!, {
+      target: { value: 'old-okx' },
+    })
+    expect(
+      screen.getByText(/Spot allocations on the exchange card/)
+    ).toBeInTheDocument()
+    expect(screen.queryByText('保证金模式')).not.toBeInTheDocument()
+    expect(screen.queryByText('初始余额 ($)')).not.toBeInTheDocument()
+    expect(
+      screen.queryByRole('button', { name: '获取当前余额' })
+    ).not.toBeInTheDocument()
+    expect(httpClient.get).toHaveBeenCalledExactlyOnceWith('/api/strategies')
+    fireEvent.change(option.closest('select')!, {
+      target: { value: 'other-exchange' },
+    })
+    expect(screen.getByText('保证金模式')).toBeInTheDocument()
+    expect(screen.getByText('初始余额 ($)')).toBeInTheDocument()
+    expect(
+      screen.queryByText(/Spot allocations on the exchange card/)
+    ).not.toBeInTheDocument()
+    expect(screen.getByDisplayValue('123')).toBeInTheDocument()
+    fireEvent.click(screen.getByRole('button', { name: '逐仓' }))
+    fireEvent.click(screen.getByRole('button', { name: '获取当前余额' }))
+    await screen.findByDisplayValue('77')
+    expect(httpClient.get).toHaveBeenCalledWith('/api/account?trader_id=agent')
+    fireEvent.click(screen.getByRole('button', { name: '保存修改' }))
+    await waitFor(() => expect(onSave).toHaveBeenCalledOnce())
+    expect(onSave.mock.calls[0][0]).toMatchObject({
+      exchange_id: 'other-exchange',
+      is_cross_margin: false,
+      initial_balance: 77,
+    })
+  })
+})
