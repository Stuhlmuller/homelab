diff --git a/trader/okx_leverage_test.go b/trader/okx_leverage_test.go
new file mode 100644
--- /dev/null
+++ b/trader/okx_leverage_test.go
@@ -0,0 +1,107 @@
+package trader
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestOKXLeverageFailurePreventsOrder(t *testing.T) {
+	const atTarget = `{"code":"0","data":[{"instId":"BTC-USDT-SWAP","mgnMode":"cross","posSide":"net","lever":"1.0"}]}`
+	const different = `{"code":"0","data":[{"instId":"BTC-USDT-SWAP","mgnMode":"cross","posSide":"net","lever":"5"}]}`
+	const hedge = `{"code":"0","data":[{"instId":"BTC-USDT-SWAP","mgnMode":"cross","posSide":"long","lever":"1"},{"instId":"BTC-USDT-SWAP","mgnMode":"cross","posSide":"short","lever":"1"}]}`
+	for _, direction := range []struct {
+		name, side string
+		open       func(*OKXTrader, string, float64, int) (map[string]interface{}, error)
+	}{
+		{"long", "buy", (*OKXTrader).OpenLong},
+		{"short", "sell", (*OKXTrader).OpenShort},
+	} {
+		for _, test := range []struct {
+			name, info, setCode string
+			wantPosts           int
+			wantErr             bool
+		}{
+			{"already-target-net", atTarget, "0", 0, false},
+			{"already-target-hedge", hedge, "0", 0, false},
+			{"change-net", different, "0", 1, false},
+			{"change-hedge", strings.Replace(hedge, `"short","lever":"1"`, `"short","lever":"5"`, 1), "0", 1, false},
+			{"update-rejected", different, "51000", 1, true},
+			{"update-partial", different, "1", 1, true},
+			{"info-rejected", `{"code":"50113","msg":"fixture rejected","data":[]}`, "0", 0, true},
+			{"info-partial", strings.Replace(atTarget, `"code":"0"`, `"code":"1"`, 1), "0", 0, true},
+			{"info-malformed", `{"code":"0","data":{}}`, "0", 0, true},
+			{"info-empty", `{"code":"0","data":[]}`, "0", 0, true},
+			{"info-wrong-instrument", strings.Replace(atTarget, "BTC-USDT-SWAP", "ETH-USDT-SWAP", 1), "0", 0, true},
+			{"info-wrong-margin", strings.Replace(atTarget, "cross", "isolated", 1), "0", 0, true},
+			{"info-incomplete-hedge", strings.Replace(atTarget, "net", "long", 1), "0", 0, true},
+			{"info-invalid-leverage", strings.Replace(atTarget, "1.0", "NaN", 1), "0", 0, true},
+		} {
+			t.Run(direction.name+"/"+test.name, func(t *testing.T) {
+				infoRequests, leverageRequests, otherRequests, orders := 0, 0, 0, 0
+				transport := okxInitializationTransport(func(request *http.Request) (*http.Response, error) {
+					response := `{"code":"0","data":[]}`
+					if request.URL.Path != "/api/v5/account/leverage-info" && request.URL.Path != okxLeveragePath {
+						otherRequests++
+					}
+					switch request.URL.Path {
+					case "/api/v5/account/leverage-info":
+						infoRequests++
+						if request.Method != http.MethodGet || request.URL.Query().Get("instId") != "BTC-USDT-SWAP" || request.URL.Query().Get("mgnMode") != "cross" {
+							t.Fatalf("unexpected leverage lookup: %s %s", request.Method, request.URL)
+						}
+						response = test.info
+					case okxLeveragePath:
+						leverageRequests++
+						var body map[string]string
+						if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
+							t.Fatal(err)
+						}
+						_, hasPosSide := body["posSide"]
+						if request.Method != http.MethodPost || body["instId"] != "BTC-USDT-SWAP" || body["mgnMode"] != "cross" || body["lever"] != "1" || hasPosSide {
+							t.Fatalf("unexpected cross-margin leverage request: %s %v", request.Method, body)
+						}
+						// Arbitrary errors containing "same" must still fail closed.
+						response = fmt.Sprintf(`{"code":%q,"msg":"fixture same-account result","data":[]}`, test.setCode)
+					case okxPendingOrdersPath, okxAlgoPendingPath:
+					case okxOrderPath:
+						orders++
+						var body map[string]string
+						if err := json.NewDecoder(request.Body).Decode(&body); err != nil {
+							t.Fatal(err)
+						}
+						if request.Method != http.MethodPost || body["side"] != direction.side || body["posSide"] != direction.name {
+							t.Fatalf("unexpected order: %s %v", request.Method, body)
+						}
+						response = `{"code":"0","data":[{"ordId":"fixture-order","sCode":"0"}]}`
+					default:
+						t.Fatalf("unexpected request: %s %s", request.Method, request.URL.Path)
+					}
+					return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(response)), Request: request}, nil
+				})
+				trader := &OKXTrader{
+					httpClient: &http.Client{Transport: transport},
+					instrumentsCache: map[string]*OKXInstrument{
+						"BTC-USDT-SWAP": {CtVal: 0.01, LotSz: 1},
+					},
+					instrumentsCacheTime: time.Now(),
+				}
+				order, err := direction.open(trader, "BTCUSDT", 0.01, 1)
+				if infoRequests != 1 || leverageRequests != test.wantPosts {
+					t.Fatalf("got %d lookups and %d updates; want 1 lookup and %d updates", infoRequests, leverageRequests, test.wantPosts)
+				}
+				if test.wantErr {
+					if err == nil || order != nil || orders != 0 || otherRequests != 0 {
+						t.Fatalf("invalid leverage state must stop before canceling or placing orders: err=%v order=%v orders=%d otherRequests=%d", err, order, orders, otherRequests)
+					}
+				} else if err != nil || order["orderId"] != "fixture-order" || orders != 1 {
+					t.Fatalf("confirmed leverage must preserve order placement: err=%v order=%v orders=%d", err, order, orders)
+				}
+			})
+		}
+	}
+}
