--- /dev/null
+++ b/trader/okx_initialization_test.go
@@ -0,0 +1,44 @@
+package trader
+
+import (
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type okxInitializationTransport func(*http.Request) (*http.Response, error)
+
+func (transport okxInitializationTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	return transport(request)
+}
+
+func TestOKXInitializationOnlyReadsAccountConfig(t *testing.T) {
+	for _, test := range []struct {
+		name, response, mode string
+	}{
+		{"net", `{"code":"0","data":[{"posMode":"net_mode"}]}`, "net_mode"},
+		{"hedge", `{"code":"0","data":[{"posMode":"long_short_mode"}]}`, "long_short_mode"},
+		{"empty", `{"code":"0","data":[]}`, ""},
+		{"failed", `{"code":"50113","msg":"fixture rejected","data":[]}`, "long_short_mode"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			// Intercept the public constructor's transport. No request can leave
+			// the process, including a regressed account mutation.
+			previous := http.DefaultTransport
+			var requests []string
+			http.DefaultTransport = okxInitializationTransport(func(request *http.Request) (*http.Response, error) {
+				requests = append(requests, request.Method+" "+request.URL.Path)
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(test.response)), Request: request}, nil
+			})
+			t.Cleanup(func() { http.DefaultTransport = previous })
+			trader := NewOKXTrader("fixture-key", "fixture-secret", "fixture-passphrase")
+			if len(requests) != 1 || requests[0] != "GET /api/v5/account/config" {
+				t.Fatalf("constructor must only read account config, got %v", requests)
+			}
+			if trader.positionMode != test.mode {
+				t.Fatalf("position mode changed: got %q, want %q", trader.positionMode, test.mode)
+			}
+		})
+	}
+}
