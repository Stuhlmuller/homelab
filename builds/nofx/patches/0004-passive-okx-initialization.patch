+package manager
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"nofx/store"
+)
+
+type okxInitializationTransport func(*http.Request) (*http.Response, error)
+
+func (transport okxInitializationTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	return transport(request)
+}
+
+func TestOKXInitializationLoadsStoppedTraderWithoutAccountWrites(t *testing.T) {
+	for _, initialBalance := range []float64{1000, 0} {
+		t.Run(fmt.Sprint(initialBalance), func(t *testing.T) {
+			st, err := store.New(filepath.Join(t.TempDir(), "fixture.db"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() { st.Close() })
+			const userID = "passive-okx-fixture"
+			if err := st.User().Create(&store.User{ID: userID, Email: "fixture@example.invalid", PasswordHash: "fixture"}); err != nil {
+				t.Fatal(err)
+			}
+			if err := st.AIModel().Create(userID, "fixture-model", "fixture", "openai", true, "fixture-model-key", "https://example.invalid/api/v1"); err != nil {
+				t.Fatal(err)
+			}
+			exchangeID, err := st.Exchange().Create(userID, "okx", "fixture", true, "fixture-key", "fixture-secret", "fixture-passphrase", false, "", "", "", "", "", "", "", 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := st.Strategy().Create(&store.Strategy{ID: "fixture-strategy", UserID: userID, Name: "fixture", Config: `{"coin_source":{"source_type":"static","static_coins":["BTCUSDT"]}}`}); err != nil {
+				t.Fatal(err)
+			}
+			if err := st.Trader().Create(&store.Trader{ID: "fixture-trader", UserID: userID, Name: "fixture", AIModelID: "fixture-model", ExchangeID: exchangeID, StrategyID: "fixture-strategy", InitialBalance: initialBalance, IsRunning: false}); err != nil {
+				t.Fatal(err)
+			}
+
+			previous := http.DefaultTransport
+			var requests []string
+			http.DefaultTransport = okxInitializationTransport(func(request *http.Request) (*http.Response, error) {
+				requests = append(requests, request.Method+" "+request.URL.Path)
+				response := `{"code":"0","data":[{"posMode":"net_mode"}]}`
+				if request.URL.Path == "/api/v5/account/balance" {
+					response = `{"code":"0","data":[{"totalEq":"1000","details":[]}]}`
+				}
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(response)), Request: request}, nil
+			})
+			t.Cleanup(func() { http.DefaultTransport = previous })
+			manager := NewTraderManager()
+			// Exercise the same store-loading entry point as main startup.
+			if err := manager.LoadTradersFromStore(st); err != nil {
+				t.Fatal(err)
+			}
+			loaded, err := manager.GetTrader("fixture-trader")
+			if err != nil || loaded == nil {
+				t.Fatalf("stopped trader did not load: %v", err)
+			}
+			if running, _ := loaded.GetStatus()["is_running"].(bool); running {
+				t.Fatal("stored stopped trader started during initialization")
+			}
+			want := []string{"GET /api/v5/account/config"}
+			if initialBalance == 0 {
+				want = append(want, "GET /api/v5/account/balance")
+			}
+			if fmt.Sprint(requests) != fmt.Sprint(want) {
+				t.Fatalf("startup must only read exchange data: got %v, want %v", requests, want)
+			}
+		})
+	}
+}
