index 0000000..98de7d5
--- /dev/null
+++ b/mcp/free_router_deadline_test.go
@@ -0,0 +1,108 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type bodyTimeoutLocalTransport func(*http.Request) (*http.Response, error)
+
+func (f bodyTimeoutLocalTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	return f(r)
+}
+
+func TestSpotFreeRouterDelayedBodyDeadline(t *testing.T) {
+	// Keep the local HTTP regression independent of operator routing files.
+	previous := liteLLMRoutingConfigPath
+	liteLLMRoutingConfigPath = filepath.Join(t.TempDir(), "absent-routing.json")
+	t.Cleanup(func() { liteLLMRoutingConfigPath = previous })
+	if DefaultTimeout != 120*time.Second {
+		t.Fatalf("unrelated client default changed: %v", DefaultTimeout)
+	}
+	defaultClient := NewStructuredFreeRouterClient("synthetic", WithLogger(NewNoopLogger())).(*structuredFreeRouterClient)
+	if got := defaultClient.AIClient.(*Client).httpClient.Timeout; got != 10*time.Minute {
+		t.Fatalf("strict free-model deadline=%v, want 10m", got)
+	}
+
+	const bodyDelay = 500 * time.Millisecond
+	const content = `{"decision":"wait"}`
+	for _, tc := range []struct {
+		name     string
+		deadline time.Duration
+		wantFail bool
+	}{
+		{"short_budget", 200 * time.Millisecond, true},
+		{"longer_budget", 2 * time.Second, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var attempts atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				attempts.Add(1)
+				var request struct {
+					Model          string              `json:"model"`
+					ResponseFormat ResponseFormat      `json:"response_format"`
+					Provider       ProviderPreferences `json:"provider"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+					t.Errorf("synthetic request decode: %v", err)
+				}
+				if request.Model != "openrouter/free" || request.ResponseFormat.Type != "json_schema" ||
+					!request.ResponseFormat.JSONSchema.Strict || !request.Provider.RequireParameters {
+					t.Error("request lost the strict free-model contract")
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(`{"choices":[`))
+				w.(http.Flusher).Flush() // Headers and partial body arrive before the deadline.
+				time.Sleep(bodyDelay)
+				_, _ = fmt.Fprintf(w, `{"finish_reason":"stop","message":{"content":%q}}]}`, content)
+			}))
+			defer server.Close()
+			local, err := url.Parse(server.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			transport := http.DefaultTransport.(*http.Transport).Clone()
+			transport.Proxy = nil
+			defer transport.CloseIdleConnections()
+			client := NewStructuredFreeRouterClient("synthetic", WithLogger(NewNoopLogger()),
+				WithHTTPClient(&http.Client{Transport: bodyTimeoutLocalTransport(func(r *http.Request) (*http.Response, error) {
+					if r.URL.String() != "https://openrouter.ai/api/v1/chat/completions" {
+						return nil, errors.New("unexpected endpoint: external request blocked")
+					}
+					request := r.Clone(r.Context())
+					request.URL.Scheme, request.URL.Host = local.Scheme, local.Host
+					request.Host = local.Host
+					return transport.RoundTrip(request)
+				})}), WithTimeout(tc.deadline))
+			schema := map[string]any{
+				"type": "object", "additionalProperties": false,
+				"required":   []string{"decision"},
+				"properties": map[string]any{"decision": map[string]any{"type": "string", "enum": []string{"wait"}}},
+			}
+			started := time.Now()
+			result, err := client.(StructuredOutputClient).CallWithStructuredOutput("synthetic system", "synthetic user", schema)
+			elapsed := time.Since(started)
+			if tc.wantFail {
+				if err == nil || !errors.Is(err, context.DeadlineExceeded) || !strings.Contains(err.Error(), "failed to read response") || result != "" {
+					t.Fatalf("want body-read deadline failure, got result=%q err=%v", result, err)
+				}
+			} else if err != nil || result != content {
+				t.Fatalf("want complete strict response, got result=%q err=%v", result, err)
+			}
+			if attempts.Load() != 1 {
+				t.Fatalf("HTTP attempts=%d, want exactly one", attempts.Load())
+			}
+			t.Logf("deadline=%v body_delay=%v elapsed=%v attempts=%d error=%v", tc.deadline, bodyDelay, elapsed.Round(time.Millisecond), attempts.Load(), err)
+		})
+	}
+}
