new file mode 100644
index 0000000..4372df7
--- /dev/null
+++ b/trader/live_free_cancellation_test.go
@@ -0,0 +1,78 @@
+package trader
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"nofx/mcp"
+)
+
+type liveDelayedBody struct {
+	ctx     context.Context
+	release <-chan struct{}
+	reading chan<- context.Context
+}
+
+func (b *liveDelayedBody) Read([]byte) (int, error) {
+	b.reading <- b.ctx
+	select {
+	case <-b.ctx.Done():
+		return 0, b.ctx.Err()
+	case <-b.release:
+		return 0, io.EOF
+	}
+}
+func (*liveDelayedBody) Close() error { return nil }
+
+func TestSpotStopCancelsLiveFreeResponse(t *testing.T) {
+	at, spot, _ := spotContextFixture(t, "USD")
+	spot.traderID = "b" // This allocation has no holdings or protection to mutate.
+	at.trader = spot
+	at.config.ScanInterval = time.Hour
+	reading := make(chan context.Context, 2)
+	release := make(chan struct{})
+	var calls atomic.Int32
+	at.mcpClient = mcp.NewStructuredFreeRouterClient("synthetic", mcp.WithHTTPClient(&http.Client{
+		Transport: okxInitializationTransport(func(req *http.Request) (*http.Response, error) {
+			if req.Method != http.MethodPost || req.URL.String() != "https://openrouter.ai/api/v1/chat/completions" {
+				t.Error("unexpected model request")
+			}
+			calls.Add(1)
+			return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header),
+				Body: &liveDelayedBody{req.Context(), release, reading}, Request: req}, nil
+		}),
+	}))
+	t.Cleanup(func() { close(release); at.Stop() })
+	for run := int32(1); run <= 2; run++ {
+		completed, err := at.Start()
+		if err != nil {
+			t.Fatal(err)
+		}
+		var requestContext context.Context
+		select {
+		case requestContext = <-reading:
+		case <-time.After(3 * time.Second):
+			t.Fatal("live cycle never reached response-body read")
+		}
+		if requestContext.Err() != nil {
+			t.Fatal("restart reused canceled request context")
+		}
+		stopped := make(chan struct{})
+		go func() { at.Stop(); close(stopped) }()
+		select {
+		case <-stopped:
+		case <-time.After(250 * time.Millisecond):
+			t.Fatal("Stop did not cancel the live AI response-body read")
+		}
+		if requestContext.Err() != context.Canceled || calls.Load() != run {
+			t.Fatal("Stop lost cancellation or retried the free model")
+		}
+		if err := <-completed; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
