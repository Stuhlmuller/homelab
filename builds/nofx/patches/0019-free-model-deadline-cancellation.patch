+package backtest
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"nofx/kernel"
+	"nofx/market"
+	"nofx/mcp"
+	"nofx/store"
+)
+
+type historicalCancelTransport func(*http.Request) (*http.Response, error)
+
+func (f historicalCancelTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type historicalDelayedBody struct {
+	ctx     context.Context
+	reading chan<- context.Context
+	release <-chan struct{}
+	timeout bool
+}
+
+func (b *historicalDelayedBody) Read([]byte) (int, error) {
+	if b.timeout {
+		return 0, context.DeadlineExceeded
+	}
+	b.reading <- b.ctx
+	select {
+	case <-b.ctx.Done():
+		return 0, b.ctx.Err()
+	case <-b.release:
+		return 0, io.EOF
+	}
+}
+func (*historicalDelayedBody) Close() error { return nil }
+
+func TestHistoricalFreeRequestCancellation(t *testing.T) {
+	original := http.DefaultTransport
+	http.DefaultTransport = historicalCancelTransport(func(*http.Request) (*http.Response, error) {
+		t.Error("unexpected external request outside synthetic fixture")
+		return nil, errors.New("external requests disabled")
+	})
+	t.Cleanup(func() { http.DefaultTransport = original })
+	for _, mode := range []string{"stop", "parent_cancel", "timeout_then_stop", "paused_stop"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Chdir(t.TempDir())
+			cfg := BacktestConfig{RunID: "cancel-test", Symbols: []string{"BTCUSDT"}, Timeframes: []string{"3m"}, DecisionTimeframe: "3m", InitialBalance: 1000}
+			series := &timeframeSeries{}
+			for i := int64(0); i < 81; i++ {
+				open := int64(1577836800000) + i*180000
+				series.klines = append(series.klines, market.Kline{OpenTime: open, CloseTime: open + 179999, Open: 100, High: 101, Low: 99, Close: 100, Volume: 1})
+				series.closeTimes = append(series.closeTimes, open+179999)
+			}
+			feed := &DataFeed{symbols: cfg.Symbols, timeframes: cfg.Timeframes, primaryTF: "3m", decisionTimes: series.closeTimes[79:], symbolSeries: map[string]*symbolSeries{"BTCUSDT": {byTF: map[string]*timeframeSeries{"3m": series}}}}
+			strategy := store.GetDefaultStrategyConfig("en")
+			strategy.CoinSource = store.CoinSourceConfig{SourceType: "static", StaticCoins: cfg.Symbols}
+			r := &Runner{cfg: cfg, feed: feed, strategyEngine: kernel.NewStrategyEngine(&strategy), account: NewBacktestAccount(1000, 0, 0), state: &BacktestState{Cash: 1000, Equity: 1000, MaxEquity: 1000, MinEquity: 1000}, status: RunStateCreated, pauseCh: make(chan struct{}, 1), resumeCh: make(chan struct{}, 1), stopCh: make(chan struct{}, 1), doneCh: make(chan struct{})}
+			reading := make(chan context.Context, 2)
+			release := make(chan struct{})
+			var calls atomic.Int32
+			r.mcpClient = mcp.NewStructuredFreeRouterClient("synthetic", mcp.WithHTTPClient(&http.Client{Transport: historicalCancelTransport(func(req *http.Request) (*http.Response, error) {
+				if req.Method != http.MethodPost || req.URL.String() != "https://openrouter.ai/api/v1/chat/completions" {
+					t.Error("unexpected network request")
+				}
+				attempt := calls.Add(1)
+				return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: &historicalDelayedBody{req.Context(), reading, release, mode == "timeout_then_stop" && attempt == 1}, Request: req}, nil
+			})}))
+			parent, cancel := context.WithCancel(context.Background())
+			t.Cleanup(func() { close(release); cancel(); r.Stop(); _ = r.Wait() })
+			if mode == "paused_stop" {
+				r.Pause()
+			}
+			if err := r.Start(parent); err != nil {
+				t.Fatal(err)
+			}
+			if mode == "paused_stop" {
+				deadline := time.Now().Add(time.Second)
+				for r.Status() != RunStatePaused && time.Now().Before(deadline) {
+					time.Sleep(time.Millisecond)
+				}
+				if r.Status() != RunStatePaused {
+					t.Fatal("runner did not pause")
+				}
+				if err := r.Start(parent); err == nil {
+					t.Fatal("paused active runner accepted a second cancellation owner")
+				}
+				r.Stop()
+				select {
+				case <-r.doneCh:
+				case <-time.After(250 * time.Millisecond):
+					t.Fatal("Stop did not interrupt paused wait")
+				}
+				if r.Wait() != nil || r.Status() != RunStateStopped || calls.Load() != 0 || r.snapshotState().BarIndex != 0 {
+					t.Fatal("paused Stop advanced or failed the run")
+				}
+				return
+			}
+			var requestContext context.Context
+			select {
+			case requestContext = <-reading:
+			case <-time.After(2 * time.Second):
+				t.Fatal("historical loop did not reach body read")
+			}
+			wantBars, wantCalls := 0, int32(1)
+			if mode == "timeout_then_stop" {
+				wantBars, wantCalls = 1, 2
+				if parent.Err() != nil || r.Status() != RunStateRunning || r.snapshotState().BarIndex != 1 {
+					t.Fatal("HTTP timeout stopped the lifecycle instead of recording a failed cycle")
+				}
+			}
+			if mode == "parent_cancel" {
+				cancel()
+			} else {
+				r.Stop()
+			}
+			select {
+			case <-r.doneCh:
+			case <-time.After(250 * time.Millisecond):
+				t.Fatal("historical cancellation did not interrupt response body")
+			}
+			if mode != "parent_cancel" && r.Wait() != nil {
+				t.Fatal("normal Stop returned a failure")
+			}
+			if requestContext.Err() != context.Canceled || r.Status() != RunStateStopped || calls.Load() != wantCalls || r.snapshotState().BarIndex != wantBars || len(r.account.Positions()) != 0 {
+				t.Fatal("cancellation retried, advanced a bar, or executed a decision")
+			}
+		})
+	}
+}
