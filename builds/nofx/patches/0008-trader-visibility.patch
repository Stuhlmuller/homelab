--- /dev/null
+++ b/store/trader_visibility_test.go
@@ -0,0 +1,67 @@
+package store
+
+import (
+	"path/filepath"
+	"testing"
+
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+func TestTraderCreatePreservesVisibility(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "traders.db")), &gorm.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	// Reproduce an existing table from before the visibility fix.
+	legacy := struct {
+		Trader
+		ShowInCompetition bool `gorm:"column:show_in_competition;default:true"`
+	}{}
+	if err := db.Table("traders").AutoMigrate(&legacy); err != nil {
+		t.Fatal(err)
+	}
+	traders := NewTraderStore(db)
+
+	cases := []struct {
+		name string
+		show bool
+	}{{"hidden", false}, {"visible", true}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			trader := &Trader{
+				ID: tc.name, UserID: "fixture-user", Name: tc.name,
+				AIModelID: "fixture-model", ExchangeID: "fixture-exchange",
+				ShowInCompetition: tc.show,
+			}
+			if err := traders.Create(trader); err != nil {
+				t.Fatal(err)
+			}
+			saved, err := traders.GetByID(trader.ID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if saved.ShowInCompetition != tc.show || trader.ShowInCompetition != tc.show {
+				t.Fatalf("visibility: stored=%v input=%v, want %v", saved.ShowInCompetition, trader.ShowInCompetition, tc.show)
+			}
+		})
+	}
+
+	if err := traders.initTables(); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range cases {
+		saved, err := traders.GetByID(tc.name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if saved.ShowInCompetition != tc.show {
+			t.Errorf("visibility after migration: %s=%v, want %v", tc.name, saved.ShowInCompetition, tc.show)
+		}
+	}
+}
