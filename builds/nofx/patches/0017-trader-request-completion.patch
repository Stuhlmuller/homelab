diff --git a/web/src/components/AITradersPage.requests.test.tsx b/web/src/components/AITradersPage.requests.test.tsx
new file mode 100644
--- /dev/null
+++ b/web/src/components/AITradersPage.requests.test.tsx
@@ -0,0 +1,299 @@
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { MemoryRouter } from 'react-router-dom'
+import type { TraderInfo } from '../types'
+import { AITradersPage } from './AITradersPage'
+
+const { state, requests, toastPromise, toastError } = vi.hoisted(() => ({
+  state: { traders: [] as TraderInfo[], mutate: vi.fn() },
+  requests: {
+    getModelConfigs: vi.fn(),
+    getExchangeConfigs: vi.fn(),
+    getSupportedModels: vi.fn(),
+    getTraderConfig: vi.fn(),
+    createTrader: vi.fn(),
+    updateTrader: vi.fn(),
+    startTrader: vi.fn(),
+    stopTrader: vi.fn(),
+    deleteTrader: vi.fn(),
+    toggleCompetition: vi.fn(),
+  },
+  toastPromise: vi.fn((operation: Promise<unknown>) => {
+    // Sonner 1.7.4 observes the request but returns a NON-thenable toast.
+    void operation.catch(() => {})
+    return { unwrap: () => operation }
+  }),
+  toastError: vi.fn(),
+}))
+vi.mock('../lib/api', () => ({ api: requests }))
+vi.mock('swr', () => ({
+  default: () => ({
+    data: state.traders,
+    mutate: state.mutate,
+    isLoading: false,
+  }),
+}))
+vi.mock('sonner', () => ({
+  toast: { promise: toastPromise, error: toastError, success: vi.fn() },
+}))
+vi.mock('../lib/notify', () => ({
+  confirmToast: vi.fn().mockResolvedValue(true),
+}))
+vi.mock('../lib/httpClient', () => ({
+  httpClient: {
+    get: vi.fn().mockResolvedValue({ success: true, data: { strategies: [] } }),
+  },
+}))
+vi.mock('../contexts/AuthContext', () => {
+  const auth = { user: { id: 'test-user' }, token: 'test-session' }
+  return { useAuth: () => auth }
+})
+vi.mock('../contexts/LanguageContext', () => ({
+  useLanguage: () => ({ language: 'en' }),
+}))
+
+function deferred() {
+  let resolve!: () => void
+  let reject!: (reason: Error) => void
+  const promise = new Promise<void>((yes, no) => {
+    resolve = yes
+    reject = no
+  })
+  return { promise, resolve, reject }
+}
+
+const trader: TraderInfo = {
+  trader_id: 'agent',
+  trader_name: 'Trend',
+  ai_model: 'model',
+  exchange_id: 'exchange',
+  is_running: false,
+  show_in_competition: false,
+}
+
+async function show() {
+  render(
+    <MemoryRouter>
+      <AITradersPage />
+    </MemoryRouter>
+  )
+  await waitFor(() =>
+    expect(screen.getByRole('button', { name: 'Create Trader' })).toBeEnabled()
+  )
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  state.traders = [{ ...trader }]
+  state.mutate.mockResolvedValue(undefined)
+  requests.getModelConfigs.mockResolvedValue([
+    { id: 'model', name: 'OpenRouter', provider: 'openai', enabled: true },
+  ])
+  requests.getExchangeConfigs.mockResolvedValue([
+    {
+      id: 'exchange',
+      name: 'OKX',
+      exchange_type: 'okx',
+      account_name: 'Shared account',
+      type: 'cex',
+      enabled: true,
+    },
+  ])
+  requests.getSupportedModels.mockResolvedValue([])
+  requests.getTraderConfig.mockResolvedValue({
+    ...trader,
+    scan_interval_minutes: 60,
+  })
+  vi.spyOn(console, 'error').mockImplementation(() => {})
+  vi.spyOn(console, 'log').mockImplementation(() => {})
+})
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+})
+
+it.each([
+  { running: false, succeeds: true },
+  { running: false, succeeds: false },
+  { running: true, succeeds: true },
+  { running: true, succeeds: false },
+])(
+  'awaits the actual toggle and blocks duplicates (running=$running, succeeds=$succeeds)',
+  async ({ running, succeeds }) => {
+    state.traders = [
+      { ...trader, is_running: running },
+      {
+        ...trader,
+        trader_id: 'second',
+        trader_name: 'Breakout',
+        is_running: running,
+      },
+    ]
+    const operation = deferred()
+    const request = running ? requests.stopTrader : requests.startTrader
+    request.mockReturnValue(operation.promise)
+    await show()
+    const [button, other] = screen.getAllByRole('button', {
+      name: running ? 'Stop' : 'Start',
+    })
+    fireEvent.click(button)
+    fireEvent.click(button)
+    await act(async () => {
+      await Promise.resolve()
+    })
+    expect(button).toBeDisabled()
+    expect(other).toBeEnabled()
+    expect(request).toHaveBeenCalledExactlyOnceWith('agent')
+    expect(state.mutate).not.toHaveBeenCalled()
+    await act(async () => {
+      if (succeeds) operation.resolve()
+      else operation.reject(new Error('Request failed'))
+    })
+    await waitFor(() => expect(button).toBeEnabled())
+    expect(state.mutate).toHaveBeenCalledTimes(succeeds ? 1 : 0)
+    expect(request).toHaveBeenCalledOnce()
+    expect(toastPromise).toHaveBeenCalledOnce()
+    expect(toastError).not.toHaveBeenCalled()
+  }
+)
+
+it.each([
+  { edit: false, succeeds: true },
+  { edit: false, succeeds: false },
+  { edit: true, succeeds: true },
+  { edit: true, succeeds: false },
+])(
+  'keeps the trader form open until save settles (edit=$edit, succeeds=$succeeds)',
+  async ({ edit, succeeds }) => {
+    const operation = deferred()
+    const request = edit ? requests.updateTrader : requests.createTrader
+    request.mockReturnValue(operation.promise)
+    await show()
+    fireEvent.click(
+      screen.getByRole('button', { name: edit ? 'Edit' : 'Create Trader' })
+    )
+    const name = await screen.findByPlaceholderText('请输入交易员名称')
+    fireEvent.change(name, { target: { value: 'Saved name' } })
+    const save = screen.getByRole('button', {
+      name: edit ? '保存修改' : '创建交易员',
+    })
+    fireEvent.click(save)
+    await act(async () => {
+      await Promise.resolve()
+    })
+    expect(name).toBeInTheDocument()
+    expect(save).toBeDisabled()
+    expect(state.mutate).not.toHaveBeenCalled()
+    fireEvent.click(save)
+    expect(request).toHaveBeenCalledOnce()
+    await act(async () => {
+      if (succeeds) operation.resolve()
+      else operation.reject(new Error('Request failed'))
+    })
+    if (succeeds) {
+      await waitFor(() =>
+        expect(
+          screen.queryByPlaceholderText('请输入交易员名称')
+        ).not.toBeInTheDocument()
+      )
+      expect(state.mutate).toHaveBeenCalledOnce()
+    } else {
+      await waitFor(() => expect(save).toBeEnabled())
+      expect(name).toHaveValue('Saved name')
+      expect(state.mutate).not.toHaveBeenCalled()
+    }
+    expect(request).toHaveBeenCalledOnce()
+    expect(toastPromise).toHaveBeenCalledOnce()
+  }
+)
+
+it.each([false, true])(
+  'closes a persisted save even if refreshing the list rejects (edit=%s)',
+  async (edit) => {
+    const operation = deferred()
+    const refresh = deferred()
+    const request = edit ? requests.updateTrader : requests.createTrader
+    request.mockReturnValue(operation.promise)
+    state.mutate.mockReturnValue(refresh.promise)
+    await show()
+    fireEvent.click(
+      screen.getByRole('button', { name: edit ? 'Edit' : 'Create Trader' })
+    )
+    const name = await screen.findByPlaceholderText('请输入交易员名称')
+    fireEvent.change(name, { target: { value: 'Persisted name' } })
+    const save = screen.getByRole('button', {
+      name: edit ? '保存修改' : '创建交易员',
+    })
+    fireEvent.click(save)
+    expect(save).toBeDisabled()
+    expect(name).toBeInTheDocument()
+    expect(state.mutate).not.toHaveBeenCalled()
+
+    await act(async () => operation.resolve())
+    expect(state.mutate).toHaveBeenCalledOnce()
+    expect(
+      screen.queryByPlaceholderText('请输入交易员名称')
+    ).not.toBeInTheDocument()
+    await expect(toastPromise.mock.calls[0][0]).resolves.toBeUndefined()
+    await act(async () => refresh.reject(new Error('List refresh failed')))
+    await waitFor(() =>
+      expect(
+        screen.queryByPlaceholderText('请输入交易员名称')
+      ).not.toBeInTheDocument()
+    )
+    expect(request).toHaveBeenCalledOnce()
+    expect(toastPromise).toHaveBeenCalledOnce()
+    await expect(toastPromise.mock.calls[0][0]).resolves.toBeUndefined()
+    expect(toastError).not.toHaveBeenCalled()
+  }
+)
+
+it.each([true, false])(
+  'awaits visibility changes before refreshing (succeeds=%s)',
+  async (succeeds) => {
+    const operation = deferred()
+    requests.toggleCompetition.mockReturnValue(operation.promise)
+    await show()
+    fireEvent.click(screen.getByTitle('在竞技场隐藏'))
+    await act(async () => {
+      await Promise.resolve()
+    })
+    expect(state.mutate).not.toHaveBeenCalled()
+    await act(async () => {
+      if (succeeds) operation.resolve()
+      else operation.reject(new Error('Request failed'))
+    })
+    expect(state.mutate).toHaveBeenCalledTimes(succeeds ? 1 : 0)
+    expect(requests.toggleCompetition).toHaveBeenCalledExactlyOnceWith(
+      'agent',
+      true
+    )
+  }
+)
+
+it('keeps a failed parent validation in the edit form without submitting', async () => {
+  requests.getTraderConfig.mockResolvedValue({
+    ...trader,
+    ai_model: 'removed-model',
+    scan_interval_minutes: 60,
+  })
+  await show()
+  fireEvent.click(screen.getByRole('button', { name: 'Edit' }))
+  const name = await screen.findByPlaceholderText('请输入交易员名称')
+  const save = screen.getByRole('button', { name: '保存修改' })
+  fireEvent.click(save)
+  await act(async () => {
+    await Promise.resolve()
+  })
+  expect(name).toBeInTheDocument()
+  expect(save).toBeEnabled()
+  expect(requests.updateTrader).not.toHaveBeenCalled()
+  expect(state.mutate).not.toHaveBeenCalled()
+})
