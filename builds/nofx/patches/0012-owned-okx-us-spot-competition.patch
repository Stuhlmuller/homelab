+		{"1.000000000000000001", "1", "1", "2"},
+		{"0.999999999999999999", "1", "0", "1"},
+		{"0.000000000000000000019", "0.00000000000000000001", "0.00000000000000000001", "0.00000000000000000002"},
+		{"1", "0.2", "1", "1"},
+		{"0", "0.1", "0", "0"},
+	} {
+		if got := spotFloorStep(spotD(tc.amount), spotD(tc.step)); !got.Equal(spotD(tc.floor)) {
+			t.Fatalf("floor %s by %s: got %s want %s", tc.amount, tc.step, got, tc.floor)
+		}
+		if got := spotCeilStep(spotD(tc.amount), spotD(tc.step)); !got.Equal(spotD(tc.ceil)) {
+			t.Fatalf("ceil %s by %s: got %s want %s", tc.amount, tc.step, got, tc.ceil)
+		}
+	}
+	inst := spotInstrument()
+	inst.MinSize, inst.LotSize = spotD("1.000000000000000001"), spotD("1")
+	if !inst.minimumQuantity().Equal(spotD("2")) || inst.ValidateOrder(spotD("1"), spotD("100")) == nil || inst.ValidateOrder(spotD("2"), spotD("100")) != nil {
+		t.Fatal("effective minimum disagrees with executable lot quantity")
+	}
+	if !spotD("1.5").LessThan(inst.minimumQuantity()) {
+		t.Fatal("unsellable lot dust would permanently block re-entry")
+	}
+}
diff --git a/trader/okx_spot_context.go b/trader/okx_spot_context.go
new file mode 100644
index 0000000..ee79fec
--- /dev/null
+++ b/trader/okx_spot_context.go
@@ -0,0 +1,238 @@
+package trader
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"time"
+
+	"nofx/kernel"
+	"nofx/market"
+
+	"github.com/shopspring/decimal"
+)
+
+// buildSpotTradingContext uses only the configured spot catalog and this agent's
+// reconciled ledger. It must not call GetBalance/GetPositions while holding the
+// execution lock: those public methods acquire the same lock themselves.
+func (at *AutoTrader) buildSpotTradingContext(spot *OKXSpotTrader) (*kernel.Context, error) {
+	if spot == nil || spot.client == nil || spot.store == nil || spot.quote == "" || at.strategyEngine == nil || at.strategyEngine.GetConfig() == nil {
+		return nil, errors.New("cash spot context requires an allocated trader, quote currency, and saved strategy")
+	}
+	config := at.strategyEngine.GetConfig()
+	if config.CoinSource.SourceType != "static" || len(config.CoinSource.StaticCoins) == 0 {
+		return nil, errors.New("cash spot requires an explicit nonempty static coin list; dynamic coin sources are unsupported")
+	}
+	klineConfig := config.Indicators.Klines
+	timeframes := append([]string(nil), klineConfig.SelectedTimeframes...)
+	primary, longer := klineConfig.PrimaryTimeframe, ""
+	// Match the normal engine's legacy defaults: 3m when no timeframe was
+	// selected, first selected timeframe when primary is empty, 30 display bars.
+	if len(timeframes) == 0 {
+		if primary == "" {
+			primary = "3m"
+		}
+		timeframes = append(timeframes, primary)
+		longer = klineConfig.LongerTimeframe
+	}
+	if primary == "" {
+		primary = timeframes[0]
+	}
+	if klineConfig.EnableMultiTimeframe {
+		longer = klineConfig.LongerTimeframe
+	}
+	var err error
+	primary, err = market.NormalizeTimeframe(primary)
+	if err != nil {
+		return nil, fmt.Errorf("cash spot primary timeframe: %w", err)
+	}
+	if longer != "" {
+		longer, err = market.NormalizeTimeframe(longer)
+		if err != nil {
+			return nil, fmt.Errorf("cash spot longer timeframe: %w", err)
+		}
+		timeframes = append(timeframes, longer)
+	}
+	timeframes = append([]string{primary}, timeframes...)
+	count := klineConfig.PrimaryCount
+	if count <= 0 {
+		count = 30
+	}
+	counts := make(map[string]int)
+	frames := make([]string, 0, len(timeframes))
+	for _, timeframe := range timeframes {
+		tf, err := market.NormalizeTimeframe(timeframe)
+		if err != nil {
+			return nil, fmt.Errorf("cash spot timeframe: %w", err)
+		}
+		if _, seen := counts[tf]; seen {
+			continue
+		}
+		n := count
+		if tf == longer && klineConfig.LongerCount > 0 {
+			n = klineConfig.LongerCount
+		}
+		if n > 299 {
+			return nil, errors.New("cash spot supports at most 299 confirmed candles per timeframe")
+		}
+		counts[tf], frames = n, append(frames, tf)
+	}
+
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	snapshot, err := spot.snapshot()
+	if err != nil {
+		return nil, err
+	}
+	amounts, err := spotNumbers(snapshot.Allocation, snapshot.Cash, snapshot.AvailableQuote)
+	if err != nil || snapshot.Cash == "" || snapshot.AvailableQuote == "" || !amounts[0].IsPositive() || amounts[1].IsNegative() || amounts[2].IsNegative() || amounts[2].GreaterThan(amounts[1]) {
+		return nil, errors.New("invalid owned spot cash or allocation")
+	}
+	allocation, cash, available := amounts[0], amounts[1], amounts[2]
+	excluded := make(map[string]bool)
+	for _, symbol := range config.CoinSource.ExcludedCoins {
+		inst, err := spot.instrument(symbol)
+		if err != nil {
+			return nil, fmt.Errorf("cash spot excluded symbol %q: %w", symbol, err)
+		}
+		excluded[inst.InstID] = true
+	}
+	instruments := make(map[string]OKXSpotInstrument)
+	candidates := make([]kernel.CandidateCoin, 0, len(config.CoinSource.StaticCoins))
+	for _, symbol := range config.CoinSource.StaticCoins {
+		inst, err := spot.instrument(symbol)
+		if err != nil {
+			return nil, fmt.Errorf("cash spot configured symbol %q: %w", symbol, err)
+		}
+		canonical := inst.BaseCurrency + inst.QuoteCurrency
+		if _, seen := instruments[canonical]; !seen && !excluded[inst.InstID] {
+			instruments[canonical] = inst
+			candidates = append(candidates, kernel.CandidateCoin{Symbol: canonical, Sources: []string{"static"}})
+		}
+	}
+	owned := make(map[string]decimal.Decimal)
+	for currency, value := range snapshot.Inventory {
+		quantity, err := decimal.NewFromString(value)
+		if err != nil || quantity.IsNegative() {
+			return nil, errors.New("invalid owned spot inventory")
+		}
+		if quantity.IsZero() {
+			continue
+		}
+		inst, err := spot.instrument(currency + "-" + spot.quote)
+		if err != nil {
+			return nil, fmt.Errorf("cash spot owned holding %q: %w", currency, err)
+		}
+		canonical := inst.BaseCurrency + inst.QuoteCurrency
+		// Exclusion prevents entry, but owned assets still need prices and exits.
+		instruments[canonical], owned[canonical] = inst, quantity
+	}
+	if len(instruments) == 0 {
+		return nil, errors.New("cash spot has no eligible configured coins or owned holdings")
+	}
+
+	now := spot.client.now()
+	ctx := &kernel.Context{
+		CashSpot: true, QuoteCurrency: spot.quote,
+		CurrentTime:    now.UTC().Format("2006-01-02 15:04:05 UTC"),
+		RuntimeMinutes: int(now.Sub(at.startTime).Minutes()), CallCount: at.callCount,
+		BTCETHLeverage: 1, AltcoinLeverage: 1,
+		Timeframes: frames, CandidateCoins: candidates,
+		MarketDataMap: make(map[string]*market.Data),
+	}
+	equity, unrealized := cash, decimal.Zero
+	symbols := make([]string, 0, len(instruments))
+	for symbol := range instruments {
+		symbols = append(symbols, symbol)
+	}
+	sort.Strings(symbols)
+	for _, symbol := range symbols {
+		inst := instruments[symbol]
+		series := make(map[string][]market.Kline)
+		for _, tf := range frames {
+			series[tf], err = spotContextCandles(spot.client, inst.InstID, tf, counts[tf])
+			if err != nil {
+				return nil, fmt.Errorf("cash spot %s %s candles: %w", inst.InstID, tf, err)
+			}
+		}
+		data, err := market.BuildDataFromKlines(symbol, series[primary], series[longer])
+		if err != nil {
+			return nil, err
+		}
+		price, err := spot.client.Price(inst.InstID)
+		if err != nil {
+			return nil, err
+		}
+		// BuildDataFromKlines normalizes toward USDT; authenticated catalog identity
+		// is authoritative for USD, USDC, and every other configured quote.
+		data.Symbol, data.CurrentPrice, data.OpenInterest = symbol, price.InexactFloat64(), nil
+		data.TimeframeData = make(map[string]*market.TimeframeSeriesData)
+		for _, tf := range frames {
+			data.TimeframeData[tf] = market.BuildTimeframeSeries(series[tf], tf, counts[tf])
+		}
+		ctx.MarketDataMap[symbol] = data
+		quantity, held := owned[symbol]
+		if !held {
+			continue
+		}
+		average, averageOK := snapshot.AverageCost[inst.BaseCurrency]
+		cost, costOK := snapshot.InventoryCost[inst.BaseCurrency]
+		numbers, err := spotNumbers(average, cost)
+		if !averageOK || !costOK || average == "" || cost == "" || err != nil || numbers[0].IsNegative() || numbers[1].IsNegative() {
+			return nil, errors.New("owned spot holding has no valid ledger cost basis")
+		}
+		value := quantity.Mul(price)
+		pnl := value.Sub(numbers[1])
+		pnlPct := decimal.Zero
+		if numbers[1].IsPositive() {
+			pnlPct = pnl.Div(numbers[1]).Mul(decimal.NewFromInt(100))
+		}
+		equity, unrealized = equity.Add(value), unrealized.Add(pnl)
+		ctx.Positions = append(ctx.Positions, kernel.PositionInfo{
+			Symbol: symbol, Side: "long", Quantity: quantity.InexactFloat64(),
+			EntryPrice: numbers[0].InexactFloat64(), MarkPrice: price.InexactFloat64(), Leverage: 1,
+			UnrealizedPnL: pnl.InexactFloat64(), UnrealizedPnLPct: pnlPct.InexactFloat64(),
+		})
+	}
+	pnl := equity.Sub(allocation)
+	ctx.Account = kernel.AccountInfo{
+		TotalEquity: equity.InexactFloat64(), AvailableBalance: available.InexactFloat64(),
+		UnrealizedPnL: unrealized.InexactFloat64(), TotalPnL: pnl.InexactFloat64(),
+		TotalPnLPct:   pnl.Div(allocation).Mul(decimal.NewFromInt(100)).InexactFloat64(),
+		PositionCount: len(ctx.Positions),
+	}
+	return ctx, nil
+}
+
+func spotContextCandles(client *OKXSpotClient, instID, timeframe string, count int) ([]market.Kline, error) {
+	bar := map[string]string{"1m": "1m", "3m": "3m", "5m": "5m", "15m": "15m", "30m": "30m", "1h": "1H", "2h": "2H", "4h": "4H", "6h": "6Hutc", "12h": "12Hutc", "1d": "1Dutc"}[timeframe]
+	period, err := market.TFDuration(timeframe)
+	if err != nil || bar == "" {
+		return nil, errors.New("unsupported cash spot timeframe")
+	}
+	// Fetch the normal engine's 200 warm-up bars, with room for the currently
+	// unconfirmed candle when a larger display count was explicitly requested.
+	candles, err := client.Candles(instID, bar, max(200, count+1))
+	if err != nil {
+		return nil, err
+	}
+	result := make([]market.Kline, 0, len(candles))
+	for _, candle := range candles {
+		if !candle.Confirmed {
+			continue
+		}
+		openTime := candle.Time.UnixMilli()
+		if len(result) > 0 && openTime-result[len(result)-1].OpenTime != period.Milliseconds() {
+			return nil, errors.New("confirmed cash spot candles contain a gap")
+		}
+		result = append(result, market.Kline{
+			OpenTime: openTime, CloseTime: candle.Time.Add(period - time.Millisecond).UnixMilli(),
+			Open: candle.Open.InexactFloat64(), High: candle.High.InexactFloat64(), Low: candle.Low.InexactFloat64(),
+			Close: candle.Close.InexactFloat64(), Volume: candle.Volume.InexactFloat64(),
+		})
+	}
+	if len(result) < count {
+		return nil, errors.New("insufficient confirmed cash spot candles for the configured count")
+	}
+	return result, nil
+}
