+)
+
+type spotFixtureClient struct {
+	mcp.AIClient
+	response, system, user string
+	calls                  int
+	schema                 map[string]any
+}
+
+func (c *spotFixtureClient) CallWithMessages(system, user string) (string, error) {
+	c.calls++
+	c.system, c.user = system, user
+	return c.response, nil
+}
+
+func (c *spotFixtureClient) CallWithStructuredOutput(system, user string, schema map[string]any) (string, error) {
+	c.schema = schema
+	return c.CallWithMessages(system, user)
+}
+
+func spotContextFixture() *Context {
+	return &Context{
+		CashSpot: true, QuoteCurrency: "USD",
+		Account:        AccountInfo{TotalEquity: 100, AvailableBalance: 50},
+		CandidateCoins: []CandidateCoin{{Symbol: "BTCUSD"}},
+		MarketDataMap:  map[string]*market.Data{"BTCUSD": {Symbol: "BTCUSD", CurrentPrice: 100}},
+	}
+}
+
+func TestSpotDecisionPath(t *testing.T) {
+	buy := Decision{Symbol: "BTCUSD", Action: "open_long", Leverage: 1, PositionSizeUSD: 10, StopLoss: 90, TakeProfit: 130, Confidence: 80, Reasoning: "fixture"}
+	for _, historical := range []bool{false, true} {
+		for _, name := range []string{"buy", "sell", "wait", "short", "close_short", "leveraged", "zero_leverage", "unknown_symbol", "negative_size", "missing_stop"} {
+			t.Run(fmt.Sprintf("historical=%t/%s", historical, name), func(t *testing.T) {
+				d := buy
+				switch name {
+				case "sell":
+					d.Action, d.Leverage = "close_long", 0
+				case "wait":
+					d.Action, d.Leverage = "wait", 0
+				case "short":
+					d.Action = "open_short"
+				case "close_short":
+					d.Action = "close_short"
+				case "leveraged":
+					d.Leverage = 20
+				case "zero_leverage":
+					d.Leverage = 0
+				case "unknown_symbol":
+					d.Symbol = "ETHUSD"
+				case "negative_size":
+					d.PositionSizeUSD = -1
+				case "missing_stop":
+					d.StopLoss = 0
+				}
+				// The historical schema requires zero fields too; Decision uses omitempty.
+				wire := map[string]any{"symbol": d.Symbol, "action": d.Action, "leverage": d.Leverage, "position_size_usd": d.PositionSizeUSD, "stop_loss": d.StopLoss, "take_profit": d.TakeProfit, "confidence": d.Confidence, "risk_usd": d.RiskUSD, "reasoning": d.Reasoning}
+				array, _ := json.Marshal([]any{wire})
+				client := &spotFixtureClient{response: "<decision>" + string(array) + "</decision>"}
+				ctx := spotContextFixture()
+				if historical {
+					ctx.SimulationTimeMS = 1
+					client.response = `{"decisions":` + string(array) + `}`
+				}
+				cfg := store.GetDefaultStrategyConfig("en")
+				cfg.RiskControl.BTCETHMaxLeverage, cfg.RiskControl.AltcoinMaxLeverage = 1, 1
+				engine := NewStrategyEngine(&cfg)
+				engine.nofxosClient = nil // Any current OI fetch would panic.
+				fd, err := GetFullDecisionWithStrategy(ctx, client, engine, "baseline")
+				valid := name == "buy" || name == "sell" || name == "wait"
+				if (err == nil) != valid || client.calls != 1 {
+					t.Fatalf("valid=%t, err=%v, calls=%d", valid, err, client.calls)
+				}
+				if name == "leveraged" && fd.Decisions[0].Leverage != 20 {
+					t.Fatal("invalid leverage was silently clamped")
+				}
+				if historical {
+					schema, _ := json.Marshal(client.schema)
+					if strings.Contains(string(schema), "open_short") || !strings.Contains(string(schema), `"maximum":1`) {
+						t.Fatal("spot schema advertised shorts or uncapped leverage")
+					}
+				}
+			})
+		}
+	}
+	for _, value := range []float64{math.NaN(), math.Inf(1), math.Inf(-1)} {
+		for _, field := range []string{"size", "stop", "take", "risk"} {
+			d := buy
+			switch field {
+			case "size":
+				d.PositionSizeUSD = value
+			case "stop":
+				d.StopLoss = value
+			case "take":
+				d.TakeProfit = value
+			case "risk":
+				d.RiskUSD = value
+			}
+			if err := ValidateSpotDecision(d); err == nil {
+				t.Fatalf("accepted nonfinite %s", field)
+			}
+		}
+	}
+}
+
+type spotRejectTransport struct{ calls int }
+
+func (r *spotRejectTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	r.calls++
+	return nil, fmt.Errorf("unexpected network request")
+}
+
+func TestSpotSnapshotAndPrompt(t *testing.T) {
+	transport := &spotRejectTransport{}
+	originalTransport := http.DefaultTransport
+	http.DefaultTransport = transport
+	t.Cleanup(func() { http.DefaultTransport = originalTransport })
+	cfg := store.GetDefaultStrategyConfig("en")
+	cfg.PromptSections = store.PromptSectionsConfig{RoleDefinition: "trend persona", TradingFrequency: "frequency text", EntryStandards: "entry text", DecisionProcess: "process text"}
+	cfg.CustomPrompt = "custom persona text"
+	cfg.Indicators.EnableOI, cfg.Indicators.EnableFundingRate = true, true
+	engine := NewStrategyEngine(&cfg)
+	engine.nofxosClient = nil
+	for _, name := range []string{"empty", "nil_price", "missing_candidate", "missing_holding", "missing_quote"} {
+		t.Run(name, func(t *testing.T) {
+			ctx := spotContextFixture()
+			switch name {
+			case "empty":
+				ctx.MarketDataMap = nil
+			case "nil_price":
+				ctx.MarketDataMap["BTCUSD"] = nil
+			case "missing_candidate":
+				ctx.CandidateCoins = []CandidateCoin{{Symbol: "ETHUSD"}}
+			case "missing_holding":
+				ctx.Positions = []PositionInfo{{Symbol: "ETHUSD"}}
+			case "missing_quote":
+				ctx.QuoteCurrency = ""
+			}
+			client := &spotFixtureClient{}
+			if _, err := GetFullDecisionWithStrategy(ctx, client, engine, "baseline"); err == nil || client.calls != 0 || transport.calls != 0 {
+				t.Fatalf("missing snapshot reached AI/network: err=%v, AI=%d, network=%d", err, client.calls, transport.calls)
+			}
+		})
+	}
+	ctx := spotContextFixture()
+	ctx.QuantDataMap = map[string]*QuantData{"BTCUSD": {Price: 12345}}
+	system, user := engine.BuildSystemPromptForContext(ctx, "baseline"), engine.BuildUserPrompt(ctx)
+	for _, want := range []string{"trend persona", "frequency text", "entry text", "process text", "custom persona text", "Quote currency: USD", "open_long | close_long | hold | wait"} {
+		if !strings.Contains(system, want) {
+			t.Fatalf("spot system prompt omitted %q", want)
+		}
+	}
+	for _, unwanted := range []string{"open_short", "USDT", "Margin", "Liquidation", "Funding Rate", "Open Interest", "12345"} {
+		if strings.Contains(system+user, unwanted) {
+			t.Fatalf("spot prompt retained %q", unwanted)
+		}
+	}
+	if !strings.Contains(user, "Available cash 50.00 USD") || !cfg.Indicators.EnableOI || !cfg.Indicators.EnableFundingRate {
+		t.Fatal("cash prompt incorrect or saved configuration mutated")
+	}
+	ctx.CashSpot = false
+	// The legacy schema iterates maps, so ordering varies between calls.
+	actual := strings.Split(engine.BuildSystemPromptForContext(ctx, "baseline"), "\n")
+	legacy := strings.Split(engine.BuildSystemPrompt(ctx.Account.TotalEquity, "baseline"), "\n")
+	sort.Strings(actual)
+	sort.Strings(legacy)
+	if strings.Join(actual, "\n") != strings.Join(legacy, "\n") {
+		t.Fatal("legacy system prompt changed")
+	}
+}
