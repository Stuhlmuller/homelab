+		invalid := decision
+		invalid.StopLoss, invalid.TakeProfit = tc.stop, tc.take
+		bounded := risk
+		bounded.MinRiskRewardRatio = tc.ratio
+		if _, err := a.ExecuteSpotDecision(invalid, bounded, []string{"BTCUSDT"}); err == nil || !strings.Contains(err.Error(), tc.wantError) || posts != 0 {
+			t.Fatalf("%s not rejected before submission: %v; POSTs=%d", tc.name, err, posts)
+		}
+		intents, err := st.Spot().Intents("owner", "ex")
+		must(err)
+		if len(intents) != 0 {
+			t.Fatal("invalid rounded protection created an order intent")
+		}
+	}
+	// Ten quote units are exactly 25% before fees, but exceed 25% of the
+	// conservative post-fee equity. Both hard limits must reject before any POST.
+	for _, limit := range []string{"position", "utilization"} {
+		bounded := risk
+		if limit == "position" {
+			bounded.BTCETHMaxPositionValueRatio = 0.25
+		} else {
+			bounded.MaxMarginUsage = 0.25
+		}
+		if _, err := a.ExecuteSpotDecision(decision, bounded, []string{"BTCUSDT"}); err == nil || posts != 0 {
+			t.Fatalf("post-fee %s limit did not reject before submission: %v", limit, err)
+		}
+	}
+	_, err = a.ExecuteSpotDecision(decision, risk, []string{"BTCUSDT"})
+	must(err)
+	_, err = b.ExecuteSpotDecision(decision, risk, []string{"BTCUSDT"})
+	must(err)
+	beforeB, err := st.Spot().Snapshot("owner", "ex", "b")
+	must(err)
+	if !decimal.RequireFromString(beforeB.Inventory["BTC"]).Equal(spotD("0.1")) {
+		t.Fatalf("unexpected owned inventory: %#v", beforeB)
+	}
+	intents, err := st.Spot().Intents("owner", "ex")
+	must(err)
+	bAlgo := ""
+	for _, i := range intents {
+		if i.Side == "buy" && (i.StopLoss != "90" || i.TakeProfit != "120") {
+			t.Fatalf("entry persisted unquantized protection: stop=%s take=%s", i.StopLoss, i.TakeProfit)
+		}
+		if i.TraderID == "b" && i.IsProtection {
+			bAlgo = i.AlgoID
+		}
+	}
+	if bAlgo == "" {
+		t.Fatal("second agent lacks owned protection")
+	}
+	_, err = a.CloseLong("BTCUSDT", 0)
+	must(err)
+	afterB, err := st.Spot().Snapshot("owner", "ex", "b")
+	must(err)
+	if beforeB.Inventory["BTC"] != afterB.Inventory["BTC"] || beforeB.Cash != afterB.Cash {
+		t.Fatal("first agent changed second agent inventory/cash")
+	}
+	for _, id := range canceled {
+		if id == bAlgo {
+			t.Fatal("first agent canceled second agent protection")
+		}
+	}
+	before := posts
+	invalid := decision
+	invalid.Action = "open_short"
+	if _, err = b.ExecuteSpotDecision(invalid, risk, []string{"BTCUSDT"}); err == nil {
+		t.Fatal("short accepted")
+	}
+	invalid = decision
+	invalid.Leverage = 10
+	if _, err = b.ExecuteSpotDecision(invalid, risk, []string{"BTCUSDT"}); err == nil {
+		t.Fatal("leveraged buy accepted")
+	}
+	if _, err = b.CloseLong("BTCUSDT", 100); err == nil || strings.TrimSpace(err.Error()) == "" {
+		t.Fatal("unowned sale accepted")
+	}
+	if posts != before {
+		t.Fatal("invalid decisions performed a write")
+	}
+	// A valid ticker can expire while other account checks run. Reject the
+	// unsent reservation locally; never submit against its stale limit.
+	expired, err := st.Spot().Reserve(store.SpotReserve{UserID: "owner", ExchangeID: "ex", TraderID: "a", ClientOrderID: "expired", InstrumentID: "BTC-USDT", BaseCurrency: "BTC", Side: "buy", Quantity: "0.01", QuoteReserve: "1.01", BaseReserve: "0"})
+	must(err)
+	if err := a.submitIOC(*expired, spotInstrument(), spotD("100"), c.now().Add(-2*time.Minute)); err == nil {
+		t.Fatal("expired price submitted")
+	}
+	afterExpired, err := st.Spot().Snapshot("owner", "ex", "a")
+	must(err)
+	if afterExpired.ReservedQuote != "0" || posts != before {
+		t.Fatal("expired unsent price retained cash or submitted")
+	}
+	config := store.GetDefaultStrategyConfig("en")
+	config.CoinSource = store.CoinSourceConfig{SourceType: "static", StaticCoins: []string{"BTCUSDT"}, ExcludedCoins: []string{"BTC-USDT"}}
+	at := &AutoTrader{trader: &b, strategyEngine: kernel.NewStrategyEngine(&config)}
+	closeDecision := kernel.Decision{Symbol: "BTCUSDT", Action: "close_long", Leverage: 1}
+	if err := at.executeDecisionWithRecord(&closeDecision, &store.DecisionAction{}); err == nil {
+		t.Fatal("stopped decision executed")
+	}
+	at.isRunning = true
+	if err := at.executeDecisionWithRecord(&decision, &store.DecisionAction{}); err == nil {
+		t.Fatal("excluded candidate executed")
+	}
+	if err := at.ExecuteDecision(&decision); err == nil {
+		t.Fatal("futures debate decision reached cash spot")
+	}
+	if posts != before {
+		t.Fatal("invalid or stopped auto decision submitted")
+	}
+	// Contradictory acknowledgement fields cannot prove rejection or release
+	// allocated cash, even when their final decoded value is an allowed sCode.
+	ambiguous := *a
+	ambiguous.client = spotFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		fmt.Fprint(w, `{"code":"1","data":[{"sCode":"51008","ordId":"123","OrdId":"","clOrdId":"ambiguous"}]}`)
+	})
+	must(st.Spot().SetReconciled("owner", "ex", true))
+	pending, err := st.Spot().Reserve(store.SpotReserve{UserID: "owner", ExchangeID: "ex", TraderID: "a", ClientOrderID: "ambiguous", InstrumentID: "BTC-USDT", BaseCurrency: "BTC", Side: "buy", Quantity: "0.01", QuoteReserve: "1.01", BaseReserve: "0"})
+	must(err)
+	err = ambiguous.submitIOC(*pending, spotInstrument(), spotD("100"), ambiguous.client.now())
+	var rejected *spotRejectedSubmission
+	if err == nil || errors.As(err, &rejected) {
+		t.Fatal("ambiguous submission became a definitive rejection")
+	}
+	uncertain, err := st.Spot().Snapshot("owner", "ex", "a")
+	must(err)
+	if uncertain.Available || uncertain.ReservedQuote != "1.01" || uncertain.Cash != afterExpired.Cash {
+		t.Fatalf("ambiguous submission released cash: %+v", uncertain)
+	}
+	intents, err = st.Spot().Intents("owner", "ex")
+	must(err)
+	for _, intent := range intents {
+		if intent.ClientOrderID == "ambiguous" && intent.State != "UNKNOWN" {
+			t.Fatalf("ambiguous submission state: %s", intent.State)
+		}
+	}
+}
diff --git a/trader/okx_spot_recovery.go b/trader/okx_spot_recovery.go
new file mode 100644
index 0000000..670a151
--- /dev/null
+++ b/trader/okx_spot_recovery.go
@@ -0,0 +1,106 @@
+package trader
+
+import (
+	"errors"
+	"sort"
+
+	"github.com/shopspring/decimal"
+	"nofx/store"
+)
+
+// Explicit execution only: callers hold okxSpotExecution and first reconcile.
+// Never call this from balance/position reads or reconcile itself. A canceled
+// close that never reached SUBMITTED is abandoned; surviving inventory regains
+// the current entry's persisted protection instead of inventing a new sale.
+func (t *OKXSpotTrader) recoverProtection(snapshot *store.SpotSnapshot) (*store.SpotSnapshot, error) {
+	if snapshot == nil || !snapshot.Available {
+		return nil, errors.New("spot protection recovery requires reconciled holdings")
+	}
+	intents, err := t.store.Spot().Intents(t.userID, t.exchangeID)
+	if err != nil {
+		return nil, err
+	}
+	for _, intent := range intents {
+		if intent.TraderID == t.traderID && !intent.IsProtection && intent.State != "FILLED" && intent.State != "CANCELED" && intent.State != "REJECTED" {
+			return nil, errors.New("pending spot order must reconcile before protection recovery")
+		}
+	}
+	currencies := make([]string, 0, len(snapshot.Inventory))
+	for ccy := range snapshot.Inventory {
+		currencies = append(currencies, ccy)
+	}
+	sort.Strings(currencies)
+	for _, ccy := range currencies {
+		quantity, err := decimal.NewFromString(snapshot.Inventory[ccy])
+		if err != nil || quantity.IsNegative() {
+			return nil, errors.New("invalid owned inventory for protection recovery")
+		}
+		if quantity.IsZero() {
+			continue
+		}
+		inst, err := t.instrument(ccy + "-" + t.quote)
+		if err != nil {
+			return nil, err
+		}
+		if spotFloorStep(quantity, inst.LotSize).LessThan(inst.MinSize) {
+			continue // Subminimum dust is retained and may join the next entry.
+		}
+		intents, err := t.store.Spot().Intents(t.userID, t.exchangeID)
+		if err != nil {
+			return nil, err
+		}
+		var entry *store.SpotIntent
+		protected := false
+		for index := range intents {
+			i := &intents[index]
+			if i.TraderID != t.traderID || i.InstrumentID != inst.InstID {
+				continue
+			}
+			if i.ClientOrderID == snapshot.EntryClientOrderID[ccy] && i.Side == "buy" {
+				entry = i
+			}
+			if i.State == "FILLED" || i.State == "CANCELED" || i.State == "REJECTED" {
+				continue
+			}
+			if !i.IsProtection || i.State != "OPEN" || i.AlgoID == "" || i.ProtectionFor != snapshot.EntryClientOrderID[ccy] {
+				return nil, errors.New("pending spot order must reconcile before protection recovery")
+			}
+			if protected {
+				return nil, errors.New("ambiguous active spot protection")
+			}
+			protected = true
+		}
+		if protected {
+			available, err := decimal.NewFromString(snapshot.AvailableInventory[ccy])
+			if err != nil || spotFloorStep(available, inst.LotSize).GreaterThanOrEqual(inst.MinSize) {
+				return nil, errors.New("active spot protection leaves tradable inventory uncovered")
+			}
+			continue // Includes triggered children: their reservation stays held.
+		}
+		if entry == nil || entry.State != "FILLED" && entry.State != "CANCELED" {
+			return nil, errors.New("current terminal spot entry required for protection recovery")
+		}
+		stop, stopErr := decimal.NewFromString(entry.StopLoss)
+		take, takeErr := decimal.NewFromString(entry.TakeProfit)
+		if stopErr != nil || takeErr != nil || !stop.IsPositive() || !take.GreaterThan(stop) {
+			return nil, errors.New("current spot entry has no valid saved protection prices")
+		}
+		if err := t.protectEntry(*entry, inst, stop, take); err != nil {
+			return nil, err
+		}
+		// Re-read after submitting: a triggered order may already have fills.
+		snapshot, err = t.snapshot()
+		if err != nil {
+			return nil, err
+		}
+		remaining, quantityErr := decimal.NewFromString(snapshot.Inventory[ccy])
+		available, availableErr := decimal.NewFromString(snapshot.AvailableInventory[ccy])
+		if quantityErr != nil || availableErr != nil || remaining.IsNegative() || available.IsNegative() {
+			return nil, errors.New("invalid inventory after spot protection recovery")
+		}
+		if spotFloorStep(remaining, inst.LotSize).GreaterThanOrEqual(inst.MinSize) && spotFloorStep(available, inst.LotSize).GreaterThanOrEqual(inst.MinSize) {
+			return nil, errors.New("spot protection ended before recovery completed")
+		}
+	}
+	return snapshot, nil
+}
