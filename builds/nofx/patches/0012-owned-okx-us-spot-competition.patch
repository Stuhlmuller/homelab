+func TestExplicitSpotStopClearsSavedStartupWithoutExchangeAccess(t *testing.T) {
+	for _, loaded := range []bool{false, true} {
+		t.Run(fmt.Sprintf("loaded-%v", loaded), func(t *testing.T) {
+			server, requests := positionsTestServer(t, "0", true)
+			if loaded {
+				if err := server.traderManager.LoadUserTradersFromStore(server.store, "owner"); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := server.traderManager.GetTrader("saved-trader"); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := server.store.Trader().UpdateStatus("owner", "saved-trader", true); err != nil {
+				t.Fatal(err)
+			}
+			*requests = nil
+			for attempt := 0; attempt < 2; attempt++ {
+				w := httptest.NewRecorder()
+				c, _ := gin.CreateTestContext(w)
+				c.Set("user_id", "owner")
+				c.Params = gin.Params{{Key: "id", Value: "saved-trader"}}
+				c.Request = httptest.NewRequest(http.MethodPost, "/api/traders/saved-trader/stop", nil)
+				server.handleStopTrader(c)
+				if w.Code != http.StatusOK {
+					t.Fatalf("explicit Stop HTTP %d: %s", w.Code, w.Body.String())
+				}
+			}
+			record, err := server.store.Trader().GetByID("saved-trader")
+			if err != nil || record.IsRunning || len(*requests) != 0 {
+				t.Fatalf("Stop did not clear startup passively: record=%+v err=%v requests=%v", record, err, *requests)
+			}
+			if runtime, err := server.traderManager.GetTrader("saved-trader"); err == nil {
+				if running, _ := runtime.GetStatus()["is_running"].(bool); running {
+					t.Fatal("stopped runtime became active")
+				}
+			} else if loaded {
+				t.Fatal(err)
+			}
+		})
 	}
 }
