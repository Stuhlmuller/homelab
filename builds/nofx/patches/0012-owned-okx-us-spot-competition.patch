+func TestDashboardAuthenticationRecoveryDoesNotRestartSavedSpotTrader(t *testing.T) {
+	server, requests := positionsTestServer(t, "0", true)
+	if err := server.store.Trader().UpdateStatus("owner", "saved-trader", true); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		for _, runtime := range server.traderManager.GetAllTraders() {
+			runtime.Stop()
+		}
+	})
+	// Simulate startup authentication failure, then recovery of the saved key.
+	recoveredTransport := http.DefaultTransport
+	http.DefaultTransport = startErrorTransport(func(request *http.Request) (*http.Response, error) {
+		if request.Method != http.MethodGet {
+			t.Fatal("failed-auth dashboard attempted a write")
+		}
+		return &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(`{"code":"50119","data":[]}`)), Request: request}, nil
+	})
+	response := positionsTestRequest(server.handlePositions, "owner", "?trader_id=saved-trader")
+	if response.Code != http.StatusServiceUnavailable {
+		t.Fatalf("failed-auth GET HTTP %d: %s", response.Code, response.Body.String())
+	}
+	if _, err := server.traderManager.GetTrader("saved-trader"); err == nil {
+		t.Fatal("failed authentication loaded a runtime")
+	}
+	http.DefaultTransport = recoveredTransport
+	response = positionsTestRequest(server.handlePositions, "owner", "?trader_id=saved-trader")
+	if response.Code != http.StatusOK {
+		t.Fatalf("recovered GET HTTP %d: %s", response.Code, response.Body.String())
+	}
+	runtime, err := server.traderManager.GetTrader("saved-trader")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if running, _ := runtime.GetStatus()["is_running"].(bool); running {
+		t.Fatal("dashboard restarted a persisted-running spot trader")
+	}
+	record, err := server.store.Trader().GetByID("saved-trader")
+	if err != nil || !record.IsRunning {
+		t.Fatal("dashboard changed saved startup intent without an explicit Stop")
+	}
+	if len(*requests) == 0 {
+		t.Fatal("recovery did not verify the exchange")
+	}
+	for _, request := range *requests {
+		if !strings.HasPrefix(request, "GET ") {
+			t.Fatalf("dashboard made exchange write: %s", request)
+		}
+	}
+}
