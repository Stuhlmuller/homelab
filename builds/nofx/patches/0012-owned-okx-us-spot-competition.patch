+// spotTraderAllocation reads the immutable performance baseline, without importing
+// account-wide balances or requiring live exchange access.
+func (s *Server) spotTraderAllocation(userID, exchangeID, traderID string) (float64, bool, error) {
+	if _, err := s.store.Spot().Policy(userID, exchangeID); err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return 0, false, nil
+		}
+		return 0, false, err
+	}
+	allocations, err := s.store.Spot().Allocations(userID, exchangeID)
+	if err != nil {
+		return 0, false, err
+	}
+	amount, exists := allocations[traderID]
+	if !exists {
+		return 0, false, nil
+	}
+	value, err := strconv.ParseFloat(amount, 64)
+	if err != nil || value <= 0 || math.IsNaN(value) || math.IsInf(value, 0) {
+		return 0, false, errors.New("invalid spot allocation")
+	}
+	return value, true, nil
+}
+
+// An allocated trader remains the owner of its cash, fills, and protection.
+// Remove a never-used allocation in the spot form before deleting/rebinding it.
+func (s *Server) spotTraderHasOwnership(userID, exchangeID, traderID string) (bool, error) {
+	exchange, err := s.store.Exchange().GetByID(userID, exchangeID)
+	if err != nil {
+		return false, err
+	}
+	if exchange.ExchangeType != "okx" {
+		return false, nil
+	}
+	_, allocated, err := s.spotTraderAllocation(userID, exchangeID, traderID)
+	if err != nil || allocated {
+		return allocated, err
+	}
+	intents, err := s.store.Spot().Intents(userID, exchangeID)
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	for _, intent := range intents {
+		if intent.TraderID == traderID {
+			return true, nil
+		}
+	}
+	return false, nil
+}
