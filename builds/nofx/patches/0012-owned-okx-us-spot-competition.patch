+	if err != nil {
+		t.Fatal(err)
+	}
+	must := func(err error) {
+		t.Helper()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	must(db.Exec(`CREATE TABLE exchanges (id TEXT PRIMARY KEY,user_id TEXT,exchange_type TEXT)`).Error)
+	must(db.Exec(`INSERT INTO exchanges VALUES ('ex','owner','okx')`).Error)
+	must(db.Exec(`CREATE TABLE traders (id TEXT PRIMARY KEY,user_id TEXT,exchange_id TEXT)`).Error)
+	must(db.Exec(`INSERT INTO traders VALUES ('a','owner','ex'),('b','owner','ex')`).Error)
+	must(st.Spot().InitTables())
+	must(st.Spot().Configure(store.SpotPolicy{UserID: "owner", AccountUID: "123", QuoteCurrency: "USDT", CapitalCap: "100"}, []string{"ex"}, map[string]string{"a": "50", "b": "50"}))
+	complete := func(id, traderID, side, order, stop, take string) {
+		must(st.Spot().SetReconciled("owner", "ex", true))
+		r := store.SpotReserve{UserID: "owner", ExchangeID: "ex", TraderID: traderID, ClientOrderID: id, InstrumentID: "BTC-USDT", BaseCurrency: "BTC", Side: side, Quantity: "0.1", QuoteReserve: "0", BaseReserve: "0.1", StopLoss: stop, TakeProfit: take}
+		if side == "buy" {
+			r.QuoteReserve, r.BaseReserve, r.MinQuantity = "10", "0", "0.01"
+		}
+		_, err := st.Spot().Reserve(r)
+		must(err)
+		must(st.Spot().SetIntentState("owner", id, "", "SUBMITTED"))
+		must(st.Spot().SetIntentState("owner", id, order, "OPEN"))
+		must(st.Spot().ApplyFill("owner", store.SpotFill{ExchangeID: "ex", ClientOrderID: id, ExchangeOrderID: order, FillID: order, Quantity: "0.1", QuoteQuantity: "10", Fee: "0", Rebate: "0"}))
+		must(st.Spot().Finish("owner", id, "FILLED", "0.1"))
+	}
+	complete("zHistorical", "a", "buy", "1", "80", "120")
+	complete("exitHistorical", "a", "sell", "2", "", "")
+	complete("aCurrent", "a", "buy", "3", "90", "110") // Crash before creating its OCO.
+	algoBodies := map[string]map[string]string{}
+	algoStates := map[string]string{}
+	orderBodies := map[string]map[string]string{}
+	orderFills := map[string]string{}
+	ocoPosts, iocPosts, cancels := 0, 0, 0
+	nextFill, loseAck, missingOrder, rejectIOC := "0.04", false, false, false
+	client := spotFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "POST" {
+			switch r.URL.Path {
+			case okxAlgoOrderPath:
+				var body map[string]string
+				must(json.NewDecoder(r.Body).Decode(&body))
+				if body["slTriggerPx"] != "90" || body["tpTriggerPx"] != "110" {
+					t.Fatal("recovery used historical or invented stops")
+				}
+				ocoPosts++
+				id := body["algoClOrdId"]
+				body["algoId"] = fmt.Sprint(70 + ocoPosts)
+				algoBodies[id], algoStates[id] = body, "live"
+				spotReply(w, fmt.Sprintf(`[{"sCode":"0","algoId":%q,"algoClOrdId":%q}]`, body["algoId"], id))
+			case okxCancelAlgoPath:
+				var body []map[string]string
+				must(json.NewDecoder(r.Body).Decode(&body))
+				if len(body) != 1 {
+					t.Fatal("non-owned cancel shape")
+				}
+				found := false
+				for id, algo := range algoBodies {
+					if algo["algoId"] == body[0]["algoId"] {
+						algoStates[id], found = "canceled", true
+					}
+				}
+				if !found {
+					t.Fatal("canceled unowned algo")
+				}
+				cancels++
+				spotReply(w, fmt.Sprintf(`[{"sCode":"0","algoId":%q}]`, body[0]["algoId"]))
+			case okxOrderPath:
+				var body map[string]string
+				must(json.NewDecoder(r.Body).Decode(&body))
+				if body["side"] != "sell" {
+					t.Fatal("recovery unexpectedly bought")
+				}
+				iocPosts++
+				id := body["clOrdId"]
+				if rejectIOC {
+					fmt.Fprintf(w, `{"code":"1","data":[{"clOrdId":%q,"sCode":"51008"}]}`, id)
+					return
+				}
+				body["ordId"] = fmt.Sprint(900 + iocPosts)
+				orderBodies[id], orderFills[id] = body, nextFill
+				if loseAck {
+					w.WriteHeader(http.StatusGatewayTimeout)
+					return
+				}
+				spotReply(w, fmt.Sprintf(`[{"sCode":"0","ordId":%q,"clOrdId":%q}]`, body["ordId"], id))
+			default:
+				t.Fatalf("unexpected POST %s", r.URL.Path)
+			}
+			return
+		}
+		if r.Method != "GET" {
+			t.Fatal("unexpected method")
+		}
+		switch r.URL.Path {
+		case "/api/v5/account/config":
+			spotReply(w, `[{"uid":"123","acctLv":"1","feeType":"0","perm":"read_only,trade","autoLoan":false,"enableSpotBorrow":false}]`)
+		case "/api/v5/account/balance":
+			spotReply(w, `[{"details":[{"ccy":"USDT","cashBal":"1000","availBal":"1000","liab":"0"},{"ccy":"BTC","cashBal":"1","availBal":"1","liab":"0"}]}]`)
+		case "/api/v5/account/instruments":
+			spotReply(w, `[{"instType":"SPOT","instId":"BTC-USDT","baseCcy":"BTC","quoteCcy":"USDT","state":"live","lotSz":"0.001","minSz":"0.01","tickSz":"0.1","maxLmtSz":"5","groupId":"12"}]`)
+		case "/api/v5/account/trade-fee":
+			spotReply(w, `[{"instType":"SPOT","feeGroup":[{"groupId":"12","maker":"0","taker":"0"}]}]`)
+		case "/api/v5/market/ticker":
+			spotReply(w, `[{"instId":"BTC-USDT","last":"100","ts":"28800000"}]`)
+		case okxAlgoOrderPath:
+			id := r.URL.Query().Get("algoClOrdId")
+			body := algoBodies[id]
+			if body == nil {
+				t.Fatal("queried unowned algo")
+			}
+			spotReply(w, fmt.Sprintf(`[{"instType":"SPOT","instId":"BTC-USDT","algoId":%q,"algoClOrdId":%q,"tdMode":"cash","side":"sell","ordType":"oco","state":%q,"sz":%q,"ordIdList":[]}]`, body["algoId"], id, algoStates[id], body["sz"]))
+		case okxOrderPath:
+			if missingOrder {
+				fmt.Fprint(w, `{"code":"51603","data":[]}`)
+				return
+			}
+			id := r.URL.Query().Get("clOrdId")
+			body := orderBodies[id]
+			if body == nil {
+				t.Fatal("queried unowned order")
+			}
+			spotReply(w, fmt.Sprintf(`[{"instType":"SPOT","instId":"BTC-USDT","ordId":%q,"clOrdId":%q,"tdMode":"cash","side":"sell","state":"canceled","ordType":"ioc","sz":%q,"accFillSz":%q,"avgPx":"100","px":"100","fee":"0","rebate":"0","tradeQuoteCcy":"USDT"}]`, body["ordId"], id, body["sz"], orderFills[id]))
+		case "/api/v5/trade/fills-history":
+			for id, body := range orderBodies {
+				if body["ordId"] != r.URL.Query().Get("ordId") {
+					continue
+				}
+				if orderFills[id] == "0" || r.URL.Query().Get("after") != "" {
+					spotReply(w, `[]`)
+					return
+				}
+				spotReply(w, fmt.Sprintf(`[{"instType":"SPOT","instId":"BTC-USDT","ordId":%q,"clOrdId":%q,"billId":%q,"tradeId":%q,"side":"sell","fillPx":"100","fillSz":%q,"fee":"0","rebate":"0","fillTime":"28800000","tradeQuoteCcy":"USDT"}]`, body["ordId"], id, body["ordId"], body["ordId"], orderFills[id]))
+				return
+			}
+			t.Fatal("queried unowned fills")
+		default:
+			t.Fatalf("unexpected GET %s", r.URL.Path)
+		}
+	})
+	a := &OKXSpotTrader{client: client, store: st, userID: "owner", exchangeID: "ex", traderID: "a", accountUID: "123", quote: "USDT"}
+	_, err = a.GetBalance()
+	must(err)
+	if ocoPosts+iocPosts+cancels != 0 {
+		t.Fatal("read-only balance recovered by posting")
+	}
+	_, err = a.ExecuteSpotDecision(kernel.Decision{Action: "wait", Symbol: "BTCUSDT"}, store.RiskControlConfig{}, nil)
+	must(err)
+	if ocoPosts != 1 {
+		t.Fatal("explicit execution did not recover crashed entry")
+	}
+	_, err = a.ExecuteSpotDecision(kernel.Decision{Action: "wait", Symbol: "BTCUSDT"}, store.RiskControlConfig{}, nil)
+	must(err)
+	if ocoPosts != 1 {
+		t.Fatal("recovery duplicated active OCO")
+	}
+	_, err = a.CloseLong("BTCUSDT", 0)
+	must(err)
+	if ocoPosts != 2 || iocPosts != 1 || cancels != 1 {
+		t.Fatal("partial close did not restore protection")
+	}
+	snapshot, err := st.Spot().Snapshot("owner", "ex", "a")
+	must(err)
+	if snapshot.Inventory["BTC"] != "0.06" || snapshot.AvailableInventory["BTC"] != "0" {
+		t.Fatalf("partial close coverage: %+v", snapshot)
+	}
+	nextFill = "0"
+	_, err = a.CloseLong("BTCUSDT", 0)
+	must(err)
+	if ocoPosts != 3 || iocPosts != 2 {
+		t.Fatal("no-fill close did not restore protection")
+	}
+	// Manual CloseLong has no running AutoTrader/monitor to repair its failure.
+	rejectIOC = true
+	_, err = a.CloseLong("BTCUSDT", 0)
+	var rejected *spotRejectedSubmission
+	if !errors.As(err, &rejected) || rejected.Code != "51008" {
+		t.Fatalf("manual rejected close lost original rejection: %v", err)
+	}
+	if ocoPosts != 4 || iocPosts != 3 {
+		t.Fatal("definitively rejected manual close left inventory unprotected")
+	}
+	snapshot, err = st.Spot().Snapshot("owner", "ex", "a")
+	must(err)
+	if snapshot.AvailableInventory["BTC"] != "0" {
+		t.Fatal("rejected close did not reserve replacement protection")
+	}
+	rejectIOC = false
+	loseAck, missingOrder = true, true
+	if _, err = a.CloseLong("BTCUSDT", 0); err == nil {
+		t.Fatal("lost acknowledgement appeared successful")
+	}
+	before := ocoPosts + iocPosts + cancels
+	if _, err = a.GetBalance(); err == nil {
+		t.Fatal("unresolved sale returned available balance")
+	}
+	if ocoPosts+iocPosts+cancels != before {
+		t.Fatal("read-only unknown reconciliation posted")
+	}
+	snapshot, err = st.Spot().Snapshot("owner", "ex", "a")
+	must(err)
+	if snapshot.Available || snapshot.AvailableInventory["BTC"] != "0" {
+		t.Fatal("unknown sale released its reservation")
+	}
+	loseAck, missingOrder = false, false
+	_, err = a.ExecuteSpotDecision(kernel.Decision{Action: "wait", Symbol: "BTCUSDT"}, store.RiskControlConfig{}, nil)
+	must(err)
+	if ocoPosts != 5 || iocPosts != 4 {
+		t.Fatal("terminal reconciliation did not restore protection")
+	}
+	complete("missingStops", "b", "buy", "4", "", "")
+	b := *a
+	b.traderID = "b"
+	if _, err = b.ExecuteSpotDecision(kernel.Decision{Action: "wait", Symbol: "BTCUSDT"}, store.RiskControlConfig{}, nil); err == nil {
+		t.Fatal("recovery invented missing stop prices")
+	}
+	if ocoPosts != 5 {
+		t.Fatal("missing prices placed protection")
+	}
+}
diff --git a/trader/okx_spot_trader.go b/trader/okx_spot_trader.go
new file mode 100644
index 0000000..85c331b
--- /dev/null
+++ b/trader/okx_spot_trader.go
@@ -0,0 +1,429 @@
+package trader
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/shopspring/decimal"
+	"nofx/store"
+)
+
+// ponytail: one process-wide lock matches this installation's single backend
+// replica. Multiple execution processes require a durable account lease first.
+var okxSpotExecution sync.Mutex
+
+// OKXSpotTrader reports only this trader's allocated cash and owned fills.
+// It deliberately does not embed OKXTrader's account-wide futures operations.
+type OKXSpotTrader struct {
+	client                       *OKXSpotClient
+	store                        *store.Store
+	userID, exchangeID, traderID string
+	accountUID, quote            string
+}
+
+func NewOKXSpotTrader(st *store.Store, userID, exchangeID, traderID, apiKey, secretKey, passphrase string) (*OKXSpotTrader, error) {
+	if st == nil || userID == "" || exchangeID == "" || traderID == "" {
+		return nil, errors.New("owned spot trader required")
+	}
+	p, err := st.Spot().Policy(userID, exchangeID)
+	if err != nil {
+		return nil, errors.New("configure an explicit OKX spot capital limit and trader allocations first")
+	}
+	t := &OKXSpotTrader{client: NewOKXSpotClient(apiKey, secretKey, passphrase), store: st,
+		userID: userID, exchangeID: exchangeID, traderID: traderID, accountUID: p.AccountUID, quote: p.QuoteCurrency}
+	if _, err := st.Spot().Snapshot(userID, exchangeID, traderID); err != nil {
+		return nil, err
+	}
+	if err := t.verifyAccount(); err != nil {
+		return nil, err
+	}
+	return t, nil
+}
+
+func (t *OKXSpotTrader) verifyAccount() error {
+	account, err := t.client.Account()
+	if err != nil {
+		return err
+	}
+	if account.UID != t.accountUID {
+		return errors.New("OKX credential belongs to a different spot account")
+	}
+	if account.AccountLevel != "1" && account.AccountLevel != "2" {
+		return errors.New("cash spot requires OKX spot or futures account mode")
+	}
+	if account.AutoLoan == nil || account.EnableSpotBorrow == nil || *account.AutoLoan || *account.EnableSpotBorrow {
+		return errors.New("disable automatic borrowing in OKX before using cash spot competition")
+	}
+	canTrade := false
+	for _, permission := range strings.Split(account.Permissions, ",") {
+		canTrade = canTrade || strings.TrimSpace(permission) == "trade"
+	}
+	if !canTrade {
+		return errors.New("OKX key requires explicit trade permission for cash spot")
+	}
+	if account.FeeType != "0" && account.FeeType != "1" {
+		return errors.New("unsupported spot fee currency mode")
+	}
+	return nil
+}
+
+func (t *OKXSpotTrader) instrument(symbol string) (OKXSpotInstrument, error) {
+	inst, err := t.client.ResolveInstrument(symbol)
+	if err != nil {
+		return inst, err
+	}
+	if inst.QuoteCurrency != t.quote {
+		return inst, errors.New("instrument does not use the configured competition currency")
+	}
+	return inst, nil
+}
+
+// reconcileOrder ingests all pages before accepting the exchange's cumulative
+// fill quantity. A timeout or missing order retains ownership and reservations.
+func (t *OKXSpotTrader) reconcileOrder(intent store.SpotIntent, ref OKXSpotOrderRef) error {
+	order, err := t.client.Order(ref)
+	if err != nil {
+		return err
+	}
+	quantity, parseErr := decimal.NewFromString(intent.Quantity)
+	if parseErr != nil || order.Side != intent.Side || !order.Quantity.Equal(quantity) {
+		return errors.New("spot order differs from its persisted intent")
+	}
+	if !intent.IsProtection {
+		if err := t.store.Spot().SetIntentState(t.userID, intent.ClientOrderID, order.OrderID, "OPEN"); err != nil {
+			return err
+		}
+	}
+	ref.OrderID = order.OrderID
+	var fills []OKXSpotFill
+	after := ""
+	seen := map[string]bool{}
+	for {
+		page, err := t.client.Fills(ref, after)
+		if err != nil {
+			return err
+		}
+		fills = append(fills, page.Fills...)
+		if page.After == "" {
+			break
+		}
+		if seen[page.After] {
+			return errors.New("spot fill pagination did not advance")
+		}
+		seen[page.After], after = true, page.After
+		if len(seen) > 1000 {
+			return errors.New("spot fill reconciliation exceeds page limit")
+		}
+	}
+	sort.SliceStable(fills, func(i, j int) bool {
+		if !fills[i].FillTime.Equal(fills[j].FillTime) {
+			return fills[i].FillTime.Before(fills[j].FillTime)
+		}
+		if len(fills[i].BillID) != len(fills[j].BillID) {
+			return len(fills[i].BillID) < len(fills[j].BillID)
+		}
+		return fills[i].BillID < fills[j].BillID
+	})
+	for _, fill := range fills {
+		if fill.Side != intent.Side {
+			return errors.New("spot fill side mismatch")
+		}
+		if err := t.store.Spot().ApplyFill(t.userID, store.SpotFill{
+			ExchangeID: intent.ExchangeID, ClientOrderID: intent.ClientOrderID, ExchangeOrderID: order.OrderID,
+			FillID: fill.TradeID, Quantity: fill.Quantity.String(), QuoteQuantity: fill.Quantity.Mul(fill.Price).String(),
+			Fee: fill.Fee.String(), FeeCurrency: fill.FeeCurrency, Rebate: fill.Rebate.String(), RebateCurrency: fill.RebateCurrency,
+		}); err != nil {
+			return err
+		}
+	}
+	if intent.IsProtection {
+		return nil
+	}
+	switch order.State {
+	case "filled":
+		return t.store.Spot().Finish(t.userID, intent.ClientOrderID, "FILLED", order.FilledQuantity.String())
+	case "canceled", "mmp_canceled":
+		return t.store.Spot().Finish(t.userID, intent.ClientOrderID, "CANCELED", order.FilledQuantity.String())
+	case "live", "partially_filled":
+		return nil
+	default:
+		return errors.New("unrecognized spot order state")
+	}
+}
+
+// Caller holds okxSpotExecution. Reconcile the physical account, including
+// intents entered through another saved connection to the same authenticated UID.
+func (t *OKXSpotTrader) reconcile() error {
+	if err := t.store.Spot().SetReconciled(t.userID, t.exchangeID, false); err != nil {
+		return err
+	}
+	if err := t.verifyAccount(); err != nil {
+		return err
+	}
+	intents, err := t.store.Spot().Intents(t.userID, t.exchangeID)
+	if err != nil {
+		return err
+	}
+	for _, intent := range intents {
+		switch intent.State {
+		case "FILLED", "CANCELED", "REJECTED":
+			continue
+		case "RESERVED":
+			// SUBMITTED is always durable before HTTP; an unsent intent is safe to release.
+			if intent.IsProtection {
+				if err := t.store.Spot().FinishProtection(t.userID, intent.ClientOrderID, "", "REJECTED", "", "0"); err != nil {
+					return err
+				}
+			} else if err := t.store.Spot().Finish(t.userID, intent.ClientOrderID, "REJECTED", "0"); err != nil {
+				return err
+			}
+		default:
+			if intent.IsProtection {
+				if err := t.reconcileProtection(intent); err != nil {
+					return err
+				}
+				continue
+			}
+			if err := t.reconcileOrder(intent, OKXSpotOrderRef{InstID: intent.InstrumentID, ClientOrderID: intent.ClientOrderID, OrderID: intent.ExchangeOrderID}); err != nil {
+				return err
+			}
+		}
+	}
+	if err := t.verifyWallet(); err != nil {
+		return err
+	}
+	return t.store.Spot().SetReconciled(t.userID, t.exchangeID, true)
+}
+
+func (t *OKXSpotTrader) verifyWallet() error {
+	wallet, err := t.client.Wallet()
+	if err != nil {
+		return err
+	}
+	actual := make(map[string]decimal.Decimal, len(wallet))
+	for _, balance := range wallet {
+		if balance.Liability.IsPositive() || balance.Cash.IsNegative() {
+			return errors.New("cash spot account contains borrowing")
+		}
+		actual[balance.Currency] = balance.Cash
+	}
+	cash, inventory, err := t.store.Spot().AccountHoldings(t.userID, t.exchangeID)
+	if err != nil {
+		return err
+	}
+	owned := map[string]decimal.Decimal{t.quote: decimal.RequireFromString(cash)}
+	for ccy, amount := range inventory {
+		owned[ccy] = decimal.RequireFromString(amount)
+	}
+	for ccy, amount := range owned {
+		if actual[ccy].LessThan(amount) {
+			return errors.New("OKX wallet no longer covers the competition ledger; reconciliation required")
+		}
+	}
+	return nil
+}
+
+func (t *OKXSpotTrader) snapshot() (*store.SpotSnapshot, error) {
+	if err := t.reconcile(); err != nil {
+		return nil, err
+	}
+	snapshot, err := t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return nil, err
+	}
+	if !snapshot.Available {
+		return nil, errors.New("spot balances unavailable until reconciliation completes")
+	}
+	return snapshot, nil
+}
+
+func (t *OKXSpotTrader) GetBalance() (map[string]interface{}, error) {
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	snapshot, err := t.snapshot()
+	if err != nil {
+		return nil, err
+	}
+	cash := decimal.RequireFromString(snapshot.Cash)
+	equity, cost := cash, decimal.Zero
+	count := 0
+	for ccy, amount := range snapshot.Inventory {
+		quantity := decimal.RequireFromString(amount)
+		if quantity.IsZero() {
+			continue
+		}
+		inst, err := t.instrument(ccy + "-" + t.quote)
+		if err != nil {
+			return nil, err
+		}
+		price, err := t.client.Price(inst.InstID)
+		if err != nil {
+			return nil, err
+		}
+		if quantity.GreaterThanOrEqual(inst.minimumQuantity()) {
+			count++
+		}
+		equity = equity.Add(quantity.Mul(price))
+		cost = cost.Add(decimal.RequireFromString(snapshot.InventoryCost[ccy]))
+	}
+	wallet := cash.Add(cost)
+	allocation := decimal.RequireFromString(snapshot.Allocation)
+	invested := equity.Sub(cash)
+	usage := decimal.Zero
+	if equity.IsPositive() {
+		usage = invested.Div(equity).Mul(decimal.NewFromInt(100))
+	}
+	return map[string]interface{}{
+		"total_equity": equity.InexactFloat64(), "totalEquity": equity.InexactFloat64(),
+		"totalWalletBalance": wallet.InexactFloat64(), "totalUnrealizedProfit": equity.Sub(wallet).InexactFloat64(),
+		"availableBalance": decimal.RequireFromString(snapshot.AvailableQuote).InexactFloat64(),
+		"allocation":       decimal.RequireFromString(snapshot.Allocation).InexactFloat64(),
+		"quoteCurrency":    t.quote, "quote_currency": t.quote, "marketMode": "cash_spot", "market_mode": "cash_spot",
+		"wallet_balance": wallet.InexactFloat64(), "unrealized_profit": equity.Sub(wallet).InexactFloat64(),
+		"available_balance": decimal.RequireFromString(snapshot.AvailableQuote).InexactFloat64(),
+		"total_pnl":         equity.Sub(allocation).InexactFloat64(), "total_pnl_pct": equity.Sub(allocation).Div(allocation).Mul(decimal.NewFromInt(100)).InexactFloat64(),
+		"initial_balance": allocation.InexactFloat64(), "daily_pnl": 0.0, "position_count": count,
+		"margin_used": invested.InexactFloat64(), "margin_used_pct": usage.InexactFloat64(),
+	}, nil
+}
+
+func (t *OKXSpotTrader) GetPositions() ([]map[string]interface{}, error) {
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	snapshot, err := t.snapshot()
+	if err != nil {
+		return nil, err
+	}
+	result := []map[string]interface{}{}
+	currencies := make([]string, 0, len(snapshot.Inventory))
+	for ccy := range snapshot.Inventory {
+		currencies = append(currencies, ccy)
+	}
+	sort.Strings(currencies)
+	for _, ccy := range currencies {
+		quantity := decimal.RequireFromString(snapshot.Inventory[ccy])
+		if quantity.IsZero() {
+			continue
+		}
+		inst, err := t.instrument(ccy + "-" + t.quote)
+		if err != nil {
+			return nil, err
+		}
+		price, err := t.client.Price(inst.InstID)
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, map[string]interface{}{
+			"symbol": ccy + t.quote, "side": "long", "positionAmt": quantity.InexactFloat64(),
+			"entryPrice": decimal.RequireFromString(snapshot.AverageCost[ccy]).InexactFloat64(),
+			"markPrice":  price.InexactFloat64(), "unRealizedProfit": quantity.Mul(price).Sub(decimal.RequireFromString(snapshot.InventoryCost[ccy])).InexactFloat64(),
+			"leverage": float64(1), "liquidationPrice": float64(0), "marketMode": "cash_spot",
+		})
+	}
+	return result, nil
+}
+
+func (t *OKXSpotTrader) GetMarketPrice(symbol string) (float64, error) {
+	inst, err := t.instrument(symbol)
+	if err != nil {
+		return 0, err
+	}
+	price, err := t.client.Price(inst.InstID)
+	return price.InexactFloat64(), err
+}
+
+func (t *OKXSpotTrader) FormatQuantity(symbol string, quantity float64) (string, error) {
+	if quantity <= 0 {
+		return "", errors.New("positive spot quantity required")
+	}
+	inst, err := t.instrument(symbol)
+	if err != nil {
+		return "", err
+	}
+	value, err := decimal.NewFromString(fmt.Sprint(quantity))
+	if err != nil {
+		return "", errors.New("invalid spot quantity")
+	}
+	value = spotFloorStep(value, inst.LotSize)
+	if value.LessThan(inst.MinSize) || inst.MaxLimitSize.IsPositive() && value.GreaterThan(inst.MaxLimitSize) {
+		return "", errors.New("spot quantity outside instrument limits")
+	}
+	return value.String(), nil
+}
+
+func (*OKXSpotTrader) SetLeverage(_ string, leverage int) error {
+	if leverage != 1 {
+		return errors.New("cash spot permits leverage 1 only")
+	}
+	return nil
+}
+func (*OKXSpotTrader) SetMarginMode(string, bool) error {
+	return errors.New("cash spot has no margin mode")
+}
+func (*OKXSpotTrader) OpenShort(string, float64, int) (map[string]interface{}, error) {
+	return nil, errors.New("cash spot does not permit shorts")
+}
+func (*OKXSpotTrader) CloseShort(string, float64) (map[string]interface{}, error) {
+	return nil, errors.New("cash spot does not permit shorts")
+}
+
+func (t *OKXSpotTrader) reconcileProtection(intent store.SpotIntent) error {
+	ref := OKXSpotAlgoRef{InstID: intent.InstrumentID, ClientOrderID: intent.ClientOrderID, AlgoID: intent.AlgoID}
+	algo, err := t.client.OCO(ref)
+	if err != nil {
+		return err
+	}
+	quantity, err := decimal.NewFromString(intent.Quantity)
+	if err != nil || !algo.Quantity.Equal(quantity) || len(algo.OrderIDs) > 1 {
+		return errors.New("spot protection differs from its owned intent")
+	}
+	if err := t.store.Spot().SetProtectionState(t.userID, intent.ClientOrderID, algo.AlgoID, "OPEN"); err != nil {
+		return err
+	}
+	state := ""
+	switch algo.State {
+	case "live", "partially_effective":
+	case "effective":
+		state = "EFFECTIVE"
+	case "canceled":
+		state = "CANCELED"
+	case "order_failed":
+		state = "REJECTED"
+	default:
+		return errors.New("unrecognized spot protection state")
+	}
+	if len(algo.OrderIDs) == 0 {
+		if state == "CANCELED" || state == "REJECTED" {
+			return t.store.Spot().FinishProtection(t.userID, intent.ClientOrderID, algo.AlgoID, state, "", "0")
+		}
+		if state == "EFFECTIVE" {
+			return errors.New("effective protection is missing its child order")
+		}
+		return nil
+	}
+	if err := t.store.Spot().AttachProtectionChild(t.userID, intent.ClientOrderID, algo.AlgoID, algo.OrderIDs[0]); err != nil {
+		return err
+	}
+	childRef := OKXSpotOrderRef{InstID: intent.InstrumentID, OrderID: algo.OrderIDs[0], ParentAlgoID: algo.AlgoID, ParentAlgoClientID: intent.ClientOrderID}
+	if err := t.reconcileOrder(intent, childRef); err != nil {
+		return err
+	}
+	child, err := t.client.Order(childRef)
+	if err != nil {
+		return err
+	}
+	childState := ""
+	switch child.State {
+	case "filled":
+		childState = "FILLED"
+	case "canceled", "mmp_canceled":
+		childState = "CANCELED"
+	}
+	if state != "" && childState != "" {
+		return t.store.Spot().FinishProtection(t.userID, intent.ClientOrderID, algo.AlgoID, state, childState, child.FilledQuantity.String())
+	}
+	return nil
+}
