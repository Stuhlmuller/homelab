+		case okxAccountPath:
+			spotReply(w, `[{"details":[{"ccy":"USDT","cashBal":"1000","availBal":"1000","liab":"0"},{"ccy":"BTC","cashBal":"20","availBal":"20","liab":"0"}]}]`)
