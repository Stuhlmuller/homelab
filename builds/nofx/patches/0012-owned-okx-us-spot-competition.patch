+)
+
+func competitionFixtureRead(pnl float64) func() (map[string]interface{}, error) {
+	return func() (map[string]interface{}, error) {
+		return map[string]interface{}{
+			"total_equity": 100 + pnl, "total_pnl": pnl, "total_pnl_pct": pnl, "position_count": 0, "margin_used_pct": 0.0,
+		}, nil
+	}
+}
+func TestCompetitionUnavailableNeverOutranksMeasuredLoss(t *testing.T) {
+	valid := competitionAccountData(map[string]interface{}{"trader_id": "loss"}, competitionFixtureRead(-10))
+	zero := competitionAccountData(map[string]interface{}{"trader_id": "zero"}, competitionFixtureRead(0))
+	failed := competitionAccountData(map[string]interface{}{"trader_id": "failed"}, func() (map[string]interface{}, error) { return nil, errors.New("private upstream details") })
+	timedout := unavailableCompetitionData(map[string]interface{}{"trader_id": "timeout"}, "Account refresh in progress")
+	rows := []map[string]interface{}{failed, timedout, valid, zero}
+	sortCompetitionTraders(rows)
+	if rows[0]["trader_id"] != "zero" || rows[1]["trader_id"] != "loss" {
+		t.Fatalf("unavailable or timeout outranked measured returns: %v", rows)
+	}
+	for _, row := range []map[string]interface{}{failed, timedout} {
+		if competitionDataAvailable(row) {
+			t.Fatal("failed account marked available")
+		}
+		for _, key := range []string{"total_equity", "total_pnl", "total_pnl_pct", "position_count", "margin_used_pct"} {
+			if row[key] != nil {
+				t.Fatalf("failed account invented %s=%v", key, row[key])
+			}
+		}
+		data, err := json.Marshal(row)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(data), `"total_pnl_pct":null`) || strings.Contains(string(data), "private upstream") {
+			t.Fatal("missing values or safe errors lost in JSON")
+		}
+	}
+	if timedout["data_status"] != "unavailable" || failed["data_status"] != "unavailable" {
+		t.Fatal("missing explicit failure status")
+	}
+	tm := NewTraderManager()
+	tm.competitionCache.data = map[string]interface{}{"traders": rows}
+	tm.competitionCache.timestamp = time.Now()
+	data, err := tm.GetCompetitionData()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data["traders"].([]map[string]interface{})) != 0 {
+		t.Fatal("deleted/hidden trader metadata leaked from cached rows")
+	}
+
+}
+func TestCompetitionRejectsIncompleteOrNonfiniteSnapshots(t *testing.T) {
+	for _, value := range []interface{}{nil, math.NaN(), math.Inf(1), "0"} {
+		row := competitionAccountData(map[string]interface{}{}, func() (map[string]interface{}, error) {
+			account, _ := competitionFixtureRead(5)()
+			account["total_equity"] = value
+			return account, nil
+		})
+		if competitionDataAvailable(row) || row["total_pnl_pct"] != nil {
+			t.Fatal("invalid equity created a valid ranking")
+		}
+	}
+}
+
+func TestCompetitionRefreshDeduplicatesPollsAndPublishesCompletedMeasurements(t *testing.T) {
+	cache := &CompetitionCache{}
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
+	started := make(chan struct{}, 3)
+	var counts [3]atomic.Int32
+	var failed atomic.Bool
+	sources := []competitionSource{}
+	for i := 0; i < 3; i++ {
+		sources = append(sources, competitionSource{metadata: map[string]interface{}{"trader_id": fmt.Sprint(i), "exchange": "okx"}, read: func() (map[string]interface{}, error) {
+			counts[i].Add(1)
+			if failed.Load() {
+				return nil, errors.New("account no longer available")
+			}
+			started <- struct{}{}
+			<-release
+			return competitionFixtureRead(float64(-i))()
+		}})
+	}
+	first := cache.getOrRefresh(sources, 5*time.Second, time.Millisecond)
+	for _, row := range first {
+		if competitionDataAvailable(row) || row["total_pnl_pct"] != nil {
+			t.Fatal("pending refresh used old or zero returns")
+		}
+	}
+	for i := 0; i < 3; i++ {
+		select {
+		case <-started:
+		case <-time.After(time.Second):
+			t.Fatal("refresh worker did not start")
+		}
+	}
+	var polls sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		polls.Add(1)
+		go func() { defer polls.Done(); cache.getOrRefresh(sources, 5*time.Second, time.Millisecond) }()
+	}
+	polls.Wait()
+	for i := range counts {
+		if counts[i].Load() != 1 {
+			t.Fatalf("polls queued duplicate reads for trader%d: %d", i, counts[i].Load())
+		}
+	}
+	releaseOnce.Do(func() { close(release) })
+	completed := cache.getOrRefresh(sources, 5*time.Second, time.Second)
+	for _, row := range completed {
+		if !competitionDataAvailable(row) {
+			t.Fatal("completed refresh did not deliver every measurement")
+		}
+		stamp, ok := row["measured_at"].(string)
+		if !ok {
+			t.Fatal("measurement timestamp absent")
+		}
+		if _, err := time.Parse(time.RFC3339Nano, stamp); err != nil {
+			t.Fatal(err)
+		}
+	}
+	failed.Store(true)
+	cache.mu.Lock()
+	cache.timestamp = time.Now().Add(-6 * time.Second)
+	cache.mu.Unlock()
+	replacement := cache.getOrRefresh(sources, 5*time.Second, time.Second)
+	for _, row := range replacement {
+		if competitionDataAvailable(row) || row["total_pnl_pct"] != nil {
+			t.Fatal("failed refresh fell back to previous measured success")
+		}
+	}
+	for i := range counts {
+		if counts[i].Load() != 2 {
+			t.Fatal("unexpected duplicate refresh")
+		}
+	}
+}
+
+func TestCompetitionOldFirstMeasurementCannotRankInFreshCompletedBatch(t *testing.T) {
+	now := time.Now().UTC()
+	sources := []competitionSource{
+		{metadata: map[string]interface{}{"trader_id": "first", "exchange": "okx"}},
+		{metadata: map[string]interface{}{"trader_id": "last", "exchange": "okx"}},
+	}
+	first := competitionAccountData(sources[0].metadata, competitionFixtureRead(90))
+	last := competitionAccountData(sources[1].metadata, competitionFixtureRead(-10))
+	first["measured_at"] = now.Add(-61 * time.Second).Format(time.RFC3339Nano)
+	last["measured_at"] = now.Format(time.RFC3339Nano)
+	// The batch just completed, but its first serialized spot read has expired.
+	cache := &CompetitionCache{data: map[string]interface{}{"traders": []map[string]interface{}{first, last}}, timestamp: now, sourceKey: "first\x00last"}
+	cached := cache.getOrRefresh(sources, 5*time.Second, time.Millisecond)
+	rows := competitionResponseRows(sources, cached, now)
+	sortCompetitionTraders(rows)
+	if rows[0]["trader_id"] != "last" || !competitionDataAvailable(rows[0]) {
+		t.Fatal("expired first measurement outranked fresh last measurement")
+	}
+	if competitionDataAvailable(rows[1]) || rows[1]["total_pnl_pct"] != nil || rows[1]["measured_at"] != nil {
+		t.Fatal("expired measurement was not replaced with unavailable null metrics")
+	}
+	if first["data_status"] != "available" {
+		t.Fatal("response mutated the shared cache")
+	}
+}
