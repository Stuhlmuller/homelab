+// Keep model decisions, including external debate decisions, behind the same
+// running-state, cash, ownership and candidate checks.
+func (at *AutoTrader) executeSpotDecisionWithRecord(spot *OKXSpotTrader, decision *kernel.Decision, record *store.DecisionAction) error {
+	if decision == nil || record == nil {
+		return errors.New("spot decision and record required")
+	}
+	if err := kernel.ValidateSpotDecision(*decision); err != nil {
+		return err
+	}
+	at.isRunningMutex.RLock()
+	defer at.isRunningMutex.RUnlock()
+	if !at.isRunning {
+		return errors.New("spot trader is stopped")
+	}
+	if at.strategyEngine == nil || at.strategyEngine.GetConfig() == nil {
+		return errors.New("saved spot strategy required")
+	}
+	config := at.strategyEngine.GetConfig()
+	if config.CoinSource.SourceType != "static" || len(config.CoinSource.StaticCoins) == 0 {
+		return errors.New("explicit static spot candidates required")
+	}
+	// Resolve through the authenticated catalog so aliases cannot bypass exclusions.
+	excluded := map[string]bool{}
+	for _, symbol := range config.CoinSource.ExcludedCoins {
+		inst, err := spot.instrument(symbol)
+		if err != nil {
+			return err
+		}
+		excluded[inst.InstID] = true
+	}
+	candidates := []string{}
+	for _, symbol := range config.CoinSource.StaticCoins {
+		inst, err := spot.instrument(symbol)
+		if err != nil {
+			return err
+		}
+		if !excluded[inst.InstID] {
+			candidates = append(candidates, inst.InstID)
+		}
+	}
+	result, err := spot.ExecuteSpotDecision(*decision, config.RiskControl, candidates)
+	if err != nil {
+		return err
+	}
+	record.Leverage = 1
+	if clientID, ok := result["clientOrderId"].(string); ok {
+		intents, err := spot.store.Spot().Intents(spot.userID, spot.exchangeID)
+		if err != nil {
+			return err
+		}
+		for _, intent := range intents {
+			if intent.ClientOrderID != clientID || intent.TraderID != spot.traderID {
+				continue
+			}
+			record.OrderID, _ = strconv.ParseInt(intent.ExchangeOrderID, 10, 64)
+			filled, err := decimal.NewFromString(intent.FinalFilledQuantity)
+			if err != nil {
+				return errors.New("spot order has no reconciled terminal fill quantity")
+			}
+			record.Quantity = filled.InexactFloat64()
+			return nil
+		}
+		return errors.New("spot decision is missing its owned order record")
+	}
+	return nil
+}
+
+// Called only by an active trader's cycle/monitor, never dashboard reads.
+func (at *AutoTrader) recoverSpotProtection(spot *OKXSpotTrader) error {
+	at.isRunningMutex.RLock()
+	defer at.isRunningMutex.RUnlock()
+	if !at.isRunning {
+		return nil
+	}
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	snapshot, err := spot.snapshot()
+	if err != nil {
+		return err
+	}
+	_, err = spot.recoverProtection(snapshot)
+	return err
+}
