@@ -0,0 +1,335 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"regexp"
+	"sort"
+	"sync"
+
+	"nofx/store"
+	"nofx/trader"
+
+	"github.com/gin-gonic/gin"
+	"github.com/shopspring/decimal"
+	"gorm.io/gorm"
+)
+
+// Shared with handlers that start/restart/delete traders. The deployment has
+// one backend process; configuration must not race a Start after its stop check.
+var spotConfigurationMu sync.Mutex
+
+type spotConfiguration struct {
+	Configured        bool                      `json:"configured"`
+	QuoteCurrency     string                    `json:"quote_currency"`
+	CapitalCap        string                    `json:"capital_cap"`
+	Allocations       map[string]string         `json:"allocations"`
+	EligibleQuotes    []string                  `json:"eligible_quote_currencies"`
+	Traders           []spotConfigurationTrader `json:"traders"`
+	AllStopped        bool                      `json:"all_stopped"`
+	Locked            bool                      `json:"locked"`
+	VerificationError string                    `json:"verification_error,omitempty"`
+}
+type spotConfigurationTrader struct {
+	ID      string `json:"id"`
+	Name    string `json:"name"`
+	Stopped bool   `json:"stopped"`
+}
+type spotConfigurationState struct {
+	response    spotConfiguration
+	policy      *store.SpotPolicy
+	exchangeIDs []string
+}
+
+var spotConfigurationAmount = regexp.MustCompile(`^(0|[1-9][0-9]*)(\.[0-9]{1,30})?$`)
+var spotConfigurationCurrency = regexp.MustCompile(`^[A-Z0-9]{1,20}$`)
+
+func spotConfigurationPositive(value string) (decimal.Decimal, error) {
+	if len(value) > 80 || !spotConfigurationAmount.MatchString(value) {
+		return decimal.Zero, errors.New("positive decimal string required")
+	}
+	d, err := decimal.NewFromString(value)
+	if err != nil || !d.IsPositive() {
+		return decimal.Zero, errors.New("positive decimal string required")
+	}
+	return d, nil
+}
+
+func (s *Server) spotExchange(c *gin.Context) (*store.Exchange, bool) {
+	userID := c.GetString("user_id")
+	if userID == "" {
+		c.JSON(http.StatusUnauthorized, gin.H{"error": "Authentication required"})
+		return nil, false
+	}
+	ex, err := s.store.Exchange().GetByID(userID, c.Param("id"))
+	if err != nil || ex.ExchangeType != "okx" {
+		c.JSON(http.StatusNotFound, gin.H{"error": "OKX connection not found"})
+		return nil, false
+	}
+	return ex, true
+}
+
+// Discover only aliases already bound to the server-verified physical account.
+// A newly selected alias is included but is not bound until an explicit PUT.
+func (s *Server) spotConfigurationState(userID, exchangeID, verifiedUID string) (*spotConfigurationState, error) {
+	state := &spotConfigurationState{response: spotConfiguration{Allocations: map[string]string{}, EligibleQuotes: []string{}, Traders: []spotConfigurationTrader{}, AllStopped: true}}
+	p, err := s.store.Spot().Policy(userID, exchangeID)
+	if err != nil && !errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, err
+	}
+	uid := verifiedUID
+	canonicalID := ""
+	if err == nil {
+		state.policy = p
+		uid = p.AccountUID
+		canonicalID = exchangeID
+	}
+	exchanges, err := s.store.Exchange().List(userID)
+	if err != nil {
+		return nil, err
+	}
+	aliases := map[string]bool{exchangeID: true}
+	// An unbound connection may name the same physical account. Until it is
+	// verified, any running trader on it must conservatively block changes.
+	unverified := map[string]bool{}
+	for _, ex := range exchanges {
+		if ex.ExchangeType != "okx" || ex.ID == exchangeID {
+			continue
+		}
+		alias, err := s.store.Spot().Policy(userID, ex.ID)
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			unverified[ex.ID] = true
+			continue
+		}
+		if err != nil {
+			return nil, err
+		}
+		if alias.AccountUID == uid {
+			aliases[ex.ID] = true
+			if state.policy == nil {
+				state.policy = alias
+				canonicalID = ex.ID
+			}
+		}
+	}
+	if state.policy != nil {
+		state.response.Configured = true
+		state.response.QuoteCurrency = state.policy.QuoteCurrency
+		state.response.CapitalCap = state.policy.CapitalCap
+		allocations, err := s.store.Spot().Allocations(userID, canonicalID)
+		if err != nil {
+			return nil, err
+		}
+		state.response.Allocations = allocations
+		intents, err := s.store.Spot().Intents(userID, canonicalID)
+		if err != nil {
+			return nil, err
+		}
+		state.response.Locked = len(intents) > 0
+	}
+	traders, err := s.store.Trader().List(userID)
+	if err != nil {
+		return nil, err
+	}
+	for _, t := range traders {
+		if aliases[t.ExchangeID] {
+			state.response.Traders = append(state.response.Traders, spotConfigurationTrader{t.ID, t.Name, !t.IsRunning})
+		}
+		if t.IsRunning && (aliases[t.ExchangeID] || unverified[t.ExchangeID]) {
+			state.response.AllStopped = false
+		}
+	}
+	if s.traderManager != nil {
+		for id, runtime := range s.traderManager.GetAllTraders() {
+			if !aliases[runtime.GetExchangeID()] && !unverified[runtime.GetExchangeID()] {
+				continue
+			}
+			if running, _ := runtime.GetStatus()["is_running"].(bool); running {
+				state.response.AllStopped = false
+				for i := range state.response.Traders {
+					if state.response.Traders[i].ID == id {
+						state.response.Traders[i].Stopped = false
+					}
+				}
+			}
+		}
+	}
+	for id := range aliases {
+		state.exchangeIDs = append(state.exchangeIDs, id)
+	}
+	sort.Strings(state.exchangeIDs)
+	sort.Slice(state.response.Traders, func(i, j int) bool { return state.response.Traders[i].Name < state.response.Traders[j].Name })
+	return state, nil
+}
+
+func spotConfigurationQuotes(instruments []trader.OKXSpotInstrument) []string {
+	seen := map[string]bool{}
+	for _, i := range instruments {
+		seen[i.QuoteCurrency] = true
+	}
+	quotes := make([]string, 0, len(seen))
+	for q := range seen {
+		quotes = append(quotes, q)
+	}
+	sort.Strings(quotes)
+	return quotes
+}
+
+func (s *Server) handleGetSpotConfiguration(c *gin.Context) {
+	spotConfigurationMu.Lock()
+	defer spotConfigurationMu.Unlock()
+	ex, ok := s.spotExchange(c)
+	if !ok {
+		return
+	}
+	client := trader.NewOKXSpotClient(string(ex.APIKey), string(ex.SecretKey), string(ex.Passphrase))
+	account, accountErr := client.Account()
+	state, err := s.spotConfigurationState(c.GetString("user_id"), ex.ID, account.UID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "Unable to load spot configuration"})
+		return
+	}
+	if accountErr != nil {
+		state.response.VerificationError = "Unable to verify the OKX account. Check the saved connection before configuring spot allocations."
+	} else if state.policy != nil && state.policy.AccountUID != account.UID {
+		state.response.VerificationError = "The OKX connection no longer matches its saved spot account."
+	} else if instruments, err := client.Instruments(); err != nil {
+		state.response.VerificationError = "Unable to verify eligible OKX spot instruments. Try again before saving."
+	} else {
+		state.response.EligibleQuotes = spotConfigurationQuotes(instruments)
+	}
+	c.JSON(http.StatusOK, state.response)
+}
+
+func (s *Server) handlePutSpotConfiguration(c *gin.Context) {
+	var request struct {
+		QuoteCurrency string            `json:"quote_currency"`
+		CapitalCap    string            `json:"capital_cap"`
+		Allocations   map[string]string `json:"allocations"`
+	}
+	decoder := json.NewDecoder(io.LimitReader(c.Request.Body, 64<<10))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&request) != nil || decoder.Decode(&struct{}{}) != io.EOF {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Provide a quote currency, capital cap, and trader allocations as decimal strings"})
+		return
+	}
+	cap, err := spotConfigurationPositive(request.CapitalCap)
+	if err != nil || !spotConfigurationCurrency.MatchString(request.QuoteCurrency) || len(request.Allocations) == 0 {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Enter a positive capital cap and at least one positive trader allocation"})
+		return
+	}
+	total := decimal.Zero
+	for id, amount := range request.Allocations {
+		d, err := spotConfigurationPositive(amount)
+		if err != nil || id == "" {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "Every selected trader needs a positive decimal allocation"})
+			return
+		}
+		request.Allocations[id] = d.String()
+		total = total.Add(d)
+	}
+	if total.GreaterThan(cap) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Trader allocations exceed the shared account capital cap"})
+		return
+	}
+	spotConfigurationMu.Lock()
+	defer spotConfigurationMu.Unlock()
+	ex, ok := s.spotExchange(c)
+	if !ok {
+		return
+	}
+	client := trader.NewOKXSpotClient(string(ex.APIKey), string(ex.SecretKey), string(ex.Passphrase))
+	account, err := client.Account()
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Unable to verify the saved OKX account"})
+		return
+	}
+	if (account.AccountLevel != "1" && account.AccountLevel != "2") || account.AutoLoan == nil || account.EnableSpotBorrow == nil || *account.AutoLoan || *account.EnableSpotBorrow {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Cash spot requires spot or futures account mode with both automatic borrowing options explicitly disabled"})
+		return
+	}
+	state, err := s.spotConfigurationState(c.GetString("user_id"), ex.ID, account.UID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "Unable to load spot configuration"})
+		return
+	}
+	if !state.response.AllStopped {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Stop every trader using this account or an unverified OKX connection before changing allocations"})
+		return
+	}
+	if state.policy != nil && state.policy.AccountUID != account.UID {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "The OKX connection no longer matches its saved spot account"})
+		return
+	}
+	eligible := map[string]bool{}
+	for _, t := range state.response.Traders {
+		eligible[t.ID] = t.Stopped
+	}
+	for id := range request.Allocations {
+		if !eligible[id] {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "Allocations must belong to stopped traders using this OKX account"})
+			return
+		}
+	}
+	if state.response.Locked {
+		unchanged := state.response.QuoteCurrency == request.QuoteCurrency && state.response.CapitalCap == cap.String() && len(state.response.Allocations) == len(request.Allocations)
+		for id, amount := range state.response.Allocations {
+			if request.Allocations[id] != amount {
+				unchanged = false
+			}
+		}
+		if !unchanged {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "Capital and allocations cannot be reset after trading intents exist"})
+			return
+		}
+	}
+	instruments, err := client.Instruments()
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Unable to verify eligible OKX spot instruments"})
+		return
+	}
+	quotes := spotConfigurationQuotes(instruments)
+	quoteOK := false
+	for _, q := range quotes {
+		if q == request.QuoteCurrency {
+			quoteOK = true
+		}
+	}
+	if !quoteOK {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Choose a quote currency available for cash spot on this OKX account"})
+		return
+	}
+	wallet, err := client.Wallet()
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Unable to verify available OKX cash"})
+		return
+	}
+	available := decimal.Zero
+	for _, b := range wallet {
+		if b.Liability.IsPositive() || b.Cash.IsNegative() || b.Available.IsNegative() {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "Resolve OKX borrowing or negative cash balances before configuring cash spot"})
+			return
+		}
+		if b.Currency == request.QuoteCurrency {
+			available = b.Available
+		}
+	}
+	if !state.response.Locked && total.GreaterThan(available) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Available OKX cash does not cover the requested trader allocations"})
+		return
+	}
+	policy := store.SpotPolicy{AccountUID: account.UID, UserID: c.GetString("user_id"), QuoteCurrency: request.QuoteCurrency, CapitalCap: cap.String()}
+	if err := s.store.Spot().Configure(policy, state.exchangeIDs, request.Allocations); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Spot configuration could not be saved. Account bindings and allocations must remain consistent"})
+		return
+	}
+	state, err = s.spotConfigurationState(policy.UserID, ex.ID, account.UID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "Spot configuration was saved but could not be reloaded"})
+		return
+	}
+	state.response.EligibleQuotes = quotes
+	c.JSON(http.StatusOK, state.response)
+}
