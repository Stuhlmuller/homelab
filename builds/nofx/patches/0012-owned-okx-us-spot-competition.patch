--- /dev/null
+++ b/web/src/components/SpotCompetitionModal.tsx
@@ -0,0 +1,304 @@
+import { useEffect, useState } from 'react'
+import { httpClient } from '../lib/httpClient'
+import type { Language } from '../i18n/translations'
+
+export interface SpotCompetitionConfiguration {
+  configured: boolean
+  quote_currency: string
+  capital_cap: string
+  allocations: Record<string, string>
+  eligible_quote_currencies: string[]
+  traders: { id: string; name: string; stopped: boolean }[]
+  all_stopped: boolean
+  locked: boolean
+  verification_error?: string
+}
+
+const positiveAmount = (value: string) =>
+  value.length <= 80 &&
+  /^(0|[1-9][0-9]*)(\.[0-9]{1,30})?$/.test(value) &&
+  /[1-9]/.test(value)
+
+export function SpotCompetitionModal({
+  exchangeId,
+  accountName,
+  language,
+  onClose,
+}: {
+  exchangeId: string
+  accountName: string
+  language: Language
+  onClose: () => void
+}) {
+  const [configuration, setConfiguration] =
+    useState<SpotCompetitionConfiguration | null>(null)
+  const [quote, setQuote] = useState('')
+  const [cap, setCap] = useState('')
+  const [allocations, setAllocations] = useState<Record<string, string>>({})
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState('')
+  const [saved, setSaved] = useState(false)
+  const zh = language === 'zh'
+  const path = `/api/exchanges/${encodeURIComponent(exchangeId)}/spot`
+
+  const populate = (data: SpotCompetitionConfiguration) => {
+    setConfiguration(data)
+    setQuote(data.quote_currency)
+    setCap(data.capital_cap)
+    setAllocations(data.allocations)
+  }
+
+  useEffect(() => {
+    let active = true
+    setConfiguration(null)
+    setError('')
+    setSaved(false)
+    httpClient
+      .get<SpotCompetitionConfiguration>(path)
+      .then((result) => {
+        if (!active) return
+        if (!result.success || !result.data) {
+          setError(result.message || 'Unable to load spot configuration')
+          return
+        }
+        populate(result.data)
+      })
+      .catch(() => {
+        if (active) setError('Unable to load spot configuration')
+      })
+    return () => {
+      active = false
+    }
+  }, [path])
+
+  useEffect(() => {
+    const escape = (event: KeyboardEvent) => {
+      if (event.key === 'Escape' && !saving) onClose()
+    }
+    document.addEventListener('keydown', escape)
+    return () => document.removeEventListener('keydown', escape)
+  }, [onClose, saving])
+
+  const save = async (event: React.FormEvent) => {
+    event.preventDefault()
+    if (
+      !configuration ||
+      !configuration.all_stopped ||
+      configuration.locked ||
+      configuration.verification_error ||
+      saving
+    )
+      return
+    const selected = Object.fromEntries(
+      Object.entries(allocations).filter(([, amount]) => amount !== '')
+    )
+    if (
+      !quote ||
+      !positiveAmount(cap) ||
+      Object.keys(selected).length === 0 ||
+      Object.values(selected).some((amount) => !positiveAmount(amount))
+    ) {
+      setError(
+        zh
+          ? '请选择币种，并输入正数资金上限和交易员分配金额。'
+          : 'Choose a currency and enter a positive capital cap and at least one positive allocation.'
+      )
+      return
+    }
+    setSaving(true)
+    setError('')
+    setSaved(false)
+    try {
+      const result = await httpClient.put<SpotCompetitionConfiguration>(path, {
+        quote_currency: quote,
+        capital_cap: cap,
+        allocations: selected,
+      })
+      if (!result.success || !result.data) {
+        setError(result.message || 'Unable to save spot configuration')
+        return
+      }
+      populate(result.data)
+      setSaved(true)
+    } catch {
+      setError('Unable to save spot configuration')
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  const disabled =
+    saving ||
+    !configuration?.all_stopped ||
+    !!configuration?.locked ||
+    !!configuration?.verification_error
+  const quotes = configuration?.eligible_quote_currencies || []
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4">
+      <section
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="spot-competition-title"
+        className="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-lg border border-[#2B3139] bg-[#181A20] p-6 text-[#EAECEF]"
+      >
+        <div className="mb-4 flex items-center justify-between gap-4">
+          <h2 id="spot-competition-title" className="text-lg font-semibold">
+            {zh ? '现货竞赛资金配置' : 'Spot competition allocations'}
+          </h2>
+          <button
+            type="button"
+            onClick={onClose}
+            disabled={saving}
+            aria-label={zh ? '关闭现货配置' : 'Close spot configuration'}
+            className="rounded px-2 py-1 hover:bg-gray-700 disabled:opacity-50"
+          >
+            ×
+          </button>
+        </div>
+        <p className="mb-2 text-sm">{accountName}</p>
+        <p className="mb-3 text-sm text-[#B7BDC6]">
+          {zh
+            ? '共用一个 OKX 账户，为选中的交易员单独分配资金。保存配置不会启动交易员或转移资金。'
+            : 'One shared OKX account, with a separate allocation for each selected agent. Saving does not start traders or transfer funds.'}
+        </p>
+        <p className="mb-4 text-xs text-[#B7BDC6]">
+          {zh
+            ? '仅限现金现货，不做空、不加杠杆。IOC 限价订单可能无法成交；价格跳空时，止损限价订单也可能无法成交。'
+            : 'Cash spot only: no shorting or leverage. IOC limit orders may not fill. Stop-limit protection can remain unfilled after a price gap.'}
+        </p>
+        {error && (
+          <p role="alert" className="mb-4 text-sm text-red-400">
+            {error}
+          </p>
+        )}
+        {!configuration && !error && (
+          <p role="status">{zh ? '正在加载配置…' : 'Loading configuration…'}</p>
+        )}
+        {configuration && (
+          <form onSubmit={save}>
+            {configuration.verification_error && (
+              <p role="alert" className="mb-4 text-sm text-amber-300">
+                {configuration.verification_error}
+              </p>
+            )}
+            {!configuration.all_stopped && (
+              <p role="alert" className="mb-4 text-sm text-amber-300">
+                {zh
+                  ? '请先停止使用此账户或尚未验证的 OKX 连接的所有交易员。'
+                  : 'Stop every trader using this account or an unverified OKX connection before changing allocations.'}
+              </p>
+            )}
+            {configuration.locked && (
+              <p className="mb-4 text-sm text-amber-300">
+                {zh
+                  ? '已有交易意图记录，资金上限和分配不可重置。'
+                  : 'Trading intents exist. Capital and allocations cannot be reset.'}
+              </p>
+            )}
+            <fieldset
+              disabled={disabled}
+              className="space-y-4 disabled:opacity-70"
+            >
+              <label className="block text-sm">
+                {zh ? '计价币种' : 'Quote currency'}
+                <select
+                  value={quote}
+                  onChange={(event) => setQuote(event.target.value)}
+                  disabled={configuration.configured || disabled}
+                  className="mt-1 block w-full rounded border border-[#474D57] bg-[#0B0E11] p-2"
+                >
+                  <option value="">
+                    {zh
+                      ? '选择账户支持的现货币种'
+                      : 'Choose an eligible spot currency'}
+                  </option>
+                  {quote && !quotes.includes(quote) && (
+                    <option value={quote}>{quote}</option>
+                  )}
+                  {quotes.map((currency) => (
+                    <option key={currency} value={currency}>
+                      {currency}
+                    </option>
+                  ))}
+                </select>
+              </label>
+              <label className="block text-sm">
+                {zh ? '共享账户资金上限' : 'Shared account capital cap'}
+                {quote ? ` (${quote})` : ''}
+                <input
+                  type="text"
+                  inputMode="decimal"
+                  value={cap}
+                  onChange={(event) => setCap(event.target.value)}
+                  autoComplete="off"
+                  className="mt-1 block w-full rounded border border-[#474D57] bg-[#0B0E11] p-2"
+                />
+              </label>
+              <p className="text-xs text-[#B7BDC6]">
+                {zh
+                  ? '分配总额不可超过资金上限。未参加竞赛的交易员请留空。'
+                  : 'Total allocations must fit within the cap. Leave traders outside this competition blank.'}
+              </p>
+              {configuration.traders.map((agent) => (
+                <label key={agent.id} className="block text-sm">
+                  {agent.name} {zh ? '分配金额' : 'allocation'}
+                  {quote ? ` (${quote})` : ''}
+                  <span className="ml-2 text-xs text-[#B7BDC6]">
+                    {agent.stopped
+                      ? zh
+                        ? '已停止'
+                        : 'STOPPED'
+                      : zh
+                        ? '运行中'
+                        : 'RUNNING'}
+                  </span>
+                  <input
+                    type="text"
+                    inputMode="decimal"
+                    value={allocations[agent.id] || ''}
+                    onChange={(event) =>
+                      setAllocations((current) => ({
+                        ...current,
+                        [agent.id]: event.target.value,
+                      }))
+                    }
+                    autoComplete="off"
+                    className="mt-1 block w-full rounded border border-[#474D57] bg-[#0B0E11] p-2"
+                  />
+                </label>
+              ))}
+              {configuration.traders.length === 0 && (
+                <p className="text-sm">
+                  {zh
+                    ? '请先为此连接创建已停止的交易员。'
+                    : 'Create stopped traders using this connection first.'}
+                </p>
+              )}
+              <button
+                type="submit"
+                disabled={disabled || configuration.traders.length === 0}
+                className="w-full rounded bg-[#F0B90B] px-4 py-2 font-medium text-black disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                {saving
+                  ? zh
+                    ? '正在保存…'
+                    : 'Saving…'
+                  : zh
+                    ? '保存配置'
+                    : 'Save configuration'}
+              </button>
+            </fieldset>
+            {saved && (
+              <p role="status" className="mt-4 text-sm text-green-400">
+                {zh
+                  ? '配置已保存。交易员仍处于停止状态。'
+                  : 'Configuration saved. Traders remain stopped.'}
+              </p>
+            )}
+          </form>
+        )}
+      </section>
+    </div>
+  )
+}
