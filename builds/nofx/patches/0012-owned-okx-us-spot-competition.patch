+  it('removes ranks and stale leader presentation when competition refresh fails', () => {
+    show([measured('Old winner', 25)], new Error('offline'))
+    expect(screen.getByLabelText('Old winner: Unavailable')).toBeInTheDocument()
+    expect(screen.queryByLabelText(/Rank/)).not.toBeInTheDocument()
+    expect(screen.queryByText('+25.00%')).not.toBeInTheDocument()
+    expect(screen.queryByTestId('chart')).not.toBeInTheDocument()
+  })
+
+  it('retains measured zero and valid non-OKX history', () => {
+    show([
+      { ...measured('Flat', 0), exchange: 'binance', history_available: true },
+    ])
+    expect(screen.getByLabelText('Flat: Rank 1')).toBeInTheDocument()
+    expect(screen.getAllByText('+0.00%').length).toBeGreaterThan(0)
+    expect(screen.getByTestId('chart')).toHaveTextContent('Flat')
+    expect(screen.getByTitle('2026-09-26T12:00:00Z')).toHaveTextContent('As of')
+  })
+})
