@@ -0,0 +1,41 @@
+import type { CompetitionTraderData } from '../types'
+
+type MeasuredTrader = CompetitionTraderData & {
+  total_equity: number
+  total_pnl: number
+  total_pnl_pct: number
+}
+
+export function competitionDataAvailable(
+  trader: CompetitionTraderData
+): trader is MeasuredTrader {
+  return (
+    trader.data_status === 'available' &&
+    [trader.total_equity, trader.total_pnl, trader.total_pnl_pct].every(
+      (value) => typeof value === 'number' && Number.isFinite(value)
+    )
+  )
+}
+
+export function sortCompetitionTraders(
+  traders: CompetitionTraderData[]
+): CompetitionTraderData[] {
+  return [...traders].sort((a, b) => {
+    const left = competitionDataAvailable(a)
+    const right = competitionDataAvailable(b)
+    if (left !== right) return left ? -1 : 1
+    if (left && right && a.total_pnl_pct !== b.total_pnl_pct)
+      return b.total_pnl_pct - a.total_pnl_pct
+    return a.trader_id.localeCompare(b.trader_id)
+  })
+}
+
+export function competitionMetric(
+  value: number | null | undefined,
+  suffix = '',
+  signed = false
+): string {
+  return typeof value === 'number' && Number.isFinite(value)
+    ? `${signed && value >= 0 ? '+' : ''}${value.toFixed(2)}${suffix}`
+    : '—'
+}
