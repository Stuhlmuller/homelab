+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"nofx/store"
+)
+
+type spotConfigurationFixture struct {
+	server                    *Server
+	exchangeID                string
+	account, balance, catalog string
+	requests                  int
+}
+
+func newSpotConfigurationFixture(t *testing.T) *spotConfigurationFixture {
+	t.Helper()
+	st := configurationTestStore(t)
+	if err := st.User().Create(&store.User{ID: "safety-test", Email: "spot@example.invalid", PasswordHash: "fixture"}); err != nil {
+		t.Fatal(err)
+	}
+	id, err := st.Exchange().Create("safety-test", "okx", "fixture", true, "fixture-key", "fixture-secret", "fixture-pass", false, "", "", "", "", "", "", "", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"Trend", "Mean", "Breakout", "Consensus"} {
+		if err := st.Trader().Create(&store.Trader{ID: name, UserID: "safety-test", Name: name, ExchangeID: id, AIModelID: "openrouter/free", InitialBalance: 1000}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f := &spotConfigurationFixture{server: &Server{store: st}, exchangeID: id,
+		account: `{"code":"0","data":[{"uid":"123","acctLv":"1","autoLoan":false,"enableSpotBorrow":false}]}`,
+		balance: `{"code":"0","data":[{"details":[{"ccy":"USDT","cashBal":"100","availBal":"100","frozenBal":"0","liab":"0"}]}]}`,
+		catalog: `{"code":"0","data":[{"instType":"SPOT","instId":"BTC-USDT","baseCcy":"BTC","quoteCcy":"USDT","state":"live","lotSz":"0.001","minSz":"0.01","tickSz":"0.1","maxLmtSz":"5","groupId":"12"}]}`,
+	}
+	previous := http.DefaultTransport
+	http.DefaultTransport = startErrorTransport(func(r *http.Request) (*http.Response, error) {
+		f.requests++
+		if r.Method != http.MethodGet || r.URL.Host != "us.okx.com" {
+			t.Fatalf("configuration made unexpected request: %s %s", r.Method, r.URL.Host)
+		}
+		var body string
+		switch r.URL.Path {
+		case "/api/v5/account/config":
+			body = f.account
+		case "/api/v5/account/balance":
+			body = f.balance
+		case "/api/v5/account/instruments":
+			if r.URL.Query().Get("instType") != "SPOT" {
+				t.Fatal("configuration used non-spot catalog")
+			}
+			body = f.catalog
+		default:
+			t.Fatalf("configuration used unexpected endpoint: %s", r.URL.Path)
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: r}, nil
+	})
+	t.Cleanup(func() { http.DefaultTransport = previous })
+	return f
+}
+
+func (f *spotConfigurationFixture) request(t *testing.T, method, user, id, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	c.Set("user_id", user)
+	c.Params = gin.Params{{Key: "id", Value: id}}
+	c.Request = httptest.NewRequest(method, "/api/exchanges/"+id+"/spot", strings.NewReader(body))
+	if method == http.MethodGet {
+		f.server.handleGetSpotConfiguration(c)
+	} else {
+		f.server.handlePutSpotConfiguration(c)
+	}
+	for _, private := range []string{"account_uid", `"123"`, "fixture-key", "fixture-secret", "fixture-pass"} {
+		if strings.Contains(w.Body.String(), private) {
+			t.Fatal("configuration response exposed private account data")
+		}
+	}
+	return w
+}
+func spotConfigurationBody() string {
+	return `{"quote_currency":"USDT","capital_cap":"90.000","allocations":{"Trend":"30","Mean":"30","Breakout":"30"}}`
+}
+func decodeSpotConfiguration(t *testing.T, w *httptest.ResponseRecorder) spotConfiguration {
+	t.Helper()
+	if w.Code != 200 {
+		t.Fatalf("HTTP %d: %s", w.Code, w.Body.String())
+	}
+	var d spotConfiguration
+	if err := json.Unmarshal(w.Body.Bytes(), &d); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+func TestSpotConfigurationExplicitPassiveAndPreservesSavedSettings(t *testing.T) {
+	f := newSpotConfigurationFixture(t)
+	d := decodeSpotConfiguration(t, f.request(t, "GET", "safety-test", f.exchangeID, ""))
+	if d.Configured || d.CapitalCap != "" || len(d.Allocations) != 0 || len(d.Traders) != 4 || !d.AllStopped || len(d.EligibleQuotes) != 1 {
+		t.Fatalf("unexpected unconfigured form: %+v", d)
+	}
+	d = decodeSpotConfiguration(t, f.request(t, "PUT", "safety-test", f.exchangeID, spotConfigurationBody()))
+	if !d.Configured || d.CapitalCap != "90" || len(d.Allocations) != 3 || d.Allocations["Trend"] != "30" || d.Allocations["Consensus"] != "" || d.Locked {
+		t.Fatalf("wrong explicit policy: %+v", d)
+	}
+	all, err := f.server.store.Trader().List("safety-test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, agent := range all {
+		if agent.IsRunning || agent.AIModelID != "openrouter/free" || agent.InitialBalance != 1000 {
+			t.Fatal("configuration changed trader lifecycle/model/baseline")
+		}
+	}
+	// Saved allocations do not depend on live credentials or a snapshot for the
+	// fourth, deliberately unallocated trader.
+	f.account = `{"code":"50119","msg":"sensitive upstream error fixture-key","data":[]}`
+	d = decodeSpotConfiguration(t, f.request(t, "GET", "safety-test", f.exchangeID, ""))
+	if d.CapitalCap != "90" || d.Allocations["Mean"] != "30" || len(d.Traders) != 4 || d.VerificationError == "" {
+		t.Fatalf("saved form lost on verification failure: %+v", d)
+	}
+}
+
+func TestSpotConfigurationRejectsUnsafeOrImplicitCapital(t *testing.T) {
+	cases := []struct {
+		name   string
+		body   string
+		mutate func(*spotConfigurationFixture)
+	}{
+		{"blank cap", `{"quote_currency":"USDT","capital_cap":"","allocations":{"Trend":"1"}}`, nil},
+		{"numeric cap", `{"quote_currency":"USDT","capital_cap":10,"allocations":{"Trend":"1"}}`, nil},
+		{"exponent", `{"quote_currency":"USDT","capital_cap":"1e2","allocations":{"Trend":"1"}}`, nil},
+		{"zero", `{"quote_currency":"USDT","capital_cap":"10","allocations":{"Trend":"0"}}`, nil},
+		{"negative", `{"quote_currency":"USDT","capital_cap":"10","allocations":{"Trend":"-1"}}`, nil},
+		{"over cap", `{"quote_currency":"USDT","capital_cap":"10","allocations":{"Trend":"11"}}`, nil},
+		{"no allocations", `{"quote_currency":"USDT","capital_cap":"10","allocations":{}}`, nil},
+		{"unowned trader", `{"quote_currency":"USDT","capital_cap":"10","allocations":{"other-user-trader":"1"}}`, nil},
+		{"unavailable quote", `{"quote_currency":"USD","capital_cap":"10","allocations":{"Trend":"1"}}`, nil},
+		{"client uid", `{"quote_currency":"USDT","capital_cap":"10","allocations":{"Trend":"1"},"account_uid":"attacker"}`, nil},
+		{"running", "", func(f *spotConfigurationFixture) {
+			if err := f.server.store.Trader().UpdateStatus("safety-test", "Consensus", true); err != nil {
+				t.Fatal(err)
+			}
+		}},
+		{"margin account", "", func(f *spotConfigurationFixture) {
+			f.account = strings.Replace(f.account, `"acctLv":"1"`, `"acctLv":"3"`, 1)
+		}},
+		{"auto borrowing", "", func(f *spotConfigurationFixture) {
+			f.account = strings.Replace(f.account, `"autoLoan":false`, `"autoLoan":true`, 1)
+		}},
+		{"spot borrowing", "", func(f *spotConfigurationFixture) {
+			f.account = strings.Replace(f.account, `"enableSpotBorrow":false`, `"enableSpotBorrow":true`, 1)
+		}},
+		{"unknown borrowing", "", func(f *spotConfigurationFixture) { f.account = strings.Replace(f.account, `,"autoLoan":false`, "", 1) }},
+		{"liabilities", "", func(f *spotConfigurationFixture) {
+			f.balance = strings.Replace(f.balance, `"liab":"0"`, `"liab":"1"`, 1)
+		}},
+		{"insufficient cash", "", func(f *spotConfigurationFixture) {
+			f.balance = strings.Replace(f.balance, `"availBal":"100"`, `"availBal":"1"`, 1)
+		}},
+		{"account failed", "", func(f *spotConfigurationFixture) { f.account = `{"code":"50119","data":[]}` }},
+		{"catalog failed", "", func(f *spotConfigurationFixture) { f.catalog = `{"code":"1","data":[]}` }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newSpotConfigurationFixture(t)
+			if tc.mutate != nil {
+				tc.mutate(f)
+			}
+			body := tc.body
+			if body == "" {
+				body = spotConfigurationBody()
+			}
+			w := f.request(t, "PUT", "safety-test", f.exchangeID, body)
+			if w.Code != 400 {
+				t.Fatalf("want400 got%d %s", w.Code, w.Body.String())
+			}
+			if _, err := f.server.store.Spot().Policy("safety-test", f.exchangeID); err == nil {
+				t.Fatal("rejected configuration created policy")
+			}
+		})
+	}
+}
+
+func TestSpotConfigurationOwnershipAndCanonicalAliases(t *testing.T) {
+	f := newSpotConfigurationFixture(t)
+	for _, method := range []string{"GET", "PUT"} {
+		w := f.request(t, method, "other-user", f.exchangeID, spotConfigurationBody())
+		if w.Code != 404 || f.requests != 0 {
+			t.Fatal("foreign exchange was read or configured")
