diff --git a/kernel/spot.go b/kernel/spot.go
new file mode 100644
index 0000000..e14714e
--- /dev/null
+++ b/kernel/spot.go
@@ -0,0 +1,115 @@
+package kernel
+
+import (
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+)
+
+// ValidateSpotDecision checks intent without changing it. Execution must also
+// check current prices, available cash, owned quantity, and exchange filters.
+func ValidateSpotDecision(d Decision) error {
+	if strings.TrimSpace(d.Symbol) == "" || d.Symbol == "ALL" {
+		return fmt.Errorf("cash spot requires a configured symbol")
+	}
+	switch d.Action {
+	case "open_long", "close_long", "hold", "wait":
+	default:
+		return fmt.Errorf("unsupported cash spot action %q", d.Action)
+	}
+	if d.Leverage < 0 || d.Leverage > 1 || (d.Action == "open_long" && d.Leverage != 1) {
+		return fmt.Errorf("cash spot buys require leverage 1; other actions allow only 0 or 1")
+	}
+	for _, value := range []float64{d.PositionSizeUSD, d.StopLoss, d.TakeProfit, d.RiskUSD} {
+		if math.IsNaN(value) || math.IsInf(value, 0) || value < 0 {
+			return fmt.Errorf("cash spot amounts and prices must be finite and nonnegative")
+		}
+	}
+	if d.Action == "open_long" && (d.PositionSizeUSD <= 0 || d.StopLoss <= 0 || d.TakeProfit <= 0) {
+		return fmt.Errorf("cash spot buys require positive size, stop loss, and take profit")
+	}
+	if d.Confidence < 0 || d.Confidence > 100 {
+		return fmt.Errorf("cash spot confidence must be between 0 and 100")
+	}
+	return nil
+}
+
+func validateSpotContext(ctx *Context) error {
+	if strings.TrimSpace(ctx.QuoteCurrency) == "" {
+		return fmt.Errorf("cash spot quote currency is required")
+	}
+	if len(ctx.MarketDataMap) == 0 {
+		return fmt.Errorf("cash spot market snapshot is required; futures fallback is disabled")
+	}
+	for symbol, data := range ctx.MarketDataMap {
+		if data == nil || data.CurrentPrice <= 0 || math.IsNaN(data.CurrentPrice) || math.IsInf(data.CurrentPrice, 0) {
+			return fmt.Errorf("cash spot market snapshot has no valid price for %s", symbol)
+		}
+	}
+	for _, coin := range ctx.CandidateCoins {
+		if _, ok := ctx.MarketDataMap[coin.Symbol]; !ok {
+			return fmt.Errorf("cash spot market snapshot is missing candidate %s", coin.Symbol)
+		}
+	}
+	for _, pos := range ctx.Positions {
+		if _, ok := ctx.MarketDataMap[pos.Symbol]; !ok {
+			return fmt.Errorf("cash spot market snapshot is missing holding %s", pos.Symbol)
+		}
+	}
+	return nil
+}
+
+// BuildSystemPromptForContext retains legacy prompts unless cash spot is explicit.
+func (e *StrategyEngine) BuildSystemPromptForContext(ctx *Context, variant string) string {
+	if !ctx.CashSpot {
+		return e.BuildSystemPrompt(ctx.Account.TotalEquity, variant)
+	}
+	var sb strings.Builder
+	p := e.config.PromptSections
+	for _, section := range []string{p.RoleDefinition, p.TradingFrequency, p.EntryStandards, p.DecisionProcess, e.config.CustomPrompt} {
+		if section != "" {
+			sb.WriteString(section + "\n\n")
+		}
+	}
+	fmt.Fprintf(&sb, "# Cash spot rules (override conflicting persona text)\nMode: %s\n", variant)
+	fmt.Fprintf(&sb, "All cash, holdings, and equity belong to this agent only. Quote currency: %s. Equity is owned cash plus the current value of owned assets. Available cash excludes reserved funds.\n", ctx.QuoteCurrency)
+	sb.WriteString("Use only the supplied spot snapshot and configured symbols. Buy fully paid assets with open_long, sell owned assets with close_long, or hold/wait. Never borrow, open short positions, or use derivatives. Leverage is a compatibility field: exactly 1 for buys, 0 or 1 otherwise.\n")
+	fmt.Fprintf(&sb, "position_size_usd and risk_usd are named for compatibility but are amounts in %s. Buy size plus fees must fit available agent cash. Sell only this agent's owned quantity. Holdings are assets, not collateral.\n", ctx.QuoteCurrency)
+	fmt.Fprintf(&sb, "Strategy targets: maximum %d holdings; minimum confidence %d; minimum buy amount %.2f %s; reward/risk at least %.2f. Execution validates actual cash, ownership, prices, and exchange limits.\n", e.config.RiskControl.MaxPositions, e.config.RiskControl.MinConfidence, e.config.RiskControl.MinPositionSize, ctx.QuoteCurrency, e.config.RiskControl.MinRiskRewardRatio)
+	sb.WriteString("For every buy supply positive position_size_usd, stop_loss, and take_profit; stop_loss must be below the spot price and take_profit above it. These prices express intent, not a guarantee of execution.\n")
+	sb.WriteString("Return a non-empty JSON decision array inside <decision> tags. Fields: symbol, action, leverage, position_size_usd, stop_loss, take_profit, confidence (0-100), risk_usd, reasoning (brief explanation). Actions: open_long | close_long | hold | wait. Use explicit wait for a configured symbol when there is no trade. Numerical fields must contain finite nonnegative numbers.\n")
+	return sb.String()
+}
+
+func (e *StrategyEngine) buildSpotUserPrompt(ctx *Context) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "Time: %s | Period: #%d | Runtime: %d minutes\nAgent-owned account: Equity %.2f %s | Available cash %.2f %s\n\n", ctx.CurrentTime, ctx.CallCount, ctx.RuntimeMinutes, ctx.Account.TotalEquity, ctx.QuoteCurrency, ctx.Account.AvailableBalance, ctx.QuoteCurrency)
+	sb.WriteString("## Agent-owned spot holdings\n")
+	if len(ctx.Positions) == 0 {
+		sb.WriteString("None\n")
+	}
+	for _, pos := range ctx.Positions {
+		fmt.Fprintf(&sb, "%s | Owned quantity %.8f | Entry price %.8f | Spot price %.8f | Value %.2f %s | Unrealized PnL %+.2f %s\n", pos.Symbol, pos.Quantity, pos.EntryPrice, pos.MarkPrice, pos.Quantity*pos.MarkPrice, ctx.QuoteCurrency, pos.UnrealizedPnL, ctx.QuoteCurrency)
+	}
+	sb.WriteString("\n## Supplied spot market data\n")
+	// Reuse indicator formatting without mutating the saved strategy or displaying
+	// futures feeds that may have been supplied by a legacy caller.
+	config := *e.config
+	config.Indicators.EnableOI = false
+	config.Indicators.EnableFundingRate = false
+	spotEngine := *e
+	spotEngine.config = &config
+	symbols := make([]string, 0, len(ctx.MarketDataMap))
+	for symbol := range ctx.MarketDataMap {
+		symbols = append(symbols, symbol)
+	}
+	sort.Strings(symbols)
+	for _, symbol := range symbols {
+		if data := ctx.MarketDataMap[symbol]; data != nil {
+			sb.WriteString(spotEngine.formatMarketData(data))
+		}
+	}
+	sb.WriteString("Return your spot decisions with a brief reason for each.\n")
+	return sb.String()
+}
