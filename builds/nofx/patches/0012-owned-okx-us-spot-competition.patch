+package trader
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"net/http"
+	"path/filepath"
+	"strconv"
+	"testing"
+	"time"
+
+	"nofx/kernel"
+	"nofx/store"
+
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	"gorm.io/gorm/logger"
+)
+
+func spotContextFixture(t *testing.T, quote string) (*AutoTrader, *OKXSpotTrader, *string) {
+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "context.db")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlDB.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	st, err := store.NewFromGorm(db)
+	if err != nil {
+		t.Fatal(err)
+	}
+	must := func(err error) {
+		t.Helper()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, query := range []string{
+		`CREATE TABLE exchanges (id TEXT PRIMARY KEY,user_id TEXT,exchange_type TEXT)`,
+		`INSERT INTO exchanges VALUES ('ex','owner','okx')`,
+		`CREATE TABLE traders (id TEXT PRIMARY KEY,user_id TEXT,exchange_id TEXT)`,
+		`INSERT INTO traders VALUES ('a','owner','ex'),('b','owner','ex')`,
+	} {
+		must(db.Exec(query).Error)
+	}
+	must(st.Spot().InitTables())
+	must(st.Spot().Configure(store.SpotPolicy{UserID: "owner", AccountUID: "123", QuoteCurrency: quote, CapitalCap: "100"}, []string{"ex"}, map[string]string{"a": "40", "b": "60"}))
+	must(st.Spot().SetReconciled("owner", "ex", true))
+	_, err = st.Spot().Reserve(store.SpotReserve{UserID: "owner", ExchangeID: "ex", TraderID: "a", ClientOrderID: "buyA", InstrumentID: "BTC-" + quote, BaseCurrency: "BTC", Side: "buy", Quantity: "0.1", QuoteReserve: "10.01", BaseReserve: "0"})
+	must(err)
+	must(st.Spot().SetIntentState("owner", "buyA", "", "SUBMITTED"))
+	must(st.Spot().SetIntentState("owner", "buyA", "99", "OPEN"))
+	must(st.Spot().ApplyFill("owner", store.SpotFill{ExchangeID: "ex", ClientOrderID: "buyA", ExchangeOrderID: "99", FillID: "1", Quantity: "0.1", QuoteQuantity: "10", Fee: "-0.001", FeeCurrency: "BTC", Rebate: "0"}))
+	must(st.Spot().Finish("owner", "buyA", "FILLED", "0.1"))
+	now := time.Date(2026, 9, 26, 12, 0, 0, 0, time.UTC)
+	failure := ""
+	client := spotFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet {
+			t.Fatal("context construction sent a mutation")
+		}
+		switch r.URL.Path {
+		case "/api/v5/account/config":
+			spotReply(w, `[{"uid":"123","acctLv":"1","feeType":"0","perm":"read_only,trade","autoLoan":false,"enableSpotBorrow":false}]`)
+		case "/api/v5/account/balance":
+			spotReply(w, fmt.Sprintf(`[{"details":[{"ccy":%q,"cashBal":"1000","availBal":"1000","liab":"0"},{"ccy":"BTC","cashBal":"2.099","availBal":"2.099","liab":"0"},{"ccy":"ETH","cashBal":"3","availBal":"3","liab":"0"}]}]`, quote))
+		case "/api/v5/account/instruments":
+			if r.URL.Query().Get("instType") != "SPOT" {
+				t.Fatal("context requested non-spot catalog")
+			}
+			spotReply(w, fmt.Sprintf(`[{"instType":"SPOT","instId":%q,"baseCcy":"BTC","quoteCcy":%q,"state":"live","lotSz":"0.001","minSz":"0.01","tickSz":"0.1","maxLmtSz":"5","groupId":"12"},{"instType":"SPOT","instId":%q,"baseCcy":"ETH","quoteCcy":%q,"state":"live","lotSz":"0.001","minSz":"0.01","tickSz":"0.1","maxLmtSz":"5","groupId":"12"}]`, "BTC-"+quote, quote, "ETH-"+quote, quote))
+		case "/api/v5/market/ticker":
+			ts := now.UnixMilli()
+			if failure == "stale_ticker" {
+				ts = now.Add(-2 * time.Minute).UnixMilli()
+			}
+			spotReply(w, fmt.Sprintf(`[{"instId":%q,"last":"110","ts":%q}]`, r.URL.Query().Get("instId"), strconv.FormatInt(ts, 10)))
+		case "/api/v5/market/candles":
+			period := map[string]time.Duration{"3m": 3 * time.Minute, "15m": 15 * time.Minute, "1H": time.Hour, "4H": 4 * time.Hour}[r.URL.Query().Get("bar")]
+			if period == 0 || r.URL.Query().Get("limit") != "200" {
+				t.Fatalf("unexpected candle request: %s", r.URL.RawQuery)
+			}
+			end := now
+			if failure == "stale_candles" {
+				end = now.Add(-3 * period)
+			}
+			rows := [][]string{{strconv.FormatInt(end.UnixMilli(), 10), "999", "999", "999", "999", "1", "1", "1", "0"}}
+			for i := 1; i <= 80; i++ {
+				if failure == "candle_gap" && i == 2 {
+					continue
+				}
+				rows = append(rows, []string{strconv.FormatInt(end.Add(-time.Duration(i)*period).UnixMilli(), 10), "100", "101", "99", "100", "1", "100", "100", "1"})
+			}
+			encoded, _ := json.Marshal(rows)
+			spotReply(w, string(encoded))
+		default:
+			t.Fatalf("context reached unexpected endpoint %s", r.URL.Path)
+		}
+	})
+	client.now = func() time.Time { return now }
+	spot := &OKXSpotTrader{client: client, store: st, userID: "owner", exchangeID: "ex", traderID: "a", accountUID: "123", quote: quote}
+	config := store.GetDefaultStrategyConfig("en")
+	config.CoinSource = store.CoinSourceConfig{SourceType: "static", StaticCoins: []string{"BTC-" + quote, "ETH" + quote, "ETH-" + quote}, ExcludedCoins: []string{"BTC" + quote}}
+	config.Indicators.Klines = store.KlineConfig{PrimaryTimeframe: "15m", PrimaryCount: 2, SelectedTimeframes: []string{"15m", "1h"}, LongerTimeframe: "4h", LongerCount: 3, EnableMultiTimeframe: true}
+	at := &AutoTrader{strategyEngine: kernel.NewStrategyEngine(&config), initialBalance: 999999, startTime: now.Add(-5 * time.Minute), callCount: 4}
+	return at, spot, &failure
+}
+
+func TestOKXSpotTradingContext(t *testing.T) {
+	for _, quote := range []string{"USD", "USDC", "USDT"} {
+		t.Run(quote, func(t *testing.T) {
+			at, spot, _ := spotContextFixture(t, quote)
+			ctx, err := at.buildSpotTradingContext(spot)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !ctx.CashSpot || ctx.QuoteCurrency != quote || ctx.BTCETHLeverage != 1 || ctx.AltcoinLeverage != 1 || ctx.RuntimeMinutes != 5 || ctx.CallCount != 4 {
+				t.Fatal("spot context identity or timing incorrect")
+			}
+			if len(ctx.CandidateCoins) != 1 || ctx.CandidateCoins[0].Symbol != "ETH"+quote || len(ctx.Positions) != 1 || ctx.Positions[0].Symbol != "BTC"+quote {
+				t.Fatal("excluded holding or duplicate candidate handled incorrectly")
+			}
+			if math.Abs(ctx.Account.TotalEquity-40.89) > 1e-9 || math.Abs(ctx.Account.TotalPnL-0.89) > 1e-9 || math.Abs(ctx.Account.TotalPnLPct-2.225) > 1e-9 || ctx.Account.AvailableBalance != 30 {
+				t.Fatalf("used initial balance or another owner's money: %+v", ctx.Account)
+			}
+			pos := ctx.Positions[0]
+			if pos.Quantity != 0.099 || math.Abs(pos.EntryPrice-10/0.099) > 1e-9 || pos.Leverage != 1 || pos.MarginUsed != 0 || pos.LiquidationPrice != 0 {
+				t.Fatalf("incorrect owned holding: %+v", pos)
+			}
+			if ctx.OITopDataMap != nil || ctx.QuantDataMap != nil || ctx.OIRankingData != nil || ctx.NetFlowRankingData != nil || ctx.PriceRankingData != nil || ctx.TradingStats != nil || len(ctx.RecentOrders) != 0 {
+				t.Fatal("legacy or account-wide statistics leaked into spot context")
+			}
+			for _, symbol := range []string{"BTC" + quote, "ETH" + quote} {
+				data := ctx.MarketDataMap[symbol]
+				if data == nil || data.Symbol != symbol || data.CurrentPrice != 110 || data.OpenInterest != nil || data.FundingRate != 0 || len(data.TimeframeData) != 3 {
+					t.Fatalf("spot market identity or source incorrect for %s", symbol)
+				}
+				for tf, series := range data.TimeframeData {
+					count := 2
+					if tf == "4h" {
+						count = 3
+					}
+					if len(series.Klines) != count || len(series.EMA50Values) != count {
+						t.Fatal("configured counts or indicator calculation were lost")
+					}
+					for _, bar := range series.Klines {
+						if bar.Close != 100 {
+							t.Fatal("unconfirmed candle reached prompt")
+						}
+					}
+				}
+			}
+			other := *spot
+			other.traderID = "b"
+			ctx, err = at.buildSpotTradingContext(&other)
+			if err != nil || ctx.Account.TotalEquity != 60 || ctx.Account.TotalPnL != 0 || len(ctx.Positions) != 0 {
+				t.Fatalf("sibling trader or manual holdings imported: %+v %v", ctx, err)
+			}
+		})
+	}
+}
+
+func TestOKXSpotContextRejectsUnsupportedInputs(t *testing.T) {
+	for _, name := range []string{"dynamic", "empty_static", "missing_pair", "wrong_quote", "invalid_timeframe", "too_many_bars", "stale_ticker", "stale_candles", "candle_gap"} {
+		t.Run(name, func(t *testing.T) {
+			at, spot, failure := spotContextFixture(t, "USD")
+			config := at.strategyEngine.GetConfig()
+			switch name {
+			case "dynamic":
+				config.CoinSource.SourceType = "ai500"
+			case "empty_static":
+				config.CoinSource.StaticCoins = nil
+			case "missing_pair":
+				config.CoinSource.StaticCoins = []string{"BTC"}
+			case "wrong_quote":
+				config.CoinSource.StaticCoins = []string{"BTCUSDT"}
+			case "invalid_timeframe":
+				config.Indicators.Klines.SelectedTimeframes = []string{"8h"}
+			case "too_many_bars":
+				config.Indicators.Klines.PrimaryCount = 300
+			default:
+				*failure = name
+			}
+			if ctx, err := at.buildSpotTradingContext(spot); err == nil || ctx != nil {
+				t.Fatal("unsupported configuration or stale market silently accepted")
+			}
+		})
+	}
+}
