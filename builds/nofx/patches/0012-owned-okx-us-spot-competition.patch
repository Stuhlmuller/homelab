+			}
+			var body map[string]string
+			must(json.NewDecoder(r.Body).Decode(&body))
+			if body["tdMode"] != "cash" || body["instId"] != "BTC-USDT" || body["posSide"] != "" || body["lever"] != "" {
+				t.Fatalf("non-cash wire shape: %#v", body)
+			}
+			nextID++
+			id := fmt.Sprint(nextID)
+			switch r.URL.Path {
+			case okxOrderPath:
+				if body["ordType"] != "ioc" {
+					t.Fatal("unbounded order")
+				}
+				orders[body["clOrdId"]] = orderFixture{id, body["clOrdId"], body["side"], body["sz"], body["px"]}
+				spotReply(w, fmt.Sprintf(`[{"sCode":"0","ordId":%q,"clOrdId":%q}]`, id, body["clOrdId"]))
+			case okxAlgoOrderPath:
+				if body["ordType"] != "oco" || body["side"] != "sell" || body["tpOrdPx"] == "-1" || body["slOrdPx"] == "-1" {
+					t.Fatal("unbounded protection")
+				}
+				if body["slTriggerPx"] != "90" || body["slOrdPx"] != "90" || body["tpTriggerPx"] != "120" || body["tpOrdPx"] != "120" {
+					t.Fatalf("protection prices were not quantized toward current price: %#v", body)
