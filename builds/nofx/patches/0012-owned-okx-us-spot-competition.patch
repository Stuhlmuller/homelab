@@ -0,0 +1,153 @@
+import {
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+  waitFor,
+} from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { httpClient } from '../lib/httpClient'
+import {
+  SpotCompetitionModal,
+  type SpotCompetitionConfiguration,
+} from './SpotCompetitionModal'
+
+vi.mock('../lib/httpClient', () => ({
+  httpClient: { get: vi.fn(), put: vi.fn() },
+}))
+const path = '/api/exchanges/shared-okx/spot'
+const base = (): SpotCompetitionConfiguration => ({
+  configured: false,
+  quote_currency: '',
+  capital_cap: '',
+  allocations: {},
+  eligible_quote_currencies: ['USDT'],
+  traders: ['Trend', 'Mean Reversion', 'Breakout', 'Consensus'].map((name) => ({
+    id: name,
+    name,
+    stopped: true,
+  })),
+  all_stopped: true,
+  locked: false,
+})
+const show = (configuration = base()) => {
+  vi.mocked(httpClient.get).mockResolvedValue({
+    success: true,
+    data: configuration,
+  })
+  return render(
+    <SpotCompetitionModal
+      exchangeId="shared-okx"
+      accountName="Existing OKX"
+      language="en"
+      onClose={vi.fn()}
+    />
+  )
+}
+
+beforeEach(() => vi.clearAllMocks())
+afterEach(cleanup)
+
+describe('Spot competition configuration', () => {
+  it('starts money inputs blank and saves only explicit allocations without starting traders', async () => {
+    show()
+    await screen.findByLabelText('Shared account capital cap')
+    expect(httpClient.get).toHaveBeenCalledWith(path)
+    for (const input of screen.getAllByRole('textbox'))
+      expect(input).toHaveValue('')
+    fireEvent.click(screen.getByRole('button', { name: 'Save configuration' }))
+    expect(httpClient.put).not.toHaveBeenCalled()
+    fireEvent.change(screen.getByLabelText('Quote currency'), {
+      target: { value: 'USDT' },
+    })
+    fireEvent.change(screen.getByLabelText(/Shared account capital cap/), {
+      target: { value: '90.00000001' },
+    })
+    for (const name of ['Trend', 'Mean Reversion', 'Breakout']) {
+      fireEvent.change(
+        screen.getByLabelText(new RegExp(`${name} allocation`)),
+        { target: { value: '30' } }
+      )
+    }
+    vi.mocked(httpClient.put).mockResolvedValue({
+      success: true,
+      data: {
+        ...base(),
+        configured: true,
+        quote_currency: 'USDT',
+        capital_cap: '90.00000001',
+        allocations: { Trend: '30', 'Mean Reversion': '30', Breakout: '30' },
+      },
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'Save configuration' }))
+    await screen.findByText('Configuration saved. Traders remain stopped.')
+    expect(httpClient.put).toHaveBeenCalledExactlyOnceWith(path, {
+      quote_currency: 'USDT',
+      capital_cap: '90.00000001',
+      allocations: { Trend: '30', 'Mean Reversion': '30', Breakout: '30' },
+    })
+    expect(screen.getByLabelText(/Consensus allocation/)).toHaveValue('')
+    expect(
+      screen.queryByRole('button', { name: /start|fund/i })
+    ).not.toBeInTheDocument()
+  })
+
+  it.each([
+    { locked: true, message: /Trading intents exist/ },
+    { all_stopped: false, message: /Stop every trader/ },
+    {
+      verification_error: 'Unable to verify the saved account.',
+      message: /Unable to verify the saved account/,
+    },
+  ])(
+    'keeps saved amounts visible when editing is unavailable: %j',
+    async ({ message, ...constraint }) => {
+      show({
+        ...base(),
+        configured: true,
+        quote_currency: 'USDT',
+        capital_cap: '90',
+        allocations: { Trend: '30' },
+        ...constraint,
+      })
+      await screen.findByText(message)
+      expect(screen.getByLabelText(/Shared account capital cap/)).toHaveValue(
+        '90'
+      )
+      expect(screen.getByLabelText(/Trend allocation/)).toHaveValue('30')
+      expect(
+        screen.getByRole('button', { name: 'Save configuration' })
+      ).toBeDisabled()
+      fireEvent.click(
+        screen.getByRole('button', { name: 'Save configuration' })
+      )
+      expect(httpClient.put).not.toHaveBeenCalled()
+    }
+  )
+
+  it('preserves entered amounts after a safe backend rejection', async () => {
+    show({
+      ...base(),
+      configured: true,
+      quote_currency: 'USDT',
+      capital_cap: '90',
+      allocations: { Trend: '30' },
+    })
+    await screen.findByLabelText(/Shared account capital cap/)
+    vi.mocked(httpClient.put).mockResolvedValue({
+      success: false,
+      message:
+        'Available OKX cash does not cover the requested trader allocations',
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'Save configuration' }))
+    await screen.findByText(
+      'Available OKX cash does not cover the requested trader allocations'
+    )
+    await waitFor(() =>
+      expect(
+        screen.getByRole('button', { name: 'Save configuration' })
+      ).not.toBeDisabled()
+    )
+    expect(screen.getByLabelText(/Trend allocation/)).toHaveValue('30')
+  })
+})
