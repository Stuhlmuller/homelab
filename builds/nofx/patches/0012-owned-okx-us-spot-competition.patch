+package store
+
+import (
+	"errors"
+	"regexp"
+	"strings"
+
+	"github.com/shopspring/decimal"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+)
+
+// SpotPolicy is an explicit capital authorization, never an exchange balance.
+// AccountUID must come from the authenticated OKX account response, not a form.
+type SpotPolicy struct {
+	AccountUID    string `gorm:"primaryKey" json:"account_uid"`
+	UserID        string `gorm:"not null" json:"user_id"`
+	QuoteCurrency string `gorm:"not null" json:"quote_currency"`
+	CapitalCap    string `gorm:"not null" json:"capital_cap"`
+	Reconciled    bool   `json:"reconciled"`
+	Revision      int64  `json:"-"`
+}
+
+type spotBinding struct {
+	ExchangeID string `gorm:"primaryKey"`
+	AccountUID string `gorm:"not null;index"`
+}
+
+type spotAllocation struct {
+	TraderID   string `gorm:"primaryKey"`
+	AccountUID string `gorm:"not null;index"`
+	Capital    string `gorm:"not null"`
+}
+
+type SpotReserve struct {
+	// Authenticated instrument minimum, supplied by the executor, never the model.
+	MinQuantity                                 string
+	IsProtection                                bool
+	ProtectionFor, StopLoss, TakeProfit         string
+	UserID, ExchangeID, TraderID, ClientOrderID string
+	InstrumentID, BaseCurrency, Side            string
+	Quantity, QuoteReserve, BaseReserve         string
+}
+
+// SUBMITTED is persisted before HTTP. OPEN means the exchange acknowledged it;
+// UNKNOWN and SUBMITTED retain every remaining reservation across restarts.
+type SpotIntent struct {
+	ClientOrderID       string `gorm:"primaryKey" json:"client_order_id"`
+	AccountUID          string `gorm:"not null;index" json:"account_uid"`
+	ExchangeID          string `gorm:"not null" json:"exchange_id"`
+	TraderID            string `gorm:"not null" json:"trader_id"`
+	InstrumentID        string `gorm:"not null" json:"instrument_id"`
+	BaseCurrency        string `gorm:"not null" json:"base_currency"`
+	Side                string `gorm:"not null" json:"side"`
+	Quantity            string `gorm:"not null" json:"quantity"`
+	QuoteReserve        string `gorm:"not null" json:"quote_reserve"`
+	BaseReserve         string `gorm:"not null" json:"base_reserve"`
+	ExchangeOrderID     string `gorm:"not null;default:''" json:"exchange_order_id"`
+	IsProtection        bool   `gorm:"not null;default:false" json:"is_protection"`
+	AlgoID              string `gorm:"not null;default:''" json:"algo_id"`
+	AlgoTerminalStatus  string `gorm:"not null;default:''" json:"algo_terminal_status"`
+	ProtectionFor       string `gorm:"not null;default:'';index" json:"protection_for"`
+	StopLoss            string `gorm:"not null;default:''" json:"stop_loss"`
+	TakeProfit          string `gorm:"not null;default:''" json:"take_profit"`
+	MinQuantity         string `gorm:"not null;default:''" json:"min_quantity"`
+	RejectionCode       string `gorm:"not null;default:''" json:"rejection_code"`
+	State               string `gorm:"not null" json:"state"`
+	FinalFilledQuantity string `gorm:"not null;default:''" json:"final_filled_quantity"`
+}
+
+// Fee follows OKX's signed convention: negative cost, positive credit. Rebate is
+// a separate nonnegative credit, possibly denominated in a different currency.
+// Quantities and consideration are actual fills, not order acknowledgements.
+type SpotFill struct {
+	ID              uint64 `gorm:"primaryKey;autoIncrement" json:"-"`
+	AccountUID      string `gorm:"not null;uniqueIndex:spot_fill_identity,priority:1" json:"-"`
+	InstrumentID    string `gorm:"not null;uniqueIndex:spot_fill_identity,priority:2" json:"-"`
+	FillID          string `gorm:"not null;uniqueIndex:spot_fill_identity,priority:3" json:"fill_id"`
+	ExchangeID      string `gorm:"not null" json:"exchange_id"`
+	ClientOrderID   string `gorm:"not null;index" json:"client_order_id"`
+	ExchangeOrderID string `gorm:"not null" json:"exchange_order_id"`
+	Quantity        string `gorm:"not null" json:"quantity"`
+	QuoteQuantity   string `gorm:"not null" json:"quote_quantity"`
+	Fee             string `gorm:"not null" json:"fee"`
+	FeeCurrency     string `gorm:"not null" json:"fee_currency"`
+	Rebate          string `gorm:"not null" json:"rebate"`
+	RebateCurrency  string `gorm:"not null" json:"rebate_currency"`
+}
+
+type SpotSnapshot struct {
+	Available                                                 bool `json:"available"`
+	Allocation, Cash, AvailableQuote, ReservedQuote           string
+	CommittedQuote, AccountCommittedQuote, CapitalCap         string
+	Inventory, AvailableInventory, InventoryCost, AverageCost map[string]string
+	EntryClientOrderID                                        map[string]string
+}
+
+type SpotStore struct{ db *gorm.DB }
+
+func NewSpotStore(db *gorm.DB) *SpotStore { return &SpotStore{db: db} }
+
+func (s *SpotStore) InitTables() error {
+	if err := s.db.AutoMigrate(&SpotPolicy{}, &spotBinding{}, &spotAllocation{}, &SpotIntent{}, &SpotFill{}); err != nil {
+		return err
+	}
+	if err := s.db.Exec(`CREATE UNIQUE INDEX IF NOT EXISTS spot_order_identity ON spot_intents(account_uid, exchange_order_id) WHERE exchange_order_id != ''`).Error; err != nil {
+		return err
+	}
+	return s.db.Exec(`CREATE UNIQUE INDEX IF NOT EXISTS spot_algo_identity ON spot_intents(account_uid, algo_id) WHERE algo_id != ''`).Error
+}
+
+var spotCurrency = regexp.MustCompile(`^[A-Z0-9]{1,20}$`)
+var spotClientID = regexp.MustCompile(`^[A-Za-z0-9]{1,32}$`)
+var spotNumber = regexp.MustCompile(`^-?(0|[1-9][0-9]*)(\.[0-9]{1,30})?$`)
+
+func spotDecimal(value string) (decimal.Decimal, error) {
+	if len(value) > 80 || !spotNumber.MatchString(value) {
+		return decimal.Zero, errors.New("invalid spot decimal")
+	}
+	return decimal.NewFromString(value)
+}
+
+func spotNonnegative(value string) (decimal.Decimal, error) {
+	d, err := spotDecimal(value)
+	if err != nil || d.IsNegative() {
+		return decimal.Zero, errors.New("invalid nonnegative spot amount")
+	}
+	return d, nil
+}
+
+func spotPositive(value string) (decimal.Decimal, error) {
+	d, err := spotNonnegative(value)
+	if err != nil || !d.IsPositive() {
+		return decimal.Zero, errors.New("positive spot amount required")
+	}
+	return d, nil
+}
+
+func spotTerminal(state string) bool {
+	return state == "FILLED" || state == "CANCELED" || state == "REJECTED"
+}
+
+// Serialize writes on the physical account, including across Store instances.
+// The first write acquires SQLite's writer lock; PostgreSQL locks this row.
+func spotLock(tx *gorm.DB, userID, uid string) (*SpotPolicy, error) {
+	r := tx.Model(&SpotPolicy{}).Where("account_uid = ? AND user_id = ?", uid, userID).UpdateColumn("revision", gorm.Expr("revision + 1"))
+	if r.Error != nil {
+		return nil, r.Error
+	}
+	if r.RowsAffected != 1 {
+		return nil, errors.New("spot account not configured for this user")
+	}
+	var policy SpotPolicy
+	err := tx.First(&policy, "account_uid = ?", uid).Error
+	return &policy, err
+}
+
+func spotPolicyFor(tx *gorm.DB, userID, exchangeID string, write bool) (*SpotPolicy, error) {
+	var exchange Exchange
+	if err := tx.Select("id", "user_id", "exchange_type").First(&exchange, "id = ? AND user_id = ? AND exchange_type = ?", exchangeID, userID, "okx").Error; err != nil {
+		return nil, errors.New("owned OKX connection required")
+	}
+	var binding spotBinding
+	if err := tx.First(&binding, "exchange_id = ?", exchangeID).Error; err != nil {
+		return nil, err
+	}
+	if write {
+		return spotLock(tx, userID, binding.AccountUID)
+	}
+	var policy SpotPolicy
+	err := tx.Clauses(clause.Locking{Strength: "SHARE"}).First(&policy, "account_uid = ? AND user_id = ?", binding.AccountUID, userID).Error
+	return &policy, err
+}
+
+func (s *SpotStore) Policy(userID, exchangeID string) (*SpotPolicy, error) {
+	var result *SpotPolicy
+	err := s.db.Transaction(func(tx *gorm.DB) error {
+		var err error
+		result, err = spotPolicyFor(tx, userID, exchangeID, false)
+		return err
+	})
+	return result, err
+}
+
+// Configure takes the complete allocation map. Once intent history exists,
+// capital/allocations are immutable so a UI edit cannot reset returns or grant
+// a second principal. Additional verified aliases may bind to the same policy.
+func (s *SpotStore) Configure(policy SpotPolicy, exchangeIDs []string, allocations map[string]string) error {
+	cap, err := spotPositive(policy.CapitalCap)
+	if err != nil || policy.UserID == "" || policy.AccountUID == "" || len(policy.AccountUID) > 128 || !spotCurrency.MatchString(policy.QuoteCurrency) || len(exchangeIDs) == 0 || len(allocations) == 0 {
+		return errors.New("explicit owned spot policy and allocations required")
+	}
+	policy.CapitalCap, policy.Reconciled, policy.Revision = cap.String(), false, 0
+	canonical := make(map[string]string, len(allocations))
+	total := decimal.Zero
+	for traderID, value := range allocations {
+		d, err := spotPositive(value)
+		if err != nil || traderID == "" {
+			return errors.New("positive trader allocation required")
+		}
+		canonical[traderID] = d.String()
+		total = total.Add(d)
+	}
+	if total.GreaterThan(cap) {
+		return errors.New("spot allocations exceed account capital cap")
+	}
+	return s.db.Transaction(func(tx *gorm.DB) error {
+		if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&policy).Error; err != nil {
+			return err
+		}
+		current, err := spotLock(tx, policy.UserID, policy.AccountUID)
+		if err != nil {
+			return err
+		}
+		if current.QuoteCurrency != policy.QuoteCurrency {
+			return errors.New("spot quote currency is immutable")
+		}
+		for _, exchangeID := range exchangeIDs {
+			var exchange Exchange
+			if err := tx.Select("id", "user_id", "exchange_type").First(&exchange, "id = ? AND user_id = ? AND exchange_type = ?", exchangeID, policy.UserID, "okx").Error; err != nil {
+				return errors.New("owned OKX connection required")
+			}
+			binding := spotBinding{ExchangeID: exchangeID, AccountUID: policy.AccountUID}
+			if err := tx.Clauses(clause.OnConflict{DoNothing: true}).Create(&binding).Error; err != nil {
+				return err
+			}
+			var saved spotBinding
+			if err := tx.First(&saved, "exchange_id = ?", exchangeID).Error; err != nil {
+				return err
+			}
+			if saved.AccountUID != policy.AccountUID {
+				return errors.New("spot account binding is immutable")
+			}
+		}
+		for traderID := range canonical {
+			var trader Trader
+			if err := tx.Select("id", "user_id", "exchange_id").First(&trader, "id = ? AND user_id = ?", traderID, policy.UserID).Error; err != nil {
+				return errors.New("owned trader required")
+			}
+			var binding spotBinding
+			if err := tx.First(&binding, "exchange_id = ? AND account_uid = ?", trader.ExchangeID, policy.AccountUID).Error; err != nil {
+				return errors.New("trader must use this physical account")
+			}
+		}
+		var old []spotAllocation
+		if err := tx.Where("account_uid = ?", policy.AccountUID).Find(&old).Error; err != nil {
+			return err
+		}
+		var count int64
+		if err := tx.Model(&SpotIntent{}).Where("account_uid = ?", policy.AccountUID).Count(&count).Error; err != nil {
+			return err
+		}
+		if count > 0 {
+			if current.CapitalCap != policy.CapitalCap || len(old) != len(canonical) {
+				return errors.New("spot capital is immutable after first intent")
+			}
+			for _, a := range old {
+				if canonical[a.TraderID] != a.Capital {
+					return errors.New("spot allocation is immutable after first intent")
+				}
+			}
+			return nil
+		}
+		if err := tx.Where("account_uid = ?", policy.AccountUID).Delete(&spotAllocation{}).Error; err != nil {
+			return err
+		}
+		for traderID, capital := range canonical {
+			if err := tx.Create(&spotAllocation{TraderID: traderID, AccountUID: policy.AccountUID, Capital: capital}).Error; err != nil {
+				return err
+			}
+		}
+		return tx.Model(current).Updates(map[string]interface{}{"capital_cap": policy.CapitalCap, "reconciled": false}).Error
+	})
+}
+
+type spotWallet struct {
+	allocation, cash, reserved   decimal.Decimal
+	quantity, cost, reservedBase map[string]decimal.Decimal
+	entry                        map[string]string
+}
+type spotTotals struct{ quantity, quote, base decimal.Decimal }
+type spotLedger struct {
+	wallets   map[string]*spotWallet
+	intents   map[string]SpotIntent
+	filled    map[string]spotTotals
+	committed decimal.Decimal
+	uncertain bool
+}
+
+// ponytail: replay this small competition's append-only fills in O(fills) under
+// the account lock; add verified checkpoints only if measured volume warrants it.
+// The ceiling is acquisition cost + outstanding buy budgets, not market value:
+// appreciation cannot authorize extra principal, and price gains may exceed cap.
+func spotLoad(tx *gorm.DB, policy *SpotPolicy) (*spotLedger, error) {
+	l := &spotLedger{wallets: map[string]*spotWallet{}, intents: map[string]SpotIntent{}, filled: map[string]spotTotals{}}
+	var allocations []spotAllocation
+	if err := tx.Where("account_uid = ?", policy.AccountUID).Find(&allocations).Error; err != nil {
+		return nil, err
+	}
+	principal := decimal.Zero
+	for _, a := range allocations {
+		d, err := spotPositive(a.Capital)
+		if err != nil {
+			return nil, err
+		}
+		principal = principal.Add(d)
+		l.wallets[a.TraderID] = &spotWallet{allocation: d, cash: d, quantity: map[string]decimal.Decimal{}, cost: map[string]decimal.Decimal{}, reservedBase: map[string]decimal.Decimal{}, entry: map[string]string{}}
+	}
+	cap, err := spotPositive(policy.CapitalCap)
+	if err != nil || principal.GreaterThan(cap) {
+		return nil, errors.New("invalid spot capital")
+	}
+	var intents []SpotIntent
+	if err := tx.Where("account_uid = ?", policy.AccountUID).Find(&intents).Error; err != nil {
+		return nil, err
+	}
+	for _, intent := range intents {
+		l.intents[intent.ClientOrderID] = intent
+	}
+	var fills []SpotFill
+	if err := tx.Where("account_uid = ?", policy.AccountUID).Order("id ASC").Find(&fills).Error; err != nil {
+		return nil, err
+	}
+	for _, fill := range fills {
+		i, ok := l.intents[fill.ClientOrderID]
+		w := l.wallets[i.TraderID]
+		if !ok || w == nil || i.ExchangeOrderID != fill.ExchangeOrderID || i.InstrumentID != fill.InstrumentID {
+			return nil, errors.New("unowned spot fill")
+		}
+		q, err := spotPositive(fill.Quantity)
+		if err != nil {
+			return nil, err
+		}
+		quote, err := spotPositive(fill.QuoteQuantity)
+		if err != nil {
+			return nil, err
+		}
+		fee, err := spotDecimal(fill.Fee)
+		if err != nil {
+			return nil, err
+		}
+		rebate, err := spotNonnegative(fill.Rebate)
+		if err != nil {
+			return nil, err
+		}
+		baseCredit, quoteCredit, baseFeeCost := decimal.Zero, decimal.Zero, decimal.Zero
+		for _, adjustment := range []struct {
+			value    decimal.Decimal
+			currency string
+		}{{fee, fill.FeeCurrency}, {rebate, fill.RebateCurrency}} {
+			if adjustment.value.IsZero() {
+				continue
+			}
+			switch adjustment.currency {
+			case i.BaseCurrency:
+				baseCredit = baseCredit.Add(adjustment.value)
+				if adjustment.value.IsNegative() {
+					baseFeeCost = baseFeeCost.Sub(adjustment.value)
+				}
+			case policy.QuoteCurrency:
+				quoteCredit = quoteCredit.Add(adjustment.value)
+			default:
+				return nil, errors.New("unsupported spot fee or rebate currency")
+			}
+		}
+		totals := l.filled[i.ClientOrderID]
+		totals.quantity = totals.quantity.Add(q)
+		quantity, cost := w.quantity[i.BaseCurrency], w.cost[i.BaseCurrency]
+		if i.Side == "buy" {
+			if quantity.IsPositive() && w.entry[i.BaseCurrency] != i.ClientOrderID {
+				minimum, err := spotPositive(i.MinQuantity)
+				if err != nil || !quantity.LessThan(minimum) {
+					return nil, errors.New("overlapping spot entries have ambiguous protection ownership")
+				}
+				// Same-agent residual dust joins this new position and its saved
+				// protection prices. Its acquisition cost remains in the wallet.
+			}
+			netBase, debit := q.Add(baseCredit), quote.Sub(quoteCredit)
+			if !netBase.IsPositive() || debit.IsNegative() {
+				return nil, errors.New("invalid spot buy consideration")
+			}
+			w.cash = w.cash.Sub(debit)
+			w.quantity[i.BaseCurrency] = quantity.Add(netBase)
+			w.cost[i.BaseCurrency] = cost.Add(debit)
+			w.entry[i.BaseCurrency] = i.ClientOrderID
+			totals.quote = totals.quote.Add(debit)
+		} else if i.Side == "sell" {
+			debit, netQuote := q.Sub(baseCredit), quote.Add(quoteCredit)
+			// Credits acquired on this sale have zero basis; only the sold
+			// units and any base fee dispose of previously acquired inventory.
+			disposed := q.Add(baseFeeCost)
+			if !debit.IsPositive() || netQuote.IsNegative() || disposed.GreaterThan(quantity) {
+				return nil, errors.New("spot sale exceeds owned inventory")
+			}
+			remainingCost := decimal.Zero
+			if disposed.LessThan(quantity) {
+				removed, _ := cost.Mul(disposed).QuoRem(quantity, 30)
+				remainingCost = cost.Sub(removed)
+			}
+			w.cash = w.cash.Add(netQuote)
+			w.quantity[i.BaseCurrency] = quantity.Sub(debit)
+			w.cost[i.BaseCurrency] = remainingCost
+			if w.quantity[i.BaseCurrency].IsZero() {
+				delete(w.entry, i.BaseCurrency)
+			}
+			totals.base = totals.base.Add(debit)
+		} else {
+			return nil, errors.New("invalid spot side")
+		}
+		if w.cash.IsNegative() {
+			return nil, errors.New("spot fill would borrow quote")
+		}
+		l.filled[i.ClientOrderID] = totals
+	}
+	for _, i := range intents {
+		w := l.wallets[i.TraderID]
+		if w == nil {
+			return nil, errors.New("spot intent lacks allocation")
+		}
+		q, err := spotPositive(i.Quantity)
+		if err != nil {
+			return nil, err
+		}
+		qr, err := spotNonnegative(i.QuoteReserve)
+		if err != nil {
+			return nil, err
+		}
+		br, err := spotNonnegative(i.BaseReserve)
+		if err != nil {
+			return nil, err
+		}
+		f := l.filled[i.ClientOrderID]
+		if f.quantity.GreaterThan(q) || f.quote.GreaterThan(qr) || f.base.GreaterThan(br) {
+			return nil, errors.New("spot fill exceeds reserved bounds")
+		}
+		if spotTerminal(i.State) {
+			final, err := spotNonnegative(i.FinalFilledQuantity)
+			if err != nil || !final.Equal(f.quantity) {
+				return nil, errors.New("incomplete terminal spot fills")
+			}
+			continue
+		}
+		if i.State != "RESERVED" && i.State != "SUBMITTED" && i.State != "OPEN" && i.State != "UNKNOWN" {
+			return nil, errors.New("invalid spot intent state")
+		}
+		l.uncertain = l.uncertain || i.State == "SUBMITTED" || i.State == "UNKNOWN"
+		w.reserved = w.reserved.Add(qr.Sub(f.quote))
+		w.reservedBase[i.BaseCurrency] = w.reservedBase[i.BaseCurrency].Add(br.Sub(f.base))
+	}
+	for _, w := range l.wallets {
+		if w.cash.LessThan(w.reserved) {
+			return nil, errors.New("spot quote reservation exceeds owned cash")
+		}
+		for base, reserved := range w.reservedBase {
+			if reserved.GreaterThan(w.quantity[base]) {
+				return nil, errors.New("spot base reservation exceeds owned inventory")
+			}
+		}
+		l.committed = l.committed.Add(w.reserved)
+		for _, cost := range w.cost {
+			l.committed = l.committed.Add(cost)
+		}
+	}
+	if l.committed.GreaterThan(cap) {
+		return nil, errors.New("spot commitment exceeds physical account cap")
+	}
+	return l, nil
+}
+
+func (s *SpotStore) SetReconciled(userID, exchangeID string, complete bool) error {
+	return s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, userID, exchangeID, true)
+		if err != nil {
+			return err
+		}
+		if complete {
+			l, err := spotLoad(tx, p)
+			if err != nil {
+				return err
+			}
+			if l.uncertain {
+				return errors.New("uncertain spot intent requires reconciliation")
+			}
+		}
+		return tx.Model(p).Update("reconciled", complete).Error
+	})
+}
+
+func (s *SpotStore) Reserve(req SpotReserve) (*SpotIntent, error) {
+	if req.MinQuantity != "" {
+		minimum, err := spotPositive(req.MinQuantity)
+		if err != nil || req.Side != "buy" {
+			return nil, errors.New("invalid authenticated spot minimum quantity")
+		}
+		req.MinQuantity = minimum.String()
+	}
+	if req.StopLoss != "" || req.TakeProfit != "" {
+		stop, stopErr := spotPositive(req.StopLoss)
+		take, takeErr := spotPositive(req.TakeProfit)
+		if stopErr != nil || takeErr != nil || !take.GreaterThan(stop) || req.Side != "buy" && !req.IsProtection {
+			return nil, errors.New("invalid spot protection prices")
+		}
+		req.StopLoss, req.TakeProfit = stop.String(), take.String()
+	}
+	q, err := spotPositive(req.Quantity)
+	if err != nil {
+		return nil, err
+	}
+	qr, err := spotNonnegative(req.QuoteReserve)
+	if err != nil {
+		return nil, err
+	}
+	br, err := spotNonnegative(req.BaseReserve)
+	if err != nil {
+		return nil, err
+	}
+	if !spotClientID.MatchString(req.ClientOrderID) || !spotCurrency.MatchString(req.BaseCurrency) || (req.Side != "buy" && req.Side != "sell") {
+		return nil, errors.New("invalid spot intent")
+	}
+	if req.Side == "buy" && (!qr.IsPositive() || !br.IsZero()) || req.Side == "sell" && (!qr.IsZero() || br.LessThan(q)) {
+		return nil, errors.New("explicit spot reservation bounds required")
+	}
+	if req.IsProtection && req.Side != "sell" {
+		return nil, errors.New("spot protection may only sell owned inventory")
+	}
+	if req.IsProtection && !spotClientID.MatchString(req.ProtectionFor) || !req.IsProtection && req.ProtectionFor != "" {
+		return nil, errors.New("spot protection requires its owned buy intent")
+	}
+	result := &SpotIntent{ClientOrderID: req.ClientOrderID, ExchangeID: req.ExchangeID, TraderID: req.TraderID, InstrumentID: req.InstrumentID, BaseCurrency: req.BaseCurrency, Side: req.Side, Quantity: q.String(), QuoteReserve: qr.String(), BaseReserve: br.String(), IsProtection: req.IsProtection, ProtectionFor: req.ProtectionFor, StopLoss: req.StopLoss, TakeProfit: req.TakeProfit, MinQuantity: req.MinQuantity, State: "RESERVED"}
+	err = s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, req.UserID, req.ExchangeID, true)
+		if err != nil {
+			return err
+		}
+		result.AccountUID = p.AccountUID
+		if req.InstrumentID != req.BaseCurrency+"-"+p.QuoteCurrency || req.BaseCurrency == p.QuoteCurrency {
+			return errors.New("spot instrument must match configured quote")
+		}
+		var trader Trader
+		if err := tx.Select("id").First(&trader, "id = ? AND user_id = ? AND exchange_id = ?", req.TraderID, req.UserID, req.ExchangeID).Error; err != nil {
+			return errors.New("owned trader connection required")
+		}
+		if req.IsProtection {
+			var parent SpotIntent
+			if err := tx.First(&parent, "client_order_id = ? AND account_uid = ? AND trader_id = ? AND instrument_id = ? AND side = ?", req.ProtectionFor, p.AccountUID, req.TraderID, req.InstrumentID, "buy").Error; err != nil {
+				return errors.New("owned spot buy required for protection")
+			}
+			if req.StopLoss != "" && (req.StopLoss != parent.StopLoss || req.TakeProfit != parent.TakeProfit) {
+				return errors.New("spot protection prices must match owned buy")
+			}
+			result.StopLoss, result.TakeProfit = parent.StopLoss, parent.TakeProfit
+		}
+		var old SpotIntent
+		err = tx.First(&old, "client_order_id = ?", req.ClientOrderID).Error
+		if err == nil {
+			if old.AccountUID != result.AccountUID || old.ExchangeID != result.ExchangeID || old.TraderID != result.TraderID || old.InstrumentID != result.InstrumentID || old.Side != result.Side || old.Quantity != result.Quantity || old.QuoteReserve != result.QuoteReserve || old.BaseReserve != result.BaseReserve || old.IsProtection != result.IsProtection || old.ProtectionFor != result.ProtectionFor || old.StopLoss != result.StopLoss || old.TakeProfit != result.TakeProfit || old.MinQuantity != result.MinQuantity {
+				return errors.New("spot client ID reuse conflicts with original intent")
+			}
+			*result = old
+			return nil
+		}
+		if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		l, err := spotLoad(tx, p)
+		if err != nil {
+			return err
+		}
+		if !p.Reconciled || l.uncertain {
+			return errors.New("spot account reconciliation required")
+		}
+		if l.wallets[req.TraderID] == nil {
+			return errors.New("explicit spot allocation required")
+		}
+		if req.Side == "buy" {
+			if held := l.wallets[req.TraderID].quantity[req.BaseCurrency]; held.IsPositive() {
+				minimum, err := spotPositive(req.MinQuantity)
+				if err != nil || !held.LessThan(minimum) {
+					return errors.New("tradable owned spot inventory must be closed before another entry")
+				}
+			}
+			for _, intent := range l.intents {
+				if intent.TraderID == req.TraderID && intent.InstrumentID == req.InstrumentID && !spotTerminal(intent.State) {
+					return errors.New("pending spot intent must reconcile before another entry")
+				}
+			}
+		}
+		if req.IsProtection {
+			if !l.filled[req.ProtectionFor].quantity.IsPositive() {
+				return errors.New("spot protection requires ingested buy fills")
+			}
+			for _, intent := range l.intents {
+				if intent.IsProtection && intent.ProtectionFor == req.ProtectionFor && !spotTerminal(intent.State) {
+					return errors.New("owned buy already has active spot protection")
+				}
+			}
+		}
+		if err := tx.Create(result).Error; err != nil {
+			return err
+		}
+		_, err = spotLoad(tx, p)
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func (s *SpotStore) intentTransaction(userID, clientID string, fn func(*gorm.DB, *SpotPolicy, *SpotIntent) error) error {
+	return s.db.Transaction(func(tx *gorm.DB) error {
+		var before SpotIntent
+		if err := tx.First(&before, "client_order_id = ?", clientID).Error; err != nil {
+			return err
+		}
+		p, err := spotLock(tx, userID, before.AccountUID)
+		if err != nil {
+			return err
+		}
+		var current SpotIntent
+		if err := tx.First(&current, "client_order_id = ?", clientID).Error; err != nil {
+			return err
+		}
+		return fn(tx, p, &current)
+	})
+}
+
+func (s *SpotStore) SetIntentState(userID, clientOrderID, exchangeOrderID, state string) error {
+	return s.setSubmissionState(userID, clientOrderID, exchangeOrderID, state, false)
+}
+
+// A native OCO parent reserves base before submission. The algo ID is distinct
+// from its eventual regular child order ID; neither may be reassigned.
+func (s *SpotStore) SetProtectionState(userID, clientOrderID, algoID, state string) error {
+	return s.setSubmissionState(userID, clientOrderID, algoID, state, true)
+}
+
+func (s *SpotStore) setSubmissionState(userID, clientOrderID, exchangeID, state string, protection bool) error {
+	if state != "SUBMITTED" && state != "OPEN" && state != "UNKNOWN" {
+		return errors.New("invalid spot submission state")
+	}
+	if state == "OPEN" && strings.TrimSpace(exchangeID) == "" {
+		return errors.New("acknowledged spot order ID required")
+	}
+	return s.intentTransaction(userID, clientOrderID, func(tx *gorm.DB, p *SpotPolicy, i *SpotIntent) error {
+		if i.IsProtection != protection {
+			return errors.New("spot submission kind mismatch")
+		}
+		if spotTerminal(i.State) {
+			return errors.New("terminal spot order cannot be reopened")
+		}
+		if state == "SUBMITTED" && i.State != "RESERVED" {
+			return errors.New("spot intent already submitted; reconcile instead of retrying")
+		}
+		if i.State == "RESERVED" && state != "SUBMITTED" {
+			return errors.New("persist SUBMITTED before any spot HTTP request")
+		}
+		column, oldID := "exchange_order_id", i.ExchangeOrderID
+		if protection {
+			column, oldID = "algo_id", i.AlgoID
+		}
+		if oldID != "" && exchangeID != "" && oldID != exchangeID {
+			return errors.New("spot exchange order ID is immutable")
+		}
+		if exchangeID == "" {
+			exchangeID = oldID
+		}
+		if err := tx.Model(i).Updates(map[string]interface{}{"state": state, column: exchangeID}).Error; err != nil {
+			return err
+		}
+		return tx.Model(p).Update("reconciled", false).Error
+	})
+}
+
+// The adapter must verify the parent's child relationship using authenticated
+// exchange data. Unexpected additional children fail closed with base retained.
+func (s *SpotStore) AttachProtectionChild(userID, clientOrderID, algoID, exchangeOrderID string) error {
+	if strings.TrimSpace(algoID) == "" || strings.TrimSpace(exchangeOrderID) == "" {
+		return errors.New("spot protection parent and child IDs required")
+	}
+	return s.intentTransaction(userID, clientOrderID, func(tx *gorm.DB, p *SpotPolicy, i *SpotIntent) error {
+		if !i.IsProtection || i.AlgoID != algoID {
+			return errors.New("spot protection parent mismatch")
+		}
+		if i.ExchangeOrderID == exchangeOrderID {
+			return nil
+		}
+		if i.ExchangeOrderID != "" || spotTerminal(i.State) || i.State == "RESERVED" || i.State == "SUBMITTED" {
+			return errors.New("spot protection child cannot be assigned")
+		}
+		if err := tx.Model(i).Update("exchange_order_id", exchangeOrderID).Error; err != nil {
+			return err
+		}
+		return tx.Model(p).Update("reconciled", false).Error
+	})
+}
+
+// Only the adapter's exact authenticated single-item rejection response may
+// invoke this before marking submission unknown. Timeouts are never this proof.
+func (s *SpotStore) RejectSubmission(userID, clientOrderID, rejectionCode string) error {
+	switch rejectionCode {
+	case "51000", "51001", "51006", "51008":
+	default:
+		return errors.New("unrecognized definitive spot rejection")
+	}
+	return s.intentTransaction(userID, clientOrderID, func(tx *gorm.DB, p *SpotPolicy, i *SpotIntent) error {
+		if i.State != "SUBMITTED" || i.ExchangeOrderID != "" || i.AlgoID != "" {
+			return errors.New("spot rejection requires an unidentified fresh submission")
+		}
+		var fills int64
+		if err := tx.Model(&SpotFill{}).Where("client_order_id = ?", clientOrderID).Count(&fills).Error; err != nil {
+			return err
+		}
+		if fills != 0 {
+			return errors.New("filled spot submission cannot be rejected")
+		}
+		updates := map[string]interface{}{"state": "REJECTED", "final_filled_quantity": "0", "rejection_code": rejectionCode}
+		if i.IsProtection {
+			updates["algo_terminal_status"] = "REJECTED"
+		}
+		if err := tx.Model(i).Updates(updates).Error; err != nil {
+			return err
+		}
+		return tx.Model(p).Update("reconciled", false).Error
+	})
+}
+
+func (s *SpotStore) ApplyFill(userID string, fill SpotFill) error {
+	q, err := spotPositive(fill.Quantity)
+	if err != nil {
+		return err
+	}
+	quote, err := spotPositive(fill.QuoteQuantity)
+	if err != nil {
+		return err
+	}
+	fee, err := spotDecimal(fill.Fee)
+	if err != nil {
+		return err
+	}
+	rebate, err := spotNonnegative(fill.Rebate)
+	if err != nil {
+		return err
+	}
+	if fill.FillID == "" || len(fill.FillID) > 128 || fill.ExchangeOrderID == "" {
+		return errors.New("spot fill identity required")
+	}
+	fill.ID, fill.Quantity, fill.QuoteQuantity, fill.Fee, fill.Rebate = 0, q.String(), quote.String(), fee.String(), rebate.String()
+	return s.intentTransaction(userID, fill.ClientOrderID, func(tx *gorm.DB, p *SpotPolicy, i *SpotIntent) error {
+		var binding spotBinding
+		if err := tx.First(&binding, "exchange_id = ? AND account_uid = ?", fill.ExchangeID, p.AccountUID).Error; err != nil {
+			return errors.New("spot fill account mismatch")
+		}
+		if i.ExchangeOrderID != fill.ExchangeOrderID || fill.InstrumentID != "" && fill.InstrumentID != i.InstrumentID {
+			return errors.New("spot fill order must be attached before ingestion")
+		}
+		fill.AccountUID, fill.InstrumentID = p.AccountUID, i.InstrumentID
+		var existing SpotFill
+		err := tx.First(&existing, "account_uid = ? AND instrument_id = ? AND fill_id = ?", p.AccountUID, i.InstrumentID, fill.FillID).Error
+		if err == nil {
+			if existing.ClientOrderID != fill.ClientOrderID || existing.ExchangeOrderID != fill.ExchangeOrderID || existing.Quantity != fill.Quantity || existing.QuoteQuantity != fill.QuoteQuantity || existing.Fee != fill.Fee || existing.FeeCurrency != fill.FeeCurrency || existing.Rebate != fill.Rebate || existing.RebateCurrency != fill.RebateCurrency {
+				return errors.New("conflicting spot fill replay")
+			}
+			return nil
+		}
+		if !errors.Is(err, gorm.ErrRecordNotFound) {
+			return err
+		}
+		if spotTerminal(i.State) || i.State == "RESERVED" {
+			return errors.New("spot fill requires a submitted nonterminal intent")
+		}
+		if err := tx.Create(&fill).Error; err != nil {
+			return err
+		}
+		if _, err = spotLoad(tx, p); err != nil {
+			return err
+		}
+		return tx.Model(p).Update("reconciled", false).Error
+	})
+}
+
+// Finish requires an exchange-confirmed terminal status AND exact cumulative
+// base fills. A canceled partially filled order must be fully ingested first.
+// A timeout, missing order, or mere cancel acknowledgement is not this proof.
+// An unsent RESERVED intent may be locally REJECTED with zero fills.
+func (s *SpotStore) Finish(userID, clientOrderID, terminalStatus, finalFilledQuantity string) error {
+	return s.finish(userID, clientOrderID, "", "", terminalStatus, finalFilledQuantity, false)
+}
+
+// A child's terminal status alone cannot release its parent's base reservation.
+// Both proofs must come from a complete authenticated reconciliation. With no
+// child, only a rejected/canceled parent with zero fills may release inventory.
+func (s *SpotStore) FinishProtection(userID, clientOrderID, algoID, algoTerminalStatus, childTerminalStatus, finalFilledQuantity string) error {
+	if algoTerminalStatus != "EFFECTIVE" && algoTerminalStatus != "CANCELED" && algoTerminalStatus != "REJECTED" {
+		return errors.New("confirmed spot protection terminal status required")
+	}
+	return s.finish(userID, clientOrderID, algoID, algoTerminalStatus, childTerminalStatus, finalFilledQuantity, true)
+}
+
+func (s *SpotStore) finish(userID, clientOrderID, algoID, algoStatus, terminalStatus, finalFilledQuantity string, protection bool) error {
+	if !protection && !spotTerminal(terminalStatus) {
+		return errors.New("confirmed spot terminal status required")
+	}
+	final, err := spotNonnegative(finalFilledQuantity)
+	if err != nil {
+		return err
+	}
+	return s.intentTransaction(userID, clientOrderID, func(tx *gorm.DB, p *SpotPolicy, i *SpotIntent) error {
+		if i.IsProtection != protection {
+			return errors.New("spot terminal proof kind mismatch")
+		}
+		if protection {
+			if i.AlgoID != algoID {
+				return errors.New("spot protection terminal parent mismatch")
+			}
+			if i.ExchangeOrderID == "" {
+				if terminalStatus != "" || !final.IsZero() || algoStatus == "EFFECTIVE" {
+					return errors.New("spot protection child terminal proof required")
+				}
+				terminalStatus = algoStatus
+			} else if !spotTerminal(terminalStatus) {
+				return errors.New("spot protection child terminal proof required")
+			}
+			if i.AlgoID == "" && (algoStatus != "REJECTED" || i.ExchangeOrderID != "" || i.State != "RESERVED" && i.State != "REJECTED") {
+				return errors.New("spot protection terminal algo ID required")
+			}
+			if i.State == "RESERVED" && (algoStatus != "REJECTED" || i.AlgoID != "") {
+				return errors.New("unsubmitted spot protection may only be locally rejected")
+			}
+		}
+		if spotTerminal(i.State) {
+			if i.State == terminalStatus && i.FinalFilledQuantity == final.String() && (!protection || i.AlgoTerminalStatus == algoStatus) {
+				return nil
+			}
+			return errors.New("conflicting terminal spot proof")
+		}
+		if i.State == "RESERVED" && (terminalStatus != "REJECTED" || !final.IsZero() || i.ExchangeOrderID != "") {
+			return errors.New("unsubmitted spot intent may only be locally rejected")
+		}
+		if !protection && i.State != "RESERVED" && i.ExchangeOrderID == "" {
+			return errors.New("unidentified submitted spot intent must retain its reservation")
+		}
+		l, err := spotLoad(tx, p)
+		if err != nil {
+			return err
+		}
+		if !final.Equal(l.filled[clientOrderID].quantity) || terminalStatus == "REJECTED" && !final.IsZero() || terminalStatus == "FILLED" && final.String() != i.Quantity {
+			return errors.New("terminal spot fills are incomplete")
+		}
+		if !protection && terminalStatus != "REJECTED" && i.ExchangeOrderID == "" {
+			return errors.New("terminal spot exchange ID required")
+		}
+		if err := tx.Model(i).Updates(map[string]interface{}{"state": terminalStatus, "final_filled_quantity": final.String(), "algo_terminal_status": algoStatus}).Error; err != nil {
+			return err
+		}
+		return tx.Model(p).Update("reconciled", false).Error
+	})
+}
+
+// These holdings include every allocation, even when its trader was deleted.
+// They are ledger-owned assets only, never the exchange's preexisting inventory.
+// Reconciliation uses this read while snapshots are deliberately unavailable.
+func (s *SpotStore) AccountHoldings(userID, exchangeID string) (string, map[string]string, error) {
+	cash := decimal.Zero
+	quantities := map[string]decimal.Decimal{}
+	err := s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, userID, exchangeID, false)
+		if err != nil {
+			return err
+		}
+		l, err := spotLoad(tx, p)
+		if err != nil {
+			return err
+		}
+		for _, w := range l.wallets {
+			cash = cash.Add(w.cash)
+			for base, quantity := range w.quantity {
+				quantities[base] = quantities[base].Add(quantity)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return "", nil, err
+	}
+	inventory := make(map[string]string, len(quantities))
+	for base, quantity := range quantities {
+		inventory[base] = quantity.String()
+	}
+	return cash.String(), inventory, nil
+}
+
+func (s *SpotStore) Allocations(userID, exchangeID string) (map[string]string, error) {
+	allocations := map[string]string{}
+	err := s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, userID, exchangeID, false)
+		if err != nil {
+			return err
+		}
+		var rows []spotAllocation
+		if err := tx.Where("account_uid = ?", p.AccountUID).Find(&rows).Error; err != nil {
+			return err
+		}
+		for _, row := range rows {
+			allocations[row.TraderID] = row.Capital
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return allocations, nil
+}
+
+func (s *SpotStore) Snapshot(userID, exchangeID, traderID string) (*SpotSnapshot, error) {
+	var result *SpotSnapshot
+	err := s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, userID, exchangeID, false)
+		if err != nil {
+			return err
+		}
+		l, err := spotLoad(tx, p)
+		if err != nil {
+			return err
+		}
+		w := l.wallets[traderID]
+		if w == nil {
+			return errors.New("spot trader has no allocation on this account")
+		}
+		result = &SpotSnapshot{Available: p.Reconciled && !l.uncertain, Allocation: w.allocation.String(), Cash: w.cash.String(), AvailableQuote: w.cash.Sub(w.reserved).String(), ReservedQuote: w.reserved.String(), CapitalCap: p.CapitalCap, AccountCommittedQuote: l.committed.String(), Inventory: map[string]string{}, AvailableInventory: map[string]string{}, InventoryCost: map[string]string{}, AverageCost: map[string]string{}, EntryClientOrderID: map[string]string{}}
+		committed := w.reserved
+		for base, quantity := range w.quantity {
+			result.Inventory[base], result.AvailableInventory[base], result.InventoryCost[base] = quantity.String(), quantity.Sub(w.reservedBase[base]).String(), w.cost[base].String()
+			average := decimal.Zero
+			if quantity.IsPositive() {
+				average = w.cost[base].DivRound(quantity, 30)
+				result.EntryClientOrderID[base] = w.entry[base]
+			}
+			result.AverageCost[base] = average.String()
+			committed = committed.Add(w.cost[base])
+		}
+		result.CommittedQuote = committed.String()
+		return nil
+	})
+	return result, err
+}
+
+func (s *SpotStore) Intents(userID, exchangeID string) ([]SpotIntent, error) {
+	var intents []SpotIntent
+	err := s.db.Transaction(func(tx *gorm.DB) error {
+		p, err := spotPolicyFor(tx, userID, exchangeID, false)
+		if err != nil {
+			return err
+		}
+		return tx.Where("account_uid = ?", p.AccountUID).Order("client_order_id").Find(&intents).Error
+	})
+	return intents, err
+}
