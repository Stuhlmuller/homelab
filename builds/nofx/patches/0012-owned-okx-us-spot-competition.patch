+	risk := store.RiskControlConfig{MaxPositions: 3, MinPositionSize: 1, MinConfidence: 50, MinRiskRewardRatio: 1, BTCETHMaxPositionValueRatio: 1, AltcoinMaxPositionValueRatio: 1, MaxMarginUsage: 1}
+	decision := kernel.Decision{Symbol: "BTCUSDT", Action: "open_long", Leverage: 1, PositionSizeUSD: 10, StopLoss: 89.95, TakeProfit: 120.09, Confidence: 80}
+	// With equity 40, budget 12, mark 1.9 and tick 1, twelve units cost 12
+	// but mark at 22.8. Cost alone fits 30%; marked exposure exceeds it.
+	coarseTick = true
+	coarseDecision := decision
+	coarseDecision.PositionSizeUSD, coarseDecision.StopLoss, coarseDecision.TakeProfit = 12, 1, 3
+	for _, limit := range []string{"position", "utilization"} {
+		bounded := risk
+		if limit == "position" {
+			bounded.BTCETHMaxPositionValueRatio = 0.3
+		} else {
+			bounded.MaxMarginUsage = 0.3
+		}
+		if _, err := a.ExecuteSpotDecision(coarseDecision, bounded, []string{"BTCUSDT"}); err == nil || posts != 0 {
+			t.Fatalf("coarse tick bypassed marked %s limit: %v; POSTs=%d", limit, err, posts)
+		}
+		unchanged, err := st.Spot().Snapshot("owner", "ex", "a")
+		must(err)
+		if unchanged.Cash != "40" || unchanged.ReservedQuote != "0" || len(unchanged.Inventory) != 0 {
+			t.Fatalf("rejected coarse-tick decision changed holdings: %+v", unchanged)
+		}
+	}
+	coarseTick = false
+	for _, tc := range []struct {
+		name, wantError   string
+		stop, take, ratio float64
+	}{
+		{"stop reaches mark", "bracket", 99.95, 120, 1},
+		{"take reaches mark", "bracket", 90, 100.05, 1},
+		{"rounded reward shrinks", "reward/risk", 90, 120.09, 2.005},
