+// Exercise two owners sharing one exchange account using the real protocol,
+// ledger, reservation and reconciliation paths. No socket or credentials.
+func TestOKXSpotOwnedExecution(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "execution.db")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	must := func(err error) {
+		t.Helper()
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	sqlDB, _ := db.DB()
+	sqlDB.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	st, err := store.NewFromGorm(db)
+	must(err)
+	must(db.Exec(`CREATE TABLE exchanges (id TEXT PRIMARY KEY,user_id TEXT,exchange_type TEXT)`).Error)
+	must(db.Exec(`INSERT INTO exchanges VALUES ('ex','owner','okx')`).Error)
+	must(db.Exec(`CREATE TABLE traders (id TEXT PRIMARY KEY,user_id TEXT,exchange_id TEXT)`).Error)
+	must(db.Exec(`INSERT INTO traders VALUES ('a','owner','ex'),('b','owner','ex')`).Error)
+	must(st.Spot().InitTables())
+	must(st.Spot().Configure(store.SpotPolicy{UserID: "owner", AccountUID: "123", QuoteCurrency: "USDT", CapitalCap: "100"}, []string{"ex"}, map[string]string{"a": "40", "b": "60"}))
+	type orderFixture struct{ ID, ClientID, Side, Quantity, Price string }
+	type algoFixture struct{ ID, ClientID, Quantity, State string }
+	orders := map[string]orderFixture{}
+	algos := map[string]algoFixture{}
+	nextID := 100
+	posts := 0
+	coarseTick := false
+	var canceled []string
+	c := spotFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		if r.Method == "POST" {
+			posts++
+			if r.URL.Path == okxCancelAlgoPath {
+				var body []map[string]string
+				must(json.NewDecoder(r.Body).Decode(&body))
+				for key, algo := range algos {
