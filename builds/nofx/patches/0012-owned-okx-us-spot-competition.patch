+func newSpotClientID() string { return strings.ReplaceAll(uuid.NewString(), "-", "") }
+func spotAmount(value float64) (decimal.Decimal, error) {
+	if math.IsNaN(value) || math.IsInf(value, 0) || value <= 0 {
+		return decimal.Zero, errors.New("positive finite spot amount required")
+	}
+	return decimal.NewFromFloat(value), nil
+}
+
+func (t *OKXSpotTrader) feeBound(inst OKXSpotInstrument) (decimal.Decimal, error) {
+	fees, err := t.client.FeeRates(inst)
+	if err != nil {
+		return decimal.Zero, err
+	}
+	cost := decimal.Max(decimal.Zero, fees.Maker.Neg(), fees.Taker.Neg())
+	if cost.GreaterThanOrEqual(decimal.NewFromInt(1)) {
+		return decimal.Zero, errors.New("invalid spot fee bound")
+	}
+	return cost, nil
+}
+
+// ExecuteSpotDecision is the entry path with both protective prices available.
+// Ownership and reservations are persisted before every outbound order request.
+func (t *OKXSpotTrader) ExecuteSpotDecision(d kernel.Decision, risk store.RiskControlConfig, candidates []string) (map[string]interface{}, error) {
+	if err := kernel.ValidateSpotDecision(d); err != nil {
+		return nil, err
+	}
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	snapshot, err := t.snapshot()
+	if err != nil {
+		return nil, err
+	}
+	if d.Action != "close_long" {
+		snapshot, err = t.recoverProtection(snapshot)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if d.Action == "hold" || d.Action == "wait" {
+		return map[string]interface{}{}, nil
+	}
+	inst, err := t.instrument(d.Symbol)
+	if err != nil {
+		return nil, err
+	}
+	if d.Action == "close_long" {
+		return t.closeOwned(inst, decimal.Zero)
+	}
+	allowed := false
+	for _, symbol := range candidates {
+		candidate, err := t.instrument(symbol)
+		if err != nil {
+			return nil, err
+		}
+		allowed = allowed || candidate.InstID == inst.InstID
+	}
+	if !allowed {
+		return nil, errors.New("spot buy is outside the explicit candidate list")
+	}
+	if existing, ok := snapshot.Inventory[inst.BaseCurrency]; ok && decimal.RequireFromString(existing).GreaterThanOrEqual(inst.minimumQuantity()) {
+		return nil, errors.New("close this agent's existing holding before another buy")
+	}
+	budget, _ := spotAmount(d.PositionSizeUSD)
+	price, priceTime, err := t.client.priceAt(inst.InstID)
+	if err != nil {
+		return nil, err
+	}
+	stop, _ := spotAmount(d.StopLoss)
+	take, _ := spotAmount(d.TakeProfit)
+	// Long sell protection triggers earlier when rounded toward the current
+	// price. Validate and persist these executable prices, not the model values.
+	stop = spotCeilStep(stop, inst.TickSize)
+	take = spotFloorStep(take, inst.TickSize)
+	if !stop.LessThan(price) || !take.GreaterThan(price) {
+		return nil, errors.New("spot stop/take prices must bracket the current price")
+	}
+	if risk.MaxPositions <= 0 || risk.MinPositionSize <= 0 || risk.MinConfidence < 0 || risk.MinConfidence > 100 || risk.MinRiskRewardRatio < 0 || math.IsNaN(risk.MinRiskRewardRatio) || math.IsInf(risk.MinRiskRewardRatio, 0) || math.IsNaN(risk.MinPositionSize) || math.IsInf(risk.MinPositionSize, 0) {
+		return nil, errors.New("explicit valid spot strategy limits required")
+	}
+	count := 0
+	equity := decimal.RequireFromString(snapshot.Cash)
+	invested := decimal.Zero
+	for base, amount := range snapshot.Inventory {
+		owned, err := t.instrument(base + "-" + t.quote)
+		if err != nil {
+			return nil, err
+		}
+		mark, err := t.client.Price(owned.InstID)
+		if err != nil {
+			return nil, err
+		}
+		value := decimal.RequireFromString(amount).Mul(mark)
+		equity = equity.Add(value)
+		invested = invested.Add(value)
+		if decimal.RequireFromString(amount).GreaterThanOrEqual(owned.minimumQuantity()) {
+			count++
+		}
+	}
+	ratio := risk.AltcoinMaxPositionValueRatio
+	if inst.BaseCurrency == "BTC" || inst.BaseCurrency == "ETH" {
+		ratio = risk.BTCETHMaxPositionValueRatio
+	}
+	maxRatio, ratioErr := spotAmount(ratio)
+	maxUsage, usageErr := spotAmount(risk.MaxMarginUsage)
+	if ratioErr != nil || usageErr != nil || maxUsage.GreaterThan(decimal.NewFromInt(1)) || !equity.IsPositive() {
+		return nil, errors.New("explicit valid spot position and cash utilization limits required")
+	}
+	if budget.GreaterThan(equity.Mul(maxRatio)) || invested.Add(budget).GreaterThan(equity.Mul(maxUsage)) {
+		return nil, errors.New("spot buy exceeds position or cash utilization limit")
+	}
+	if count >= risk.MaxPositions || d.Confidence < risk.MinConfidence || d.PositionSizeUSD < risk.MinPositionSize {
+		return nil, errors.New("spot decision exceeds strategy entry limits")
+	}
+	if take.Sub(price).LessThan(price.Sub(stop).Mul(decimal.NewFromFloat(risk.MinRiskRewardRatio))) {
+		return nil, errors.New("spot decision does not meet reward/risk limit")
+	}
+	rate, err := t.feeBound(inst)
+	if err != nil {
+		return nil, err
+	}
+	limit := spotFloorStep(price, inst.TickSize)
+	if !limit.IsPositive() {
+		return nil, errors.New("spot price is below the instrument tick")
+	}
+	units, _ := budget.QuoRem(limit.Mul(inst.LotSize), 0)
+	quantity := units.Mul(inst.LotSize)
+	reserve := quantity.Mul(limit).Mul(decimal.NewFromInt(1).Add(rate))
+	// Quote fees lower post-trade equity; a base fee can only reduce holdings.
+	// Enforce utilization against the conservative post-fee denominator too.
+	postEquity := equity.Sub(quantity.Mul(limit).Mul(rate))
+	// A coarse tick can make limit cost much lower than current marked exposure.
+	entryValue := quantity.Mul(price)
+	postHolding := entryValue
+	if dust, ok := snapshot.Inventory[inst.BaseCurrency]; ok {
+		postHolding = postHolding.Add(decimal.RequireFromString(dust).Mul(price))
+	}
+	if !postEquity.IsPositive() || postHolding.GreaterThan(postEquity.Mul(maxRatio)) || invested.Add(entryValue).GreaterThan(postEquity.Mul(maxUsage)) {
+		return nil, errors.New("spot buy plus fees exceeds position or cash utilization limit")
+	}
+	if reserve.GreaterThan(decimal.RequireFromString(snapshot.AvailableQuote)) {
+		return nil, errors.New("spot buy plus fees exceeds agent cash")
+	}
+	if err := inst.ValidateOrder(quantity, limit); err != nil {
+		return nil, err
+	}
+	// Verify a conservative post-fee amount can be protected before buying.
+	protected := spotFloorStep(quantity.Mul(decimal.NewFromInt(1).Sub(rate)), inst.LotSize)
+	for _, px := range []decimal.Decimal{stop, take} {
+		if err := inst.ValidateOrder(protected, px); err != nil {
+			return nil, err
+		}
+	}
+	id := newSpotClientID()
+	intent, err := t.store.Spot().Reserve(store.SpotReserve{UserID: t.userID, ExchangeID: t.exchangeID, TraderID: t.traderID, ClientOrderID: id,
+		InstrumentID: inst.InstID, BaseCurrency: inst.BaseCurrency, Side: "buy", Quantity: quantity.String(), MinQuantity: inst.minimumQuantity().String(), QuoteReserve: reserve.String(), BaseReserve: "0", StopLoss: stop.String(), TakeProfit: take.String()})
+	if err != nil {
+		return nil, err
+	}
+	if err := t.submitIOC(*intent, inst, limit, priceTime); err != nil {
+		return nil, err
+	}
+	if err := t.reconcile(); err != nil {
+		return nil, err
+	}
+	snapshot, err = t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := t.recoverProtection(snapshot); err != nil {
+		return nil, fmt.Errorf("spot entry requires protection recovery: %w", err)
+	}
+	return map[string]interface{}{"clientOrderId": id, "marketMode": "cash_spot"}, nil
+}
+
+func (t *OKXSpotTrader) submitIOC(intent store.SpotIntent, inst OKXSpotInstrument, limit decimal.Decimal, priceTime time.Time) error {
+	age := t.client.now().Sub(priceTime)
+	if age < 0 || age > time.Minute {
+		if err := t.store.Spot().Finish(t.userID, intent.ClientOrderID, "REJECTED", "0"); err != nil {
+			return err
+		}
+		return errors.New("spot decision price expired before submission")
+	}
+	if err := t.store.Spot().SetIntentState(t.userID, intent.ClientOrderID, "", "SUBMITTED"); err != nil {
+		return err
+	}
+	ref, err := t.client.PlaceIOC(inst, intent.Side, intent.ClientOrderID, decimal.RequireFromString(intent.Quantity), limit)
+	if err != nil {
+		var rejected *spotRejectedSubmission
+		if errors.As(err, &rejected) {
+			if releaseErr := t.store.Spot().RejectSubmission(t.userID, intent.ClientOrderID, rejected.Code); releaseErr != nil {
+				return releaseErr
+			}
+			return rejected
+		}
+		_ = t.store.Spot().SetIntentState(t.userID, intent.ClientOrderID, "", "UNKNOWN")
+		return errors.New("spot submission is unresolved; reserved funds retained, reconcile before another order")
+	}
+	return t.store.Spot().SetIntentState(t.userID, intent.ClientOrderID, ref.OrderID, "OPEN")
+}
+
+func (t *OKXSpotTrader) protectEntry(entry store.SpotIntent, inst OKXSpotInstrument, stop, take decimal.Decimal) error {
+	snapshot, err := t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return err
+	}
+	raw, exists := snapshot.AvailableInventory[inst.BaseCurrency]
+	if !exists {
+		return nil
+	}
+	amount, err := decimal.NewFromString(raw)
+	if err != nil || amount.IsNegative() {
+		return errors.New("invalid owned spot inventory")
+	}
+	if amount.IsZero() {
+		return nil
+	}
+	quantity := spotFloorStep(amount, inst.LotSize)
+	for _, px := range []decimal.Decimal{stop, take} {
+		if err := inst.ValidateOrder(quantity, px); err != nil {
+			return err
+		}
+	}
+	id := newSpotClientID()
+	_, err = t.store.Spot().Reserve(store.SpotReserve{UserID: t.userID, ExchangeID: t.exchangeID, TraderID: t.traderID, ClientOrderID: id,
+		InstrumentID: inst.InstID, BaseCurrency: inst.BaseCurrency, Side: "sell", Quantity: quantity.String(), QuoteReserve: "0", BaseReserve: quantity.String(), IsProtection: true, ProtectionFor: entry.ClientOrderID})
+	if err != nil {
+		return err
+	}
+	if err := t.store.Spot().SetProtectionState(t.userID, id, "", "SUBMITTED"); err != nil {
+		return err
+	}
+	ref, err := t.client.PlaceOCO(inst, id, quantity, take, take, stop, stop)
+	if err != nil {
+		var rejected *spotRejectedSubmission
+		if errors.As(err, &rejected) {
+			if releaseErr := t.store.Spot().RejectSubmission(t.userID, id, rejected.Code); releaseErr != nil {
+				return releaseErr
+			}
+			return rejected
+		}
+		_ = t.store.Spot().SetProtectionState(t.userID, id, "", "UNKNOWN")
+		return errors.New("spot protection submission unresolved; inventory remains reserved")
+	}
+	return t.store.Spot().SetProtectionState(t.userID, id, ref.AlgoID, "OPEN")
+}
+
+func (t *OKXSpotTrader) closeOwned(inst OKXSpotInstrument, requested decimal.Decimal) (result map[string]interface{}, resultErr error) {
+	// Reject an invalid close before canceling any existing protective order.
+	snapshot, err := t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return nil, err
+	}
+	amount, err := decimal.NewFromString(snapshot.Inventory[inst.BaseCurrency])
+	if err != nil || !amount.IsPositive() {
+		return nil, errors.New("no inventory owned by this agent")
+	}
+	maximum := spotFloorStep(amount, inst.LotSize)
+	quantity := maximum
+	if requested.IsPositive() {
+		if requested.GreaterThan(amount) {
+			return nil, errors.New("spot sale exceeds owned inventory")
+		}
+		quantity = spotFloorStep(requested, inst.LotSize)
+	}
+	price, priceTime, err := t.client.priceAt(inst.InstID)
+	if err != nil {
+		return nil, err
+	}
+	limit := spotCeilStep(price, inst.TickSize)
+	if err := inst.ValidateOrder(quantity, limit); err != nil {
+		return nil, err
+	}
+	intents, err := t.store.Spot().Intents(t.userID, t.exchangeID)
+	if err != nil {
+		return nil, err
+	}
+	cancellationAttempted := false
+	defer func() {
+		if !cancellationAttempted || resultErr == nil {
+			return
+		}
+		// A stopped trader's manual close has no monitor to repair a canceled
+		// protection. Recover after proven failure too; unknown orders stay reserved.
+		snapshot, err := t.snapshot()
+		if err == nil {
+			_, err = t.recoverProtection(snapshot)
+		}
+		if err != nil {
+			resultErr = fmt.Errorf("%w; saved protection recovery: %v", resultErr, err)
+		}
+	}()
+	for _, intent := range intents {
+		if intent.TraderID != t.traderID || intent.InstrumentID != inst.InstID || intent.State == "FILLED" || intent.State == "CANCELED" || intent.State == "REJECTED" {
+			continue
+		}
+		if !intent.IsProtection {
+			return nil, errors.New("reconcile this agent's pending order before closing")
+		}
+		cancellationAttempted = true
+		if intent.ExchangeOrderID != "" {
+			ref := OKXSpotOrderRef{InstID: inst.InstID, OrderID: intent.ExchangeOrderID, ParentAlgoClientID: intent.ClientOrderID, ParentAlgoID: intent.AlgoID}
+			if err := t.client.CancelOrder(ref); err != nil {
+				return nil, err
+			}
+		} else if err := t.client.CancelOCO(OKXSpotAlgoRef{InstID: inst.InstID, ClientOrderID: intent.ClientOrderID, AlgoID: intent.AlgoID}); err != nil {
+			return nil, err
+		}
+	}
+	if err := t.reconcile(); err != nil {
+		return nil, err
+	}
+	snapshot, err = t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return nil, err
+	}
+	available, err := decimal.NewFromString(snapshot.AvailableInventory[inst.BaseCurrency])
+	if err != nil || !available.IsPositive() {
+		return nil, errors.New("no available inventory owned by this agent")
+	}
+	// A protective child may fill during cancellation; cap to the remainder.
+	quantity = decimal.Min(quantity, spotFloorStep(available, inst.LotSize))
+	price, priceTime, err = t.client.priceAt(inst.InstID)
+	if err != nil {
+		return nil, err
+	}
+	limit = spotCeilStep(price, inst.TickSize)
+	if err := inst.ValidateOrder(quantity, limit); err != nil {
+		return nil, err
+	}
+	id := newSpotClientID()
+	intent, err := t.store.Spot().Reserve(store.SpotReserve{UserID: t.userID, ExchangeID: t.exchangeID, TraderID: t.traderID, ClientOrderID: id,
+		InstrumentID: inst.InstID, BaseCurrency: inst.BaseCurrency, Side: "sell", Quantity: quantity.String(), QuoteReserve: "0", BaseReserve: quantity.String()})
+	if err != nil {
+		return nil, err
+	}
+	if err := t.submitIOC(*intent, inst, limit, priceTime); err != nil {
+		return nil, err
+	}
+	if err := t.reconcile(); err != nil {
+		return nil, err
+	}
+	snapshot, err = t.store.Spot().Snapshot(t.userID, t.exchangeID, t.traderID)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := t.recoverProtection(snapshot); err != nil {
+		return nil, err
+	}
+	return map[string]interface{}{"clientOrderId": id, "marketMode": "cash_spot"}, nil
+}
+
+func (t *OKXSpotTrader) CloseLong(symbol string, quantity float64) (map[string]interface{}, error) {
+	if math.IsNaN(quantity) || math.IsInf(quantity, 0) || quantity < 0 {
+		return nil, errors.New("invalid spot close quantity")
+	}
+	okxSpotExecution.Lock()
+	defer okxSpotExecution.Unlock()
+	if _, err := t.snapshot(); err != nil {
+		return nil, err
+	}
+	inst, err := t.instrument(symbol)
+	if err != nil {
+		return nil, err
+	}
+	return t.closeOwned(inst, decimal.NewFromFloat(quantity))
+}
