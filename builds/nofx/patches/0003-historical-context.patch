+package backtest
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+	"time"
+
+	"nofx/kernel"
+	"nofx/store"
+)
+
+func TestHistoricalContextUsesOnlyHistoricalObservations(t *testing.T) {
+	// Guard the forbidden integration boundary before the behavioral test:
+	// a regression must fail without sending any current-data request.
+	file, err := parser.ParseFile(token.NewFileSet(), "runner.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	forbidden := map[string]bool{"FetchQuantDataBatch": true, "FetchOIRankingData": true, "FetchNetFlowRankingData": true, "FetchPriceRankingData": true}
+	ast.Inspect(file, func(node ast.Node) bool {
+		call, ok := node.(*ast.CallExpr)
+		if !ok {
+			return true
+		}
+		selector, ok := call.Fun.(*ast.SelectorExpr)
+		if ok && forbidden[selector.Sel.Name] {
+			t.Fatalf("historical runner must not call current data provider %s", selector.Sel.Name)
+		}
+		return true
+	})
+
+	start := time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)
+	entry := start.Add(30 * time.Minute)
+	cutoff := start.Add(3 * time.Hour)
+	account := NewBacktestAccount(1000, 0, 0)
+	if _, _, _, err := account.Open("BTCUSDT", "long", 1, 1, 100, entry.UnixMilli()); err != nil {
+		t.Fatal(err)
+	}
+	strategy := &store.StrategyConfig{
+		CoinSource: store.CoinSourceConfig{SourceType: "static", StaticCoins: []string{"BTCUSDT"}},
+		Indicators: store.IndicatorConfig{EnableQuantData: true, EnableOIRanking: true, EnableNetFlowRanking: true, EnablePriceRanking: true},
+	}
+	runner := Runner{cfg: BacktestConfig{StartTS: start.Unix(), Symbols: []string{"BTCUSDT"}}, account: account, strategyEngine: kernel.NewStrategyEngine(strategy)}
+	ctx, _, err := runner.buildDecisionContext(cutoff.UnixMilli(), nil, nil, map[string]float64{"BTCUSDT": 105}, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ctx.QuantDataMap != nil || ctx.OIRankingData != nil || ctx.NetFlowRankingData != nil || ctx.PriceRankingData != nil {
+		t.Fatal("current data leaked into historical context")
+	}
+	if ctx.SimulationTimeMS != cutoff.UnixMilli() || ctx.CurrentTime != "2020-01-01 03:00:00 UTC" || ctx.RuntimeMinutes != 180 {
+		t.Fatalf("wrong historical clock: %+v", ctx)
+	}
+	if len(ctx.Positions) != 1 || ctx.Positions[0].UpdateTime != entry.UnixMilli() {
+		t.Fatalf("position lost historical entry time: %+v", ctx.Positions)
+	}
+}
