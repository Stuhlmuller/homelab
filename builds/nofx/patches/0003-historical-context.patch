@@ -0,0 +1,85 @@
+package kernel
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"nofx/market"
+	"nofx/mcp"
+	"nofx/store"
+)
+
+func TestHistoricalPositionAgeUsesSimulationTime(t *testing.T) {
+	entry := time.Date(2020, 1, 1, 0, 30, 0, 0, time.UTC)
+	ctx := &Context{SimulationTimeMS: entry.Add(150 * time.Minute).UnixMilli()}
+	engine := NewStrategyEngine(&store.StrategyConfig{})
+	prompt := engine.formatPositionInfo(1, PositionInfo{Symbol: "BTCUSDT", Side: "long", UpdateTime: entry.UnixMilli()}, ctx)
+	if !strings.Contains(prompt, "Holding Duration 2h 30m") {
+		t.Fatalf("incorrect simulated position age: %s", prompt)
+	}
+}
+
+func TestHistoricalClockOmittedRetainsLiveAge(t *testing.T) {
+	engine := NewStrategyEngine(&store.StrategyConfig{})
+	prompt := engine.formatPositionInfo(1, PositionInfo{Symbol: "BTCUSDT", Side: "long", UpdateTime: time.Now().Add(-5 * time.Minute).UnixMilli()}, &Context{})
+	if !strings.Contains(prompt, "Holding Duration 5 min") {
+		t.Fatalf("live age behavior changed: %s", prompt)
+	}
+}
+
+type historicalDecisionModel struct {
+	mcp.AIClient
+	called     bool
+	userPrompt string
+}
+
+func (model *historicalDecisionModel) CallWithMessages(_, userPrompt string) (string, error) {
+	model.called = true
+	model.userPrompt = userPrompt
+	return `<decision>[{"symbol":"BTCUSDT","action":"wait","reasoning":"fixture"}]</decision>`, nil
+}
+
+func TestHistoricalDecisionDoesNotFetchCurrentOI(t *testing.T) {
+	entry := time.Date(2020, 1, 1, 0, 30, 0, 0, time.UTC)
+	config := store.GetDefaultStrategyConfig("en")
+	engine := NewStrategyEngine(&config)
+	// Removing the provider makes any current-OI lookup fail locally, before
+	// an external request. Exercise the real shared decision function below.
+	engine.nofxosClient = nil
+	model := &historicalDecisionModel{}
+	ctx := &Context{
+		SimulationTimeMS: entry.Add(150 * time.Minute).UnixMilli(),
+		CurrentTime:      "2020-01-01 03:00:00 UTC",
+		Account:          AccountInfo{TotalEquity: 1000},
+		CandidateCoins:   []CandidateCoin{{Symbol: "BTCUSDT", Sources: []string{"backtest"}}},
+		Positions:        []PositionInfo{{Symbol: "BTCUSDT", Side: "long", UpdateTime: entry.UnixMilli()}},
+		MarketDataMap:    map[string]*market.Data{"BTCUSDT": {Symbol: "BTCUSDT", CurrentPrice: 100}},
+	}
+	decision, err := GetFullDecisionWithStrategy(ctx, model, engine, "baseline")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !model.called || decision == nil || len(decision.Decisions) != 1 {
+		t.Fatal("historical decision did not reach fake model")
+	}
+	if len(ctx.OITopDataMap) != 0 {
+		t.Fatal("current OI leaked into historical context")
+	}
+	if !strings.Contains(model.userPrompt, "Holding Duration 2h 30m") {
+		t.Fatalf("wrong historical age in actual model prompt: %s", model.userPrompt)
+	}
+}
+
+func TestHistoricalDecisionRejectsMissingSnapshot(t *testing.T) {
+	engine := NewStrategyEngine(&store.StrategyConfig{})
+	engine.nofxosClient = nil
+	model := &historicalDecisionModel{}
+	_, err := GetFullDecisionWithStrategy(&Context{SimulationTimeMS: 1577847600000}, model, engine, "baseline")
+	if err == nil || !strings.Contains(err.Error(), "historical market snapshot is required") {
+		t.Fatalf("expected missing historical snapshot error, got %v", err)
+	}
+	if model.called {
+		t.Fatal("model called without historical snapshot")
+	}
+}
