+type liteLLMFixtureRequest struct {
+	authorization string
+	providerKey   string
+	model         string
+	structured    bool
+}
+
+func useLiteLLMRoutingConfig(t *testing.T, baseURL, tokenFile string) {
+	t.Helper()
+	configPath := filepath.Join(t.TempDir(), "routing.json")
+	configBytes, err := json.Marshal(liteLLMRoutingConfig{BaseURL: baseURL, TokenFile: tokenFile})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(configPath, configBytes, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	previousPath := liteLLMRoutingConfigPath
+	liteLLMRoutingConfigPath = configPath
+	t.Cleanup(func() { liteLLMRoutingConfigPath = previousPath })
+}
+
+func TestHistoricalLiteLLMRoutingUsesRequestLocalGatewayState(t *testing.T) {
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("gateway-first\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	var mu sync.Mutex
+	var requests []liteLLMFixtureRequest
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/chat/completions" {
+			t.Errorf("wrong gateway path: %s", r.URL.Path)
+		}
+		if r.Header.Get("x-api-key") != "" {
+			t.Error("provider header bypassed LiteLLM")
+		}
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		format, structured := body["response_format"].(map[string]any)
+		if structured && format["type"] != "json_schema" {
+			t.Error("structured response format changed")
+		}
+		mu.Lock()
+		requests = append(requests, liteLLMFixtureRequest{
+			authorization: r.Header.Get("Authorization"),
+			providerKey:   body["api_key"].(string),
+			model:         body["model"].(string),
+			structured:    structured,
+		})
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"choices":[{"finish_reason":"stop","message":{"content":"fixture"}}]}`))
+	}))
+	defer server.Close()
+	useLiteLLMRoutingConfig(t, server.URL, tokenFile)
+
+	client := NewClaudeClientWithOptions(
+		WithAPIKey("persisted-provider-key"),
+		WithBaseURL("https://provider.invalid/v1"),
+		WithModel(LiteLLMOpenRouterFreeModel),
+		WithMaxRetries(1),
+		WithHTTPClient(server.Client()),
+	).(*ClaudeClient)
+	if _, err := client.CallWithMessages("system", "fixture"); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	first := requests[0]
+	mu.Unlock()
+	if first.authorization != "Bearer gateway-first" || first.providerKey != "persisted-provider-key" || first.model != LiteLLMOpenRouterFreeModel || first.structured {
+		t.Fatalf("first routed request changed: %#v", first)
+	}
+	if client.Provider != ProviderClaude || client.APIKey != "persisted-provider-key" || client.BaseURL != "https://provider.invalid/v1" {
+		t.Fatal("routing mutated the persisted client")
+	}
+
+	if err := os.WriteFile(tokenFile, []byte("gateway-rotated\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.CallWithRequest(&Request{
+		Messages: []Message{NewUserMessage("fixture")},
+		ResponseFormat: &ResponseFormat{Type: "json_schema", JSONSchema: JSONSchema{
+			Name: "fixture", Strict: true, Schema: map[string]any{"type": "object"},
+		}},
+		Provider: &ProviderPreferences{RequireParameters: true},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	second := requests[1]
+	mu.Unlock()
+	if second.authorization != "Bearer gateway-rotated" || second.providerKey != "persisted-provider-key" || !second.structured {
+		t.Fatalf("structured routed request changed: %#v", second)
+	}
+
+	client.SetAPIKey("updated-provider-key", "https://ignored.invalid/v1", LiteLLMOpenRouterFreeModel)
+	if _, err := client.CallWithMessages("system", "fixture"); err != nil {
+		t.Fatal(err)
+	}
+	mu.Lock()
+	third := requests[2]
+	mu.Unlock()
+	if third.authorization != "Bearer gateway-rotated" || third.providerKey != "updated-provider-key" {
+		t.Fatalf("updated persisted provider key was not forwarded: %#v", third)
+	}
+	if client.Provider != ProviderClaude || client.APIKey != "updated-provider-key" || client.BaseURL != "https://ignored.invalid/v1" {
+		t.Fatal("routing mutated the updated persisted client")
+	}
+
+	var wg sync.WaitGroup
+	errs := make(chan error, 8)
+	for range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := client.CallWithMessages("system", "fixture")
+			errs <- err
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	mu.Lock()
+	concurrent := append([]liteLLMFixtureRequest(nil), requests[3:]...)
+	mu.Unlock()
+	if len(concurrent) != 8 {
+		t.Fatalf("concurrent request count=%d", len(concurrent))
+	}
+	for _, request := range concurrent {
+		if request.authorization != "Bearer gateway-rotated" || request.providerKey != "updated-provider-key" || request.model != LiteLLMOpenRouterFreeModel {
+			t.Fatalf("concurrent request changed: %#v", request)
+		}
+	}
+
+	withoutProviderKey := NewClient(WithProvider(ProviderCustom), WithModel(LiteLLMOpenRouterFreeModel), WithMaxRetries(1), WithHTTPClient(server.Client()))
+	if _, err := withoutProviderKey.CallWithMessages("system", "fixture"); err == nil || !strings.Contains(err.Error(), "routing requires a configured provider API key") {
+		t.Fatalf("missing provider key did not fail closed: %v", err)
+	}
+	unsupportedModel := NewClient(WithProvider(ProviderCustom), WithAPIKey("fixture"), WithModel("not-gateway-allowed"), WithMaxRetries(1), WithHTTPClient(server.Client()))
+	if _, err := unsupportedModel.CallWithMessages("system", "fixture"); err == nil || !strings.Contains(err.Error(), `does not permit configured model "not-gateway-allowed"`) {
+		t.Fatalf("unsupported model did not fail closed: %v", err)
+	}
+	if err := os.Remove(tokenFile); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := client.CallWithMessages("system", "fixture"); err == nil || !strings.Contains(err.Error(), "read LiteLLM routing token") {
+		t.Fatalf("missing routing token did not fail closed: %v", err)
+	}
+	mu.Lock()
+	gotRequests := len(requests)
+	mu.Unlock()
+	if gotRequests != 11 {
+		t.Fatalf("failed route made a request: %d", gotRequests)
+	}
+}
