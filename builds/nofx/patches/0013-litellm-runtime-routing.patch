+func TestHistoricalLiteLLMRoutingErrorsDoNotEchoGatewayBody(t *testing.T) {
+	tokenFile := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(tokenFile, []byte("gateway-token\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		if body["api_key"] != "test-provider-key" { // checkov:skip=CKV_SECRET_6: Inert credential leak-detection fixture.
+			t.Fatal("provider credential was not sent to LiteLLM")
+		}
+		http.Error(w, "gateway-body-must-not-echo test-provider-key", http.StatusTooManyRequests)
+	}))
+	defer server.Close()
+	useLiteLLMRoutingConfig(t, server.URL, tokenFile)
+	client := NewClient(
+		WithProvider(ProviderCustom),
+		WithAPIKey("test-provider-key"),
+		WithBaseURL("https://provider.invalid/v1"),
+		WithModel(LiteLLMOpenRouterFreeModel),
+		WithMaxRetries(1),
+		WithHTTPClient(server.Client()),
+	)
+	for _, call := range []func() (string, error){
+		func() (string, error) { return client.CallWithMessages("system", "fixture") },
+		func() (string, error) {
+			return client.CallWithRequest(&Request{Messages: []Message{NewUserMessage("fixture")}})
+		},
+	} {
+		_, err := call()
+		if err == nil || !strings.Contains(err.Error(), "HTTP 429") || strings.Contains(err.Error(), "test-provider-key") || strings.Contains(err.Error(), "gateway-body-must-not-echo") {
+			t.Fatalf("gateway body leaked in error: %v", err)
+		}
+	}
+}
