+type liteLLMRoutingConfig struct {
+	BaseURL   string `json:"base_url"`
+	TokenFile string `json:"token_file"`
+}
+
+// routedRequestClient returns the original client when no mounted routing
+// configuration exists. When it does, it configures only a request-local copy
+// so concurrent users cannot overwrite each other's provider credentials.
+func (client *Client) routedRequestClient() (*Client, error) {
+	routed := *client
+	if err := routed.configureLiteLLMRouting(); err != nil {
+		return nil, err
+	}
+	if !routed.litellmRouting {
+		return client, nil
+	}
+	return &routed, nil
+}
+
+// configureLiteLLMRouting switches the request-local client to LiteLLM's
+// OpenAI-compatible chat endpoint. A missing mount retains upstream behavior;
+// malformed or incomplete mounted configuration never falls back direct.
+func (client *Client) configureLiteLLMRouting() error {
+	configBytes, err := os.ReadFile(liteLLMRoutingConfigPath)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("failed to read LiteLLM routing config: %w", err)
+	}
+	var routingConfig liteLLMRoutingConfig
+	if err := json.Unmarshal(configBytes, &routingConfig); err != nil {
+		return fmt.Errorf("failed to parse LiteLLM routing config: %w", err)
+	}
+	baseURL := strings.TrimRight(strings.TrimSpace(routingConfig.BaseURL), "/")
+	tokenFile := strings.TrimSpace(routingConfig.TokenFile)
+	if baseURL == "" || tokenFile == "" {
+		return fmt.Errorf("LiteLLM routing config requires base_url and token_file")
+	}
+	if client.Model != LiteLLMOpenRouterFreeModel {
+		return fmt.Errorf("LiteLLM routing does not permit configured model %q; add its gateway alias before using it", client.Model)
+	}
+
+	tokenBytes, err := os.ReadFile(tokenFile)
+	if err != nil {
+		return fmt.Errorf("failed to read LiteLLM routing token: %w", err)
+	}
+	gatewayToken := strings.TrimSpace(string(tokenBytes))
+	if gatewayToken == "" {
+		return fmt.Errorf("LiteLLM routing token is empty")
+	}
+	if strings.TrimSpace(client.APIKey) == "" {
+		return fmt.Errorf("LiteLLM routing requires a configured provider API key")
+	}
+
+	client.litellmProviderAPIKey = client.APIKey
+	client.Provider = ProviderCustom
+	client.APIKey = gatewayToken
+	client.BaseURL = baseURL
+	client.UseFullURL = false
+	client.hooks = client
+	client.litellmRouting = true
+	return nil
+}
+
+func (client *Client) addLiteLLMProviderAPIKey(requestBody map[string]any) {
+	if client.litellmRouting {
+		requestBody["api_key"] = client.litellmProviderAPIKey
+	}
+}
