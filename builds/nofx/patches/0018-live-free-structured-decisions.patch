+				case r.Method == http.MethodPost && r.URL.String() == "https://openrouter.ai/api/v1/chat/completions":
+					aiCalls++
+					var request struct {
+						Model          string                   `json:"model"`
+						ResponseFormat *mcp.ResponseFormat      `json:"response_format"`
+						Provider       *mcp.ProviderPreferences `json:"provider"`
+					}
+					if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+						t.Fatal(err)
+					}
+					if request.Model != "openrouter/free" || request.ResponseFormat == nil || request.ResponseFormat.Type != "json_schema" || !request.ResponseFormat.JSONSchema.Strict || request.Provider == nil || !request.Provider.RequireParameters {
+						t.Fatal("live request lost exact free model or strict provider contract")
+					}
+					schema, _ := json.Marshal(request.ResponseFormat.JSONSchema.Schema)
+					if !strings.Contains(string(schema), `"enum":["BTCUSD"]`) || !strings.Contains(string(schema), `"minItems":1`) || !strings.Contains(string(schema), `"maximum":1,`) || strings.Contains(string(schema), "open_short") {
+						t.Fatalf("wrong live spot schema: %s", schema)
+					}
+					if tc.networkError {
