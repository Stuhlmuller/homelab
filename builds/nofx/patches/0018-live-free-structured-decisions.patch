+++ b/mcp/free_router.go
@@ -0,0 +1,39 @@
+package mcp
+
+import (
+	"net/url"
+	"strings"
+)
+
+// IsFreeRouter opts in only the exact free model at its official API origin.
+func IsFreeRouter(model, baseURL string) bool {
+	if model != "openrouter/free" {
+		return false
+	}
+	u, err := url.Parse(baseURL)
+	return err == nil && u.Scheme == "https" && u.Host == "openrouter.ai" &&
+		u.User == nil && u.RawQuery == "" && !u.ForceQuery && u.Fragment == "" &&
+		u.RawPath == "" && strings.TrimRight(u.Path, "/") == "/api/v1"
+}
+
+type structuredFreeRouterClient struct{ AIClient }
+
+// NewStructuredFreeRouterClient shares the strict, one-attempt decision contract.
+// Fixed routing options follow caller options so they cannot enable paid models or retries.
+func NewStructuredFreeRouterClient(apiKey string, opts ...ClientOption) AIClient {
+	opts = append(opts, WithProvider(ProviderCustom), WithAPIKey(apiKey),
+		WithBaseURL("https://openrouter.ai/api/v1"), WithModel("openrouter/free"),
+		WithMaxRetries(1), WithUseFullURL(false))
+	return &structuredFreeRouterClient{AIClient: NewClient(opts...)}
+}
+
+func (c *structuredFreeRouterClient) CallWithStructuredOutput(systemPrompt, userPrompt string, schema map[string]any) (string, error) {
+	return c.AIClient.CallWithRequest(&Request{
+		Model:    "openrouter/free",
+		Messages: []Message{NewSystemMessage(systemPrompt), NewUserMessage(userPrompt)},
+		ResponseFormat: &ResponseFormat{Type: "json_schema", JSONSchema: JSONSchema{
+			Name: "trading_decisions", Strict: true, Schema: schema,
+		}},
+		Provider: &ProviderPreferences{RequireParameters: true},
+	})
+}
