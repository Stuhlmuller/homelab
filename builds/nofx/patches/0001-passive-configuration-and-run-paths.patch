diff --git a/web/src/components/ModelConfigModal.test.tsx b/web/src/components/ModelConfigModal.test.tsx
new file mode 100644
index 0000000..35a5a18
--- /dev/null
+++ b/web/src/components/ModelConfigModal.test.tsx
@@ -0,0 +1,65 @@
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ModelConfigModal } from './AITradersPage'
+import type { AIModel } from '../types'
+
+const model: AIModel = {
+  id: 'openrouter',
+  name: 'OpenRouter',
+  provider: 'openai',
+  enabled: true,
+  customApiUrl: 'https://openrouter.ai/api/v1/responses',
+  customModelName: 'openrouter/free',
+}
+
+afterEach(cleanup)
+
+describe('ModelConfigModal key preservation', () => {
+  it('saves an existing model endpoint without requesting its stored API key', () => {
+    const onSave = vi.fn()
+    render(
+      <ModelConfigModal
+        allModels={[model]}
+        configuredModels={[model]}
+        editingModelId={model.id}
+        onSave={onSave}
+        onDelete={vi.fn()}
+        onClose={vi.fn()}
+        language="en"
+      />
+    )
+    const endpoint = screen.getByDisplayValue(model.customApiUrl!)
+    fireEvent.change(endpoint, {
+      target: { value: 'https://openrouter.ai/api/v1' },
+    })
+    const submit = screen.getByRole('button', { name: /save config/i })
+    expect(submit).toBeEnabled()
+    fireEvent.click(submit)
+    expect(onSave).toHaveBeenCalledWith(
+      model.id,
+      '',
+      'https://openrouter.ai/api/v1',
+      'openrouter/free'
+    )
+  })
+
+  it('still requires a key when adding a new model', () => {
+    const onSave = vi.fn()
+    render(
+      <ModelConfigModal
+        allModels={[model]}
+        configuredModels={[]}
+        editingModelId={null}
+        onSave={onSave}
+        onDelete={vi.fn()}
+        onClose={vi.fn()}
+        language="en"
+      />
+    )
+    fireEvent.change(screen.getByRole('combobox'), {
+      target: { value: model.id },
+    })
+    expect(screen.getByRole('button', { name: /save config/i })).toBeDisabled()
+    expect(onSave).not.toHaveBeenCalled()
+  })
+})
