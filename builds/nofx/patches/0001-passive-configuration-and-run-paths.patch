+func TestBacktestValidFilesystemRunRoundTrip(t *testing.T) {
+	t.Chdir(t.TempDir())
+	UseDatabase(nil)
+	const id = "safe-run_1"
+	if err := ensureRunDir(id); err != nil {
+		t.Fatal(err)
+	}
+	cfg := &BacktestConfig{RunID: id, UserID: "fixture"}
