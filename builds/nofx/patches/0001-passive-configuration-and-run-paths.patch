+func TestBacktestHTTPRejectsInvalidRunIDs(t *testing.T) {
+	server := &Server{backtestManager: backtest.NewManager(nil)}
+	for name, handler := range map[string]gin.HandlerFunc{
+		"start":  server.handleBacktestStart,
+		"delete": server.handleBacktestDelete,
+		"status": server.handleBacktestStatus,
+		"export": server.handleBacktestExport,
+		"trace":  server.handleBacktestTrace,
+	} {
+		t.Run(name, func(t *testing.T) {
+			response := httptest.NewRecorder()
+			ctx, _ := gin.CreateTestContext(response)
+			ctx.Set("user_id", "safety-test")
+			ctx.Request = httptest.NewRequest(http.MethodPost, "/api/backtest/"+name+"?run_id=..%2Fprotected", strings.NewReader(`{"run_id":"../protected","config":{"run_id":"../protected"}}`))
+			ctx.Request.Header.Set("Content-Type", "application/json")
+			handler(ctx)
+			if response.Code != http.StatusBadRequest || !strings.Contains(response.Body.String(), "run_id must") {
+				t.Fatalf("invalid ID: HTTP %d %s", response.Code, response.Body.String())
+			}
+		})
+	}
+}
