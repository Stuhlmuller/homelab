+func TestBacktestRejectsTraversalBeforeFilesystemOrDatabase(t *testing.T) {
+	t.Chdir(t.TempDir())
+	if err := os.Mkdir("protected", 0700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join("protected", "keep")
+	if err := os.WriteFile(sentinel, []byte("retain"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	st, err := store.New("test.db")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer st.Close()
+	UseDatabase(st.DB())
+	defer UseDatabase(nil)
+	cases := map[string]func(string) error{
+		"mkdir":            ensureRunDir,
+		"checkpoint-read":  func(id string) error { _, err := LoadCheckpoint(id); return err },
+		"checkpoint-write": func(id string) error { return SaveCheckpoint(id, &Checkpoint{}) },
+		"config-read":      func(id string) error { _, err := LoadConfig(id); return err },
+		"config-write":     func(id string) error { return SaveConfig(id, &BacktestConfig{}) },
+		"metadata-read":    func(id string) error { _, err := LoadRunMetadata(id); return err },
+		"metadata-write":   func(id string) error { return SaveRunMetadata(&RunMetadata{RunID: id}) },
+		"equity-read":      func(id string) error { _, err := LoadEquityPoints(id); return err },
+		"equity-write":     func(id string) error { return appendEquityPoint(id, EquityPoint{}) },
+		"trades-read":      func(id string) error { _, err := LoadTradeEvents(id); return err },
+		"trades-write":     func(id string) error { return appendTradeEvent(id, TradeEvent{}) },
+		"metrics-read":     func(id string) error { _, err := LoadMetrics(id); return err },
+		"metrics-write":    func(id string) error { return PersistMetrics(id, &Metrics{}) },
+		"trace":            func(id string) error { _, err := LoadDecisionTrace(id, 1); return err },
+		"decisions":        func(id string) error { _, err := LoadDecisionRecords(id, 1, 0); return err },
+		"export":           func(id string) error { _, err := CreateRunExport(id); return err },
+		"lock-read":        func(id string) error { _, err := loadRunLock(id); return err },
+		"lock-write":       func(id string) error { return saveRunLock(&RunLockInfo{RunID: id}) },
+		"lock-delete":      deleteRunLock,
+		"delete":           func(id string) error { return NewManager(nil).Delete(id) },
+	}
+	for _, useDB := range []bool{true, false} {
+		if useDB {
+			UseDatabase(st.DB())
+		} else {
+			UseDatabase(nil)
+		}
+		for _, id := range []string{"../protected", "..", "/tmp/protected", "a/b", `a\b`, "", strings.Repeat("x", 65)} {
+			for name, call := range cases {
+				t.Run(name+"/"+id, func(t *testing.T) {
+					err := call(id)
+					if err == nil || !strings.Contains(err.Error(), "run_id must") {
+						t.Errorf("expected invalid run_id rejection, got %v", err)
+					}
+				})
+			}
+		}
+	}
+	if content, err := os.ReadFile(sentinel); err != nil || string(content) != "retain" {
+		t.Fatal("invalid run ID damaged unrelated data")
+	}
+}
+
+func TestBacktestRunIDSlugBoundaries(t *testing.T) {
+	for _, id := range []string{"a", "bt_20260914_120000", "Strategy-42_a", strings.Repeat("x", 64)} {
+		if err := ValidateRunID(id); err != nil {
+			t.Errorf("valid ID %q: %v", id, err)
+		}
+	}
+	for _, id := range []string{" ", " a", "a ", "-a", "_a", ".", "a.b", "中文", "a\x00b", "a\nb", "%2e%2e", strings.Repeat("x", 65)} {
+		if !errors.Is(ValidateRunID(id), ErrInvalidRunID) {
+			t.Errorf("accepted invalid ID %q", id)
+		}
+	}
+	manager := NewManager(nil)
+	called := false
+	manager.SetAIResolver(func(*BacktestConfig) error { called = true; return nil })
+	_, err := manager.Start(context.Background(), BacktestConfig{RunID: "../outside"})
+	if !errors.Is(err, ErrInvalidRunID) || called {
+		t.Fatal("invalid ID reached model resolution")
+	}
+}
