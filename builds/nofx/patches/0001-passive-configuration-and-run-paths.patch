+func configurationTestStore(t *testing.T) *store.Store {
+	t.Helper()
+	st, err := store.New(filepath.Join(t.TempDir(), "test.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { st.Close() })
+	cfg := config.Get()
+	previous := cfg.TransportEncryption
+	cfg.TransportEncryption = false
+	t.Cleanup(func() { cfg.TransportEncryption = previous })
+	return st
+}
+
+func configurationRequest(t *testing.T, handler gin.HandlerFunc, request any) *httptest.ResponseRecorder {
+	t.Helper()
+	payload, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(response)
+	ctx.Set("user_id", "safety-test")
+	ctx.Request = httptest.NewRequest(http.MethodPut, "/api/config", bytes.NewReader(payload))
+	ctx.Request.Header.Set("Content-Type", "application/json")
+	handler(ctx)
+	return response
+}
+
+func TestModelConfigurationSaveIsPassiveAndPreservesKey(t *testing.T) {
+	st := configurationTestStore(t)
+	const key = "test-only-key-not-for-network-use"
+	if err := st.AIModel().Create("safety-test", "openrouter", "OpenRouter", "openai", true, key, "https://example.invalid/responses"); err != nil {
+		t.Fatal(err)
+	}
+	// A configuration-only save must not need a runtime trader manager at all.
+	server := &Server{store: st}
+	defer func() {
+		if value := recover(); value != nil {
+			t.Errorf("model save touched runtime trader manager: %v", value)
+		}
+	}()
+	response := configurationRequest(t, server.handleUpdateModelConfigs, map[string]any{
+		"models": map[string]any{"openrouter": map[string]any{
+			"enabled": true, "api_key": "", "custom_api_url": "https://openrouter.ai/api/v1", "custom_model_name": "openrouter/free",
+		}},
+	})
+	if response.Code != http.StatusOK {
+		t.Fatalf("HTTP %d: %s", response.Code, response.Body.String())
+	}
+	saved, err := st.AIModel().Get("safety-test", "openrouter")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(saved.APIKey) != key || saved.CustomAPIURL != "https://openrouter.ai/api/v1" || saved.CustomModelName != "openrouter/free" {
+		t.Fatal("model edit failed to preserve key or save endpoint/model")
+	}
+}
+
+func TestConfigurationHandlersDoNotLogCredentials(t *testing.T) {
+	st := configurationTestStore(t)
+	server := &Server{store: st, traderManager: manager.NewTraderManager()}
+	var logs bytes.Buffer
+	previousOutput := logger.Log.Out
+	logger.Log.SetOutput(&logs)
+	t.Cleanup(func() { logger.Log.SetOutput(previousOutput) })
+	const modelKey = "model-secret-sentinel-7a18"
+	response := configurationRequest(t, server.handleUpdateModelConfigs, map[string]any{
+		"models": map[string]any{"openrouter": map[string]any{"enabled": true, "api_key": modelKey}},
+	})
+	if response.Code != http.StatusOK {
+		t.Fatalf("model HTTP %d", response.Code)
+	}
+	exchangeID, err := st.Exchange().Create("safety-test", "okx", "fixture", false, "", "", "", false, "", "", "", "", "", "", "", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	credentials := map[string]any{
+		"enabled":                     false,
+		"api_key":                     "fake-api",
+		"secret_key":                  "fake-secret", // pragma: allowlist secret - synthetic regression fixture
+		"passphrase":                  "fake-pass",
+		"aster_private_key":           "fake-aster",
+		"lighter_private_key":         "fake-lighter",   // pragma: allowlist secret - synthetic regression fixture
+		"lighter_api_key_private_key": "fake-light-api", // pragma: allowlist secret - synthetic regression fixture
+	}
+	response = configurationRequest(t, server.handleUpdateExchangeConfigs, map[string]any{"exchanges": map[string]any{exchangeID: credentials}})
+	if response.Code != http.StatusOK {
+		t.Fatalf("exchange HTTP %d", response.Code)
+	}
+	if strings.Contains(logs.String(), modelKey) {
+		t.Error("model key leaked to logs")
+	}
+	for field, value := range credentials {
+		if secret, ok := value.(string); ok && strings.Contains(logs.String(), secret) {
+			t.Errorf("exchange %s leaked to logs", field)
+		}
+	}
+}
