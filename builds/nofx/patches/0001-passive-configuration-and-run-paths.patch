new file mode 100644
index 0000000..2f4c35b
--- /dev/null
+++ b/backtest/runid.go
@@ -0,0 +1,20 @@
+package backtest
+
+import (
+	"errors"
+	"regexp"
+)
+
+// ErrInvalidRunID prevents untrusted or previously stored IDs from becoming paths.
+var ErrInvalidRunID = errors.New("run_id must be 1-64 ASCII letters, digits, underscores or hyphens, starting with a letter or digit")
+
+var runIDPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$`)
+
+// ValidateRunID is also required when loading, exporting or deleting old runs.
+// Start-time validation alone cannot protect paths derived from stored records.
+func ValidateRunID(runID string) error {
+	if !runIDPattern.MatchString(runID) {
+		return ErrInvalidRunID
+	}
+	return nil
+}
