+func TestBacktestRetentionRejectsPoisonedHistoricalID(t *testing.T) {
+	t.Chdir(t.TempDir())
+	UseDatabase(nil)
+	if err := os.Mkdir("protected", 0700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join("protected", "keep")
