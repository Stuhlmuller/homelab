+		t.Fatal(err)
+	}
+	idx := &RunIndex{Runs: map[string]RunIndexEntry{
+		"../protected": {RunID: "../protected", State: RunStateCompleted, UpdatedAtISO: "2020-01-01T00:00:00Z"},
