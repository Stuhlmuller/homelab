+	}
+	if _, err := LoadRunMetadata(id); err != nil {
+		t.Fatal(err)
+	}
+	if err := saveRunLock(&RunLockInfo{RunID: id}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := loadRunLock(id); err != nil {
+		t.Fatal(err)
+	}
+	if err := deleteRunLock(id); err != nil {
+		t.Fatal(err)
+	}
+	archive, err := CreateRunExport(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.Remove(archive)
+	if info, err := os.Stat(archive); err != nil || info.Size() == 0 {
+		t.Fatal("valid export missing")
