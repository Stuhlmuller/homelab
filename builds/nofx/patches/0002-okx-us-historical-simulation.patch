+package market
+
+import (
+	"testing"
+	"time"
+)
+
+func TestHistoricalSource(t *testing.T) {
+	for input, want := range map[string]string{"": "binance", "binance": "binance", "okx_us": "okx_us", " OKX_US ": "okx_us"} {
+		got, err := NormalizeHistoricalSource(input)
+		if err != nil || got != want {
+			t.Fatalf("source %q = %q, %v; want %q", input, got, err, want)
+		}
+	}
+	for _, input := range []string{"okx", "okx-global", "https://us.okx.com", "other"} {
+		if _, err := GetKlinesRangeFromSource(input, "BTCUSDT", "3m", time.Now().Add(-time.Hour), time.Now(), time.Now()); err == nil {
+			t.Fatalf("unexpected source accepted: %q", input)
+		}
+	}
+}
