+package backtest
+
+import (
+	"encoding/json"
+	"testing"
+
+	"nofx/market"
+)
+
+func TestHistoricalConfig(t *testing.T) {
+	for _, source := range []string{"", "okx_us", "binance"} {
+		cfg := BacktestConfig{RunID: "history-test", Symbols: []string{"BTCUSDT"}, StartTS: 1700000000, EndTS: 1700003600, MarketDataSource: source}
+		if err := cfg.Validate(); err != nil {
+			t.Fatal(err)
+		}
+		want := source
+		if want == "" {
+			want = "binance"
+		} // Legacy runs retain their original exchange.
+		data, err := json.Marshal(cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var saved BacktestConfig
+		if err := json.Unmarshal(data, &saved); err != nil {
+			t.Fatal(err)
+		}
+		if saved.MarketDataSource != want {
+			t.Fatalf("saved source=%q, want %q", saved.MarketDataSource, want)
+		}
+	}
+	cfg := BacktestConfig{RunID: "history-test", Symbols: []string{"BTCUSDT"}, StartTS: 1700000000, EndTS: 1700003600, MarketDataSource: "https://example.com"}
+	if err := cfg.Validate(); err == nil {
+		t.Fatal("unlisted source accepted")
+	}
+}
+
+func TestHistoricalSnapshotExcludesLaterCandleCloses(t *testing.T) {
+	// Acquired bars can include the next execution bar, but AI snapshots must
+	// never see it, nor the currently incomplete longer-timeframe candle.
+	df := DataFeed{symbolSeries: map[string]*symbolSeries{"BTCUSDT": {byTF: map[string]*timeframeSeries{
+		"3m":  {klines: []market.Kline{{OpenTime: 0, CloseTime: 179999}, {OpenTime: 180000, CloseTime: 359999}}, closeTimes: []int64{179999, 359999}},
+		"15m": {klines: []market.Kline{{OpenTime: 0, CloseTime: 899999}}, closeTimes: []int64{899999}},
+	}}}}
+	if got := df.sliceUpTo("BTCUSDT", "3m", 179999); len(got) != 1 || got[0].CloseTime != 179999 {
+		t.Fatalf("future primary candle visible: %+v", got)
+	}
+	if got := df.sliceUpTo("BTCUSDT", "15m", 179999); len(got) != 0 {
+		t.Fatalf("future longer candle visible: %+v", got)
+	}
+}
