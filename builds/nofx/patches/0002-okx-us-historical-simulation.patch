+package market
+
+import (
+	"fmt"
+	"strings"
+	"time"
+
+	"nofx/market/okxhistory"
+)
+
+// NormalizeHistoricalSource retains Binance provenance for older saved runs.
+func NormalizeHistoricalSource(source string) (string, error) {
+	switch strings.ToLower(strings.TrimSpace(source)) {
+	case "", "binance":
+		return "binance", nil
+	case "okx_us":
+		return "okx_us", nil
+	default:
+		return "", fmt.Errorf("unsupported historical market_data_source %q", source)
+	}
+}
+
+// GetKlinesRangeFromSource is only used by historical simulations and charts.
+// It does not construct an exchange trader or read exchange credentials.
+func GetKlinesRangeFromSource(source, symbol, timeframe string, start, end, asOf time.Time) ([]Kline, error) {
+	source, err := NormalizeHistoricalSource(source)
+	if err != nil {
+		return nil, err
+	}
+	if source == "binance" {
+		return GetKlinesRange(symbol, timeframe, start, end)
+	}
+	candles, err := okxhistory.GetRange(Normalize(symbol), timeframe, start, end, asOf)
+	if err != nil {
+		return nil, err
+	}
+	klines := make([]Kline, len(candles))
+	for i, c := range candles {
+		klines[i] = Kline{OpenTime: c.OpenTime, CloseTime: c.CloseTime, Open: c.Open, High: c.High, Low: c.Low, Close: c.Close, Volume: c.Volume}
+	}
+	return klines, nil
+}
