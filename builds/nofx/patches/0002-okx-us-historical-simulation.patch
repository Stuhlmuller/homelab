@@ -0,0 +1,184 @@
+package okxhistory
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+type fakeDoer func(*http.Request) (*http.Response, error)
+
+func (f fakeDoer) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+func row(ts int64, confirm string) []string {
+	return []string{strconv.FormatInt(ts, 10), "100", "110", "90", "105", "700", "7", "735", confirm}
+}
+func response(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader(body))}
+}
+func candleResponse(rows [][]string) *http.Response {
+	b, _ := json.Marshal(map[string]any{"code": "0", "data": rows})
+	return response(200, string(b))
+}
+
+func TestRangePaginatesDeduplicatesAndSorts(t *testing.T) {
+	base := time.Unix(1700000000, 0)
+	d := 3 * time.Minute
+	ts := func(i int) int64 { return base.Add(time.Duration(i) * d).UnixMilli() }
+	calls, waits := 0, 0
+	client := fakeDoer(func(r *http.Request) (*http.Response, error) {
+		if r.Method != "GET" || r.URL.Host != "us.okx.com" || r.URL.Path != "/api/v5/market/history-candles" {
+			t.Fatalf("unexpected public endpoint: %s %s", r.Method, r.URL)
+		}
+		if len(r.Header) != 0 || r.Body != nil {
+			t.Fatalf("public reader must not send credentials, headers or body: %v", r.Header)
+		}
+		q := r.URL.Query()
+		if q.Get("instId") != "BTC-USDT-SWAP" || q.Get("bar") != "3m" || q.Get("limit") != "300" {
+			t.Fatalf("bad query: %v", q)
+		}
+		calls++
+		switch calls {
+		case 1:
+			if q.Get("after") != strconv.FormatInt(ts(3)+1, 10) {
+				t.Fatalf("first exclusive cursor: %v", q)
+			}
+			return candleResponse([][]string{row(ts(3), "1"), row(ts(2), "1")}), nil
+		case 2:
+			if q.Get("after") != strconv.FormatInt(ts(2), 10) {
+				t.Fatalf("pagination cursor: %v", q)
+			}
+			return candleResponse([][]string{row(ts(2), "1"), row(ts(1), "1"), row(ts(0), "1")}), nil
+		default:
+			t.Fatal("unexpected extra page")
+			return nil, nil
+		}
+	})
+	got, err := getRange(client, func() { waits++ }, "btcusdt", "3m", base, base.Add(3*d), base.Add(4*d))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 4 || calls != 2 || waits != 2 {
+		t.Fatalf("candles=%d calls=%d waits=%d", len(got), calls, waits)
+	}
+	for i, c := range got {
+		if c.OpenTime != ts(i) || c.CloseTime != ts(i+1)-1 || c.Volume != 7 || c.Open != 100 || c.High != 110 || c.Low != 90 || c.Close != 105 {
+			t.Fatalf("candle %d: %+v", i, c)
+		}
+	}
+}
+
+func TestRangeExcludesUnconfirmedOutsideRangeAndFutureCloses(t *testing.T) {
+	base := time.Unix(1700000000, 0)
+	d := 15 * time.Minute
+	ts := func(i int) int64 { return base.Add(time.Duration(i) * d).UnixMilli() }
+	client := fakeDoer(func(r *http.Request) (*http.Response, error) {
+		return candleResponse([][]string{row(ts(4), "1"), row(ts(3), "1"), row(ts(2), "0"), row(ts(1), "1"), row(ts(0), "1"), row(ts(-1), "1")}), nil
+	})
+	got, err := getRange(client, func() {}, "ETHUSDT", "15m", base, base.Add(3*d), base.Add(3*d+d/2))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].OpenTime != ts(0) || got[1].OpenTime != ts(1) {
+		t.Fatalf("unexpected closed candles: %+v", got)
+	}
+}
+
+func TestMappings(t *testing.T) {
+	for tf, expected := range map[string]string{"1m": "1m", "3m": "3m", "5m": "5m", "15m": "15m", "30m": "30m", "1h": "1H", "2h": "2H", "4h": "4H", "6h": "6Hutc", "12h": "12Hutc", "1d": "1Dutc"} {
+		bar, d, err := barSpec(tf)
+		if err != nil || bar != expected || d <= 0 {
+			t.Fatalf("bar %s: %s %v %v", tf, bar, d, err)
+		}
+	}
+	for _, s := range []string{"BTCUSDT", "ETHUSDT", "SOLUSDT"} {
+		got, err := instrumentID(s)
+		want := strings.TrimSuffix(s, "USDT") + "-USDT-SWAP"
+		if err != nil || got != want {
+			t.Fatalf("instrument %s: %s %v", s, got, err)
+		}
+	}
+	for _, s := range []string{"BTC", "USDT", "BTC-USD", "BTC-USDT-SWAP", "https://example.com", "XYZ:BTCUSDT"} {
+		if _, err := instrumentID(s); err == nil {
+			t.Fatalf("accepted invalid symbol %q", s)
+		}
+	}
+	if _, _, err := barSpec("7m"); err == nil {
+		t.Fatal("accepted invalid timeframe")
+	}
+}
+
+func TestFailuresRemainErrors(t *testing.T) {
+	base := time.Unix(1700000000, 0)
+	for _, tc := range []struct {
+		name   string
+		status int
+		body   string
+	}{
+		{"regional denial", 451, "unavailable"},
+		{"forbidden", 403, "forbidden"},
+		{"redirect", 302, "redirect"},
+		{"rate limit", 429, "slow down"},
+		{"API error", 200, `{"code":"51001","data":[]}`},
+		{"missing API code", 200, `{"data":[]}`},
+		{"bad JSON", 200, `no`},
+		{"short row", 200, `{"code":"0","data":[["1700000000000"]]}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			client := fakeDoer(func(*http.Request) (*http.Response, error) { calls++; return response(tc.status, tc.body), nil })
+			if _, err := getRange(client, func() {}, "BTCUSDT", "3m", base, base.Add(time.Hour), base.Add(2*time.Hour)); err == nil {
+				t.Fatal("expected error")
+			}
+			if calls != 1 {
+				t.Fatalf("must not retry or use fallback: calls=%d", calls)
+			}
+		})
+	}
+}
+
+func TestMalformedCandles(t *testing.T) {
+	for _, tc := range []struct {
+		index int
+		value string
+	}{{0, "bad"}, {0, "-1"}, {0, "9223372036854775807"}, {1, "NaN"}, {2, "+Inf"}, {3, "-1"}, {4, "0"}, {6, "bad"}, {6, "-1"}, {8, "2"}, {2, "99"}, {3, "101"}} {
+		t.Run(fmt.Sprintf("%d-%s", tc.index, tc.value), func(t *testing.T) {
+			r := row(1700000000000, "1")
+			r[tc.index] = tc.value
+			if _, _, err := parseCandle(r, 4*time.Hour); err == nil {
+				t.Fatal("accepted malformed candle")
+			}
+		})
+	}
+}
+
+func TestPaginationMustAdvance(t *testing.T) {
+	base := time.Unix(1700000000, 0)
+	client := fakeDoer(func(r *http.Request) (*http.Response, error) {
+		cursor, _ := strconv.ParseInt(r.URL.Query().Get("after"), 10, 64)
+		return candleResponse([][]string{row(cursor, "1")}), nil
+	})
+	_, err := getRange(client, func() {}, "BTCUSDT", "3m", base, base.Add(time.Hour), base.Add(2*time.Hour))
+	if err == nil || !strings.Contains(err.Error(), "did not advance") {
+		t.Fatalf("expected progress error, got %v", err)
+	}
+}
+
+func TestConflictingDuplicateRejected(t *testing.T) {
+	base := time.Unix(1700000000, 0)
+	client := fakeDoer(func(*http.Request) (*http.Response, error) {
+		a := row(base.UnixMilli(), "1")
+		b := row(base.UnixMilli(), "1")
+		b[4] = "106"
+		return candleResponse([][]string{a, b}), nil
+	})
+	_, err := getRange(client, func() {}, "BTCUSDT", "3m", base, base.Add(time.Hour), base.Add(2*time.Hour))
+	if err == nil || !strings.Contains(err.Error(), "conflicting") {
+		t.Fatalf("expected duplicate conflict, got %v", err)
+	}
+}
