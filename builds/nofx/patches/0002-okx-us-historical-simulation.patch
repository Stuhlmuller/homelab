index 0000000..ff74854
--- /dev/null
+++ b/market/okxhistory/history.go
@@ -0,0 +1,192 @@
+// Package okxhistory reads public US OKX USDT perpetual candles for simulations.
+// It never uses account credentials or sends trading requests.
+package okxhistory
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"net/http"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const endpoint = "https://us.okx.com/api/v5/market/history-candles"
+
+// Candle uses milliseconds and base-asset volume, matching NOFX's candle model.
+type Candle struct {
+	OpenTime, CloseTime            int64
+	Open, High, Low, Close, Volume float64
+}
+
+type httpDoer interface {
+	Do(*http.Request) (*http.Response, error)
+}
+
+var requestGate struct {
+	sync.Mutex
+	last time.Time
+}
+
+// Public history is limited per IP. Share a conservative 5 requests/second
+// across concurrent backtests in this process (OKX permits 20 per 2 seconds).
+func waitForRequest() {
+	requestGate.Lock()
+	defer requestGate.Unlock()
+	if delay := time.Until(requestGate.last.Add(200 * time.Millisecond)); delay > 0 {
+		time.Sleep(delay)
+	}
+	requestGate.last = time.Now()
+}
+
+// GetRange returns confirmed candles with opening times in [start, end], sorted
+// oldest first. A candle must also have finished by asOf. No domain fallback or
+// redirects are allowed; regional access failures remain explicit errors.
+func GetRange(symbol, timeframe string, start, end, asOf time.Time) ([]Candle, error) {
+	client := &http.Client{
+		Timeout:       15 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+	return getRange(client, waitForRequest, symbol, timeframe, start, end, asOf)
+}
+
+var usdtSymbol = regexp.MustCompile(`^[A-Z0-9]+USDT$`)
+
+func instrumentID(symbol string) (string, error) {
+	symbol = strings.ToUpper(strings.TrimSpace(symbol))
+	if !usdtSymbol.MatchString(symbol) || symbol == "USDT" {
+		return "", fmt.Errorf("OKX historical data requires a USDT symbol, e.g. BTCUSDT")
+	}
+	return strings.TrimSuffix(symbol, "USDT") + "-USDT-SWAP", nil
+}
+
+func barSpec(timeframe string) (string, time.Duration, error) {
+	tf := strings.ToLower(strings.TrimSpace(timeframe))
+	bars := map[string]string{"1m": "1m", "3m": "3m", "5m": "5m", "15m": "15m", "30m": "30m", "1h": "1H", "2h": "2H", "4h": "4H", "6h": "6Hutc", "12h": "12Hutc", "1d": "1Dutc"}
+	bar, ok := bars[tf]
+	if !ok {
+		return "", 0, fmt.Errorf("unsupported OKX historical timeframe %q", timeframe)
+	}
+	if tf == "1d" {
+		return bar, 24 * time.Hour, nil
+	}
+	duration, err := time.ParseDuration(tf)
+	return bar, duration, err
+}
+
+func getRange(client httpDoer, wait func(), symbol, timeframe string, start, end, asOf time.Time) ([]Candle, error) {
+	instrument, err := instrumentID(symbol)
+	if err != nil {
+		return nil, err
+	}
+	bar, duration, err := barSpec(timeframe)
+	if err != nil {
+		return nil, err
+	}
+	if start.UnixMilli() < 0 || !end.After(start) || asOf.IsZero() || asOf.Before(start) {
+		return nil, fmt.Errorf("invalid OKX historical time range or as-of time")
+	}
+	startMS, endMS, asOfMS := start.UnixMilli(), end.UnixMilli(), asOf.UnixMilli()
+	cursor := min(endMS, asOfMS)
+	if cursor == math.MaxInt64 {
+		return nil, fmt.Errorf("OKX historical time range overflows")
+	}
+	cursor++ // OKX's after boundary is exclusive.
+	candles := make(map[int64]Candle)
+	for cursor > startMS {
+		req, err := http.NewRequest(http.MethodGet, endpoint, nil)
+		if err != nil {
+			return nil, err
+		}
+		q := req.URL.Query()
+		q.Set("instId", instrument)
+		q.Set("bar", bar)
+		q.Set("limit", "300")
+		q.Set("after", strconv.FormatInt(cursor, 10))
+		req.URL.RawQuery = q.Encode()
+		wait()
+		resp, err := client.Do(req)
+		if err != nil {
+			return nil, fmt.Errorf("OKX US public history request: %w", err)
+		}
+		var payload struct {
+			Code string     `json:"code"`
+			Data [][]string `json:"data"`
+		}
+		if resp.StatusCode != http.StatusOK {
+			resp.Body.Close()
+			return nil, fmt.Errorf("OKX US public history returned HTTP %d", resp.StatusCode)
+		}
+		err = json.NewDecoder(io.LimitReader(resp.Body, 2<<20)).Decode(&payload)
+		resp.Body.Close()
+		if err != nil {
+			return nil, fmt.Errorf("decode OKX historical candles: %w", err)
+		}
+		if payload.Code != "0" {
+			return nil, fmt.Errorf("OKX US public history returned API code %q", payload.Code)
+		}
+		if len(payload.Data) == 0 {
+			break
+		}
+		oldest := cursor
+		for _, row := range payload.Data {
+			candle, confirmed, err := parseCandle(row, duration)
+			if err != nil {
+				return nil, err
+			}
+			if candle.OpenTime < oldest {
+				oldest = candle.OpenTime
+			}
+			if !confirmed || candle.OpenTime < startMS || candle.OpenTime > endMS || candle.CloseTime >= asOfMS {
+				continue
+			}
+			if previous, ok := candles[candle.OpenTime]; ok && previous != candle {
+				return nil, fmt.Errorf("conflicting OKX historical candle at %d", candle.OpenTime)
+			}
+			candles[candle.OpenTime] = candle
+		}
+		if oldest >= cursor {
+			return nil, fmt.Errorf("OKX historical pagination did not advance")
+		}
+		cursor = oldest
+	}
+	result := make([]Candle, 0, len(candles))
+	for _, candle := range candles {
+		result = append(result, candle)
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i].OpenTime < result[j].OpenTime })
+	return result, nil
+}
+
+func parseCandle(row []string, duration time.Duration) (Candle, bool, error) {
+	var candle Candle
+	if len(row) < 9 {
+		return candle, false, fmt.Errorf("OKX historical candle has %d fields; expected 9", len(row))
+	}
+	ts, err := strconv.ParseInt(row[0], 10, 64)
+	if err != nil || ts < 0 || ts > math.MaxInt64-duration.Milliseconds() {
+		return candle, false, fmt.Errorf("invalid OKX historical candle timestamp")
+	}
+	candle.OpenTime, candle.CloseTime = ts, ts+duration.Milliseconds()-1
+	if row[8] != "0" && row[8] != "1" {
+		return candle, false, fmt.Errorf("invalid OKX candle confirmation flag")
+	}
+	values := []*float64{&candle.Open, &candle.High, &candle.Low, &candle.Close, &candle.Volume}
+	// volCcy (index 6) is base-asset volume for perpetuals; vol (5) is contracts.
+	for i, index := range []int{1, 2, 3, 4, 6} {
+		value, err := strconv.ParseFloat(row[index], 64)
+		if err != nil || math.IsNaN(value) || math.IsInf(value, 0) || value < 0 || (i < 4 && value == 0) {
+			return candle, false, fmt.Errorf("invalid OKX historical candle numeric field %d", index)
+		}
+		*values[i] = value
+	}
+	if candle.High < max(candle.Open, candle.Close) || candle.Low > min(candle.Open, candle.Close) {
+		return candle, false, fmt.Errorf("invalid OKX historical candle price range")
+	}
+	return candle, row[8] == "1", nil
+}
