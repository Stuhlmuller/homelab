+func TestLiveLeverageCapSurvivesDecisionParsing(t *testing.T) {
+	response := `<decision>[
+		{"symbol":"BTCUSDT","action":"open_long","leverage":20,"position_size_usd":100,"stop_loss":90,"take_profit":130},
+		{"symbol":"ETHUSDT","action":"open_short","leverage":10,"position_size_usd":100,"stop_loss":110,"take_profit":70},
+		{"symbol":"SOLUSDT","action":"open_long","leverage":5,"position_size_usd":100,"stop_loss":90,"take_profit":130}
+	]</decision>`
+	decision, err := parseFullDecisionResponse(response, 1000, 1, 1, 1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(decision.Decisions) != 3 {
+		t.Fatalf("got %d decisions, want 3", len(decision.Decisions))
+	}
+	for _, action := range decision.Decisions {
+		if action.Leverage != 1 {
+			t.Errorf("%s execution decision retained leverage %dx, want 1x", action.Symbol, action.Leverage)
+		}
+	}
+}
