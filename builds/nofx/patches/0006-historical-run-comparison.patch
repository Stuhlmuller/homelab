+import {
+  act,
+  cleanup,
+  render,
+  screen,
+  waitFor,
+  within,
+} from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { SWRConfig } from 'swr'
+import { BacktestComparison } from './BacktestComparison'
+import { api } from '../lib/api'
+import {
+  createBacktestRunId,
+  loadRecordedDecisionCounts,
+} from '../lib/backtestComparison'
+import type {
+  BacktestMetrics,
+  BacktestRunMetadata,
+  DecisionRecord,
+} from '../types'
+
+vi.mock('../lib/api', () => ({
+  api: { getBacktestMetrics: vi.fn(), getBacktestDecisions: vi.fn() },
+}))
+
+const decision = (success: boolean) => ({ success }) as DecisionRecord
+const metrics = (total_return_pct: number) =>
+  ({ total_return_pct }) as BacktestMetrics
+const run = (run_id: string, equity = 1000): BacktestRunMetadata => ({
+  run_id,
+  version: 1,
+  state: 'completed',
+  created_at: '',
+  updated_at: '',
+  summary: {
+    symbol_count: 3,
+    decision_tf: '4h',
+    processed_bars: 6,
+    progress_pct: 100,
+    equity_last: equity,
+    max_drawdown_pct: 0.5,
+    liquidated: false,
+  },
+})
+
+function renderRuns(
+  runs: BacktestRunMetadata[],
+  runIds = runs.map((item) => item.run_id)
+) {
+  return render(
+    <SWRConfig value={{ provider: () => new Map(), dedupingInterval: 0 }}>
+      <BacktestComparison runs={runs} runIds={runIds} language="en" />
+    </SWRConfig>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  vi.resetAllMocks()
+  vi.restoreAllMocks()
+  vi.useRealTimers()
+})
+
+describe('BacktestComparison', () => {
+  it('compares three runs in selection order, including completed runs with failed cycles', async () => {
+    const runs = [
+      run('bt_trend', 1002),
+      run('bt_mean', 999),
+      run('bt_breakout', 1000),
+    ]
+    vi.mocked(api.getBacktestMetrics).mockResolvedValue(metrics(0.2))
+    vi.mocked(api.getBacktestDecisions).mockImplementation(async (id) =>
+      id === 'bt_trend' ? [decision(true), decision(false)] : [decision(true)]
+    )
+    renderRuns(runs, ['bt_breakout', 'bt_trend', 'bt_mean'])
+    await screen.findByText('2 records; verify expected count')
+    const rows = screen.getAllByRole('row').slice(1)
+    expect(
+      rows.map((row) => within(row).getAllByRole('cell')[0].textContent)
+    ).toEqual(['bt_breakout', 'bt_trend', 'bt_mean'])
+    const trend = within(rows[1]).getAllByRole('cell')
+    expect(trend.map((cell) => cell.textContent)).toEqual([
+      'bt_trend',
+      'completed',
+      '1002.00',
+      '0.20%',
+      '0.50%',
+      '1',
+      '1',
+      '2 records; verify expected count',
+    ])
+    expect(
+      screen.getByText(/Failed or incomplete decisions are not valid scores/)
+    ).toBeInTheDocument()
+    expect(
+      screen.queryByRole('columnheader', { name: /rank|winner|eligibility/i })
+    ).not.toBeInTheDocument()
+  })
+
+  it.each([
+    ['HTTP 202 error payload', { error: 'metrics not ready yet' }],
+    ['nonfinite metrics', { total_return_pct: Number.NaN }],
+  ])('shows unavailable instead of zero for %s', async (_, payload) => {
+    vi.mocked(api.getBacktestMetrics).mockResolvedValue(
+      payload as BacktestMetrics
+    )
+    vi.mocked(api.getBacktestDecisions).mockResolvedValue([decision(false)])
+    renderRuns([run('bt_failed_cycle')])
+    await screen.findByText('1 records; verify expected count')
+    const cells = within(screen.getAllByRole('row')[1]).getAllByRole('cell')
+    expect(cells[3]).toHaveTextContent('Unavailable')
+    expect(cells[6]).toHaveTextContent('1')
+  })
+
+  it('does not invent zeros when metrics and decisions fail to load', async () => {
+    vi.mocked(api.getBacktestMetrics).mockRejectedValue(new Error('offline'))
+    vi.mocked(api.getBacktestDecisions).mockRejectedValue(new Error('offline'))
+    const unavailableRun = run('bt_unavailable', Number.NaN)
+    unavailableRun.summary.max_drawdown_pct = Number.POSITIVE_INFINITY
+    renderRuns([unavailableRun])
+    await waitFor(() => {
+      const cells = within(screen.getAllByRole('row')[1]).getAllByRole('cell')
+      expect(cells.slice(2).map((cell) => cell.textContent)).toEqual(
+        Array(6).fill('Unavailable')
+      )
+    })
+  })
+
+  it('loads later decision pages instead of hiding failures beyond the first 200', async () => {
+    vi.mocked(api.getBacktestMetrics).mockResolvedValue(metrics(0))
+    vi.mocked(api.getBacktestDecisions)
+      .mockResolvedValueOnce(Array.from({ length: 200 }, () => decision(true)))
+      .mockResolvedValueOnce([decision(false)])
+    renderRuns([run('bt_paginated')])
+    await screen.findByText('201 records; verify expected count')
+    expect(api.getBacktestDecisions).toHaveBeenNthCalledWith(
+      1,
+      'bt_paginated',
+      200,
+      0
+    )
+    expect(api.getBacktestDecisions).toHaveBeenNthCalledWith(
+      2,
+      'bt_paginated',
+      200,
+      200
+    )
+    const cells = within(screen.getAllByRole('row')[1]).getAllByRole('cell')
+    expect(cells[5]).toHaveTextContent('200')
+    expect(cells[6]).toHaveTextContent('1')
+  })
+
+  it('bounds paging and marks capped counts partial', async () => {
+    vi.mocked(api.getBacktestMetrics).mockResolvedValue(metrics(0))
+    vi.mocked(api.getBacktestDecisions).mockResolvedValue(
+      Array.from({ length: 200 }, () => decision(false))
+    )
+    renderRuns([run('bt_capped')])
+    await screen.findByText('Partial records (2000)')
+    expect(api.getBacktestDecisions).toHaveBeenCalledTimes(10)
+    expect(api.getBacktestDecisions).toHaveBeenLastCalledWith(
+      'bt_capped',
+      200,
+      1800
+    )
+  })
+
+  it('keeps loaded counts partial if a later page fails', async () => {
+    vi.mocked(api.getBacktestDecisions)
+      .mockResolvedValueOnce(Array.from({ length: 200 }, () => decision(true)))
+      .mockRejectedValueOnce(new Error('offline'))
+    expect(await loadRecordedDecisionCounts('bt_partial')).toEqual({
+      successful: 200,
+      failed: 0,
+      loaded: 200,
+      coverage: 'partial',
+    })
+  })
+
+  it.each([
+    ['not-ready response', { error: 'metrics not ready yet' }],
+    ['stale metrics', { total_return_pct: 0.1 }],
+  ])(
+    'refreshes a terminal %s after the final metrics are persisted',
+    async (_, early) => {
+      vi.useFakeTimers()
+      vi.mocked(api.getBacktestMetrics)
+        .mockResolvedValueOnce(metrics(0))
+        .mockResolvedValueOnce(early as BacktestMetrics)
+        .mockResolvedValue(metrics(2))
+      vi.mocked(api.getBacktestDecisions).mockResolvedValue([decision(true)])
+      const cache = new Map()
+      const table = (state: string) => (
+        <SWRConfig value={{ provider: () => cache, dedupingInterval: 0 }}>
+          <BacktestComparison
+            runIds={['bt_finishing']}
+            runs={[{ ...run('bt_finishing'), state }]}
+            language="en"
+          />
+        </SWRConfig>
+      )
+      const view = render(table('running'))
+      await act(async () => {
+        await Promise.resolve()
+      })
+      expect(api.getBacktestMetrics).toHaveBeenCalledTimes(1)
+      view.rerender(table('completed'))
+      await act(async () => {
+        await Promise.resolve()
+      })
+      expect(api.getBacktestMetrics).toHaveBeenCalledTimes(2)
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(5000)
+      })
+      expect(
+        within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+      ).toHaveTextContent('2.00%')
+      await act(async () => {
+        await vi.advanceTimersByTimeAsync(60000)
+      })
+      expect(api.getBacktestMetrics).toHaveBeenCalledTimes(4)
+    }
+  )
+
+  it('does not claim complete history for a changing run or an empty response', async () => {
+    vi.mocked(api.getBacktestMetrics).mockResolvedValue(metrics(0))
+    vi.mocked(api.getBacktestDecisions).mockImplementation(async (id) =>
+      id === 'bt_running' ? [decision(true)] : []
+    )
+    renderRuns([{ ...run('bt_running'), state: 'running' }, run('bt_empty')])
+    await screen.findByText('Partial records (1)')
+    await screen.findByText('No recorded decisions')
+    const empty = within(screen.getAllByRole('row')[2]).getAllByRole('cell')
+    expect(empty[5]).toHaveTextContent('Unavailable')
+    expect(empty[6]).toHaveTextContent('Unavailable')
+  })
+
+  it('recovers from a transient terminal metrics error without unbounded reads', async () => {
+    vi.useFakeTimers()
+    vi.spyOn(Math, 'random').mockReturnValue(0)
+    vi.mocked(api.getBacktestMetrics)
+      .mockRejectedValueOnce(new Error('temporary metrics failure'))
+      .mockResolvedValue(metrics(2))
+    vi.mocked(api.getBacktestDecisions).mockResolvedValue([decision(true)])
+    renderRuns([run('bt_retry')])
+    await act(async () => {
+      await Promise.resolve()
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('Unavailable')
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(5000)
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('2.00%')
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(60000)
+    })
+    expect(api.getBacktestMetrics).toHaveBeenCalledTimes(3)
+  })
+
+  it('stops retrying persistent terminal metrics failures', async () => {
+    vi.useFakeTimers()
+    vi.spyOn(Math, 'random').mockReturnValue(0)
+    vi.mocked(api.getBacktestMetrics).mockRejectedValue(new Error('offline'))
+    vi.mocked(api.getBacktestDecisions).mockResolvedValue([decision(true)])
+    renderRuns([run('bt_retry_bound')])
+    await act(async () => {
+      await Promise.resolve()
+    })
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(120000)
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('Unavailable')
+    expect(api.getBacktestMetrics).toHaveBeenCalledTimes(3)
+  })
+
+  it('hides cached return values during a failed final refresh', async () => {
+    vi.useFakeTimers()
+    vi.spyOn(Math, 'random').mockReturnValue(0)
+    vi.mocked(api.getBacktestMetrics)
+      .mockResolvedValueOnce(metrics(0.1))
+      .mockRejectedValueOnce(new Error('temporary metrics failure'))
+      .mockResolvedValue(metrics(2))
+    vi.mocked(api.getBacktestDecisions).mockResolvedValue([decision(true)])
+    renderRuns([run('bt_cached_retry')])
+    await act(async () => {
+      await Promise.resolve()
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('0.10%')
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(5000)
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('Unavailable')
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(5000)
+    })
+    expect(
+      within(screen.getAllByRole('row')[1]).getAllByRole('cell')[3]
+    ).toHaveTextContent('2.00%')
+  })
+})
+
+describe('generated backtest run IDs', () => {
+  it('includes a safe strategy slug and remains unique within one timestamp', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(new Date('2026-09-20T08:00:00.000Z'))
+    const first = createBacktestRunId('Sim - Trend')
+    const second = createBacktestRunId('Sim - Trend')
+    expect(first).toMatch(/^bt_sim_trend_20260920080000000_[a-f0-9]{12}$/)
+    expect(second).not.toBe(first)
+  })
+
+  it.each(['../../Sim / Breakout!', 'x'.repeat(200), '趋势', undefined])(
+    'keeps the server ID contract for %s',
+    (name) => {
+      expect(createBacktestRunId(name)).toMatch(
+        /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/
+      )
+    }
+  )
+})
