new file mode 100644
--- /dev/null
+++ b/web/src/components/BacktestComparison.tsx
@@ -0,0 +1,166 @@
+import { useRef } from 'react'
+import useSWR from 'swr'
+import { api } from '../lib/api'
+import { loadRecordedDecisionCounts } from '../lib/backtestComparison'
+import type { BacktestRunMetadata } from '../types'
+
+interface Props {
+  runIds: string[]
+  runs: BacktestRunMetadata[]
+  language: string
+}
+
+function ComparisonRow({
+  runId,
+  run,
+  language,
+}: {
+  runId: string
+  run?: BacktestRunMetadata
+  language: string
+}) {
+  const zh = language === 'zh'
+  const unavailable = zh ? '不可用' : 'Unavailable'
+  const terminal = ['completed', 'failed', 'stopped', 'liquidated'].includes(
+    run?.state ?? ''
+  )
+  const metricReads = useRef({ state: run?.state, count: 0 })
+  const { data: metrics, error: metricsError } = useSWR(
+    ['bt-compare-metrics', runId, run?.state],
+    () => {
+      if (metricReads.current.state !== run?.state) {
+        metricReads.current = { state: run?.state, count: 0 }
+      }
+      metricReads.current.count++
+      return api.getBacktestMetrics(runId)
+    },
+    {
+      // The runner publishes terminal status before saving final metrics.
+      // Read again twice after that transition, including HTTP 202 responses.
+      refreshInterval: () =>
+        terminal ? (metricReads.current.count < 3 ? 5000 : 0) : 10000,
+      shouldRetryOnError: true,
+      errorRetryCount: 2,
+      errorRetryInterval: 5000,
+    }
+  )
+  const { data: counts } = useSWR(
+    ['bt-compare-decisions', runId, run?.state],
+    () => loadRecordedDecisionCounts(runId),
+    { refreshInterval: terminal ? 0 : 10000, shouldRetryOnError: false }
+  )
+  const number = (value: unknown, suffix = '') =>
+    typeof value === 'number' && Number.isFinite(value)
+      ? `${value.toFixed(2)}${suffix}`
+      : unavailable
+  const hasRecords =
+    counts &&
+    counts.successful + counts.failed > 0 &&
+    counts.coverage !== 'unavailable'
+  const coverage = !counts
+    ? zh
+      ? '加载中'
+      : 'Loading'
+    : counts.coverage === 'unavailable'
+      ? unavailable
+      : !counts.loaded
+        ? zh
+          ? '没有决策记录'
+          : 'No recorded decisions'
+        : counts.coverage === 'partial' || !terminal
+          ? zh
+            ? `部分记录（${counts.loaded}）`
+            : `Partial records (${counts.loaded})`
+          : zh
+            ? `已返回 ${counts.loaded} 条；完整性未验证`
+            : `${counts.loaded} records; verify expected count`
+  return (
+    <tr className="border-t" style={{ borderColor: '#2B3139' }}>
+      <td className="p-3 font-mono text-xs break-all">{runId}</td>
+      <td className="p-3 capitalize">{run?.state ?? unavailable}</td>
+      <td className="p-3 text-right">{number(run?.summary?.equity_last)}</td>
+      <td className="p-3 text-right">
+        {number(metricsError ? undefined : metrics?.total_return_pct, '%')}
+      </td>
+      <td className="p-3 text-right">
+        {number(run?.summary?.max_drawdown_pct, '%')}
+      </td>
+      <td className="p-3 text-right">
+        {hasRecords ? counts.successful : unavailable}
+      </td>
+      <td
+        className="p-3 text-right"
+        style={{ color: counts?.failed ? '#F6465D' : undefined }}
+      >
+        {hasRecords ? counts.failed : unavailable}
+      </td>
+      <td className="p-3 text-xs" style={{ color: '#848E9C' }}>
+        {coverage}
+      </td>
+    </tr>
+  )
+}
+
+export function BacktestComparison({ runIds, runs, language }: Props) {
+  if (!runIds.length) return null
+  const zh = language === 'zh'
+  const columns = zh
+    ? [
+        '运行 ID',
+        '状态',
+        '最终/最新净值 (USDT)',
+        '净收益',
+        '最大回撤',
+        '已记录成功周期',
+        '已记录失败周期',
+        '决策覆盖范围',
+      ]
+    : [
+        'Run ID',
+        'Status',
+        'Ending/latest equity (USDT)',
+        'Net return',
+        'Max DD',
+        'Recorded successes',
+        'Recorded failures',
+        'Decision coverage',
+      ]
+  return (
+    <section
+      className="binance-card p-4"
+      aria-label={zh ? '已选运行对比' : 'Selected run comparison'}
+    >
+      <h2 className="font-semibold" style={{ color: '#EAECEF' }}>
+        {zh ? '已选运行对比' : 'Selected run comparison'}
+      </h2>
+      <p className="text-xs mt-2 mb-3" style={{ color: '#848E9C' }}>
+        {zh
+          ? '对比历史模拟。失败或不完整的决策不能作为有效得分。判断收益前，请核对相同设置及全部预期决策。'
+          : 'Compare historical simulations. Failed or incomplete decisions are not valid scores. Check matching settings and all expected decisions before judging returns.'}
+      </p>
+      <div className="overflow-x-auto">
+        <table className="w-full text-sm" style={{ color: '#EAECEF' }}>
+          <thead>
+            <tr>
+              {columns.map((column) => (
+                <th key={column} scope="col" className="p-3 text-left text-xs">
+                  {column}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {runIds.map((runId) => (
+              <ComparisonRow
+                key={runId}
+                runId={runId}
+                run={runs.find((run) => run.run_id === runId)}
+                language={language}
+              />
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  )
+}
