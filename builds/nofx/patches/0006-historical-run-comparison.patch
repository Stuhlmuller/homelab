diff --git a/web/src/lib/backtestComparison.ts b/web/src/lib/backtestComparison.ts
new file mode 100644
--- /dev/null
+++ b/web/src/lib/backtestComparison.ts
@@ -0,0 +1,61 @@
+import { api } from './api'
+
+const PAGE_SIZE = 200
+const MAX_PAGES = 10
+
+export interface RecordedDecisionCounts {
+  successful: number
+  failed: number
+  loaded: number
+  coverage: 'returned' | 'partial' | 'unavailable'
+}
+
+// These are counts of returned records, never proof that every scheduled cycle
+// was persisted. The API has no total or completeness contract.
+export async function loadRecordedDecisionCounts(
+  runId: string
+): Promise<RecordedDecisionCounts> {
+  const counts: RecordedDecisionCounts = {
+    successful: 0,
+    failed: 0,
+    loaded: 0,
+    coverage: 'partial',
+  }
+  let invalidRecord = false
+  for (let page = 0; page < MAX_PAGES; page++) {
+    try {
+      const records = await api.getBacktestDecisions(
+        runId,
+        PAGE_SIZE,
+        page * PAGE_SIZE
+      )
+      if (!Array.isArray(records)) throw new Error('Invalid decision response')
+      for (const record of records) {
+        if (record?.success === true) counts.successful++
+        else if (record?.success === false) counts.failed++
+        else invalidRecord = true
+      }
+      counts.loaded += records.length
+      if (records.length < PAGE_SIZE) {
+        counts.coverage = invalidRecord ? 'partial' : 'returned'
+        return counts
+      }
+    } catch {
+      counts.coverage = counts.loaded ? 'partial' : 'unavailable'
+      return counts
+    }
+  }
+  return counts
+}
+
+export function createBacktestRunId(strategyName?: string): string {
+  const slug =
+    (strategyName ?? 'run')
+      .toLowerCase()
+      .replace(/[^a-z0-9]+/g, '_')
+      .replace(/^_+|_+$/g, '')
+      .slice(0, 20) || 'run'
+  const timestamp = new Date().toISOString().replace(/\D/g, '')
+  const suffix = crypto.randomUUID().replace(/-/g, '').slice(0, 12)
+  return `bt_${slug}_${timestamp}_${suffix}`
+}
