FROM node:22.22.3-alpine3.22@sha256:cd7807368cf24826297cbad5dca1a44972ccfd770647db52a8c7589eb4599ac8 AS dependencies
WORKDIR /src
COPY upstream/web/package.json upstream/web/package-lock.json ./
RUN npm ci
COPY upstream/web/ ./

FROM dependencies AS tests
RUN npm test -- --run src/components/ModelConfigModal.test.tsx \
    src/components/BacktestComparison.test.tsx

FROM tests AS build
RUN npm run build

FROM ghcr.io/nofxaios/nofx/nofx-frontend:stable@sha256:6c1e56336433e82eb5e750034d2991a8dbebd89a6b19119c4b12601ef1842887 AS final
LABEL org.opencontainers.image.source="https://github.com/Stuhlmuller/homelab" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.description="NOFX pinned release with key-preserving model edits and OKX US historical simulation"
COPY --from=build /src/dist /usr/share/nginx/html
COPY --chmod=0644 nofx-source.tar.gz /usr/share/nginx/html/nofx-source.tar.gz
COPY upstream/LICENSE /usr/share/licenses/nofx/LICENSE
USER 10000:10000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1
CMD ["nginx", "-g", "daemon off;"]
