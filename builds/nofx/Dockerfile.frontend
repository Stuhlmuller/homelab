FROM cgr.dev/chainguard/node:latest-dev@sha256:f0944f14c490643d52a065095087ac62094ee5ef50c08b5892bc1a9c6a5c14e1 AS dependencies
USER 0
WORKDIR /src
COPY upstream/web/package.json upstream/web/package-lock.json ./
RUN npm ci
COPY upstream/web/ ./

FROM dependencies AS tests
RUN npm test -- --run src/components/ModelConfigModal.test.tsx \
    src/components/BacktestComparison.test.tsx \
    src/components/AITradersPage.start.test.tsx \
    src/components/AITradersPage.requests.test.tsx \
    src/lib/httpClient.test.ts \
    src/components/SpotCompetitionModal.test.tsx \
    src/components/TraderConfigModal.spot.test.tsx \
    src/components/CompetitionPage.test.tsx \
    src/components/CompetitionPage.availability.test.tsx \
    src/components/ComparisonChart.availability.test.tsx

FROM tests AS build
RUN npm run build

FROM ghcr.io/nofxaios/nofx/nofx-frontend:stable@sha256:6c1e56336433e82eb5e750034d2991a8dbebd89a6b19119c4b12601ef1842887 AS final
LABEL org.opencontainers.image.source="https://github.com/Stuhlmuller/homelab" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.description="NOFX pinned release with explicit spot allocations and measured agent competition"
COPY --from=build /src/dist /usr/share/nginx/html
COPY --chmod=0644 nofx-source.tar.gz /usr/share/nginx/html/nofx-source.tar.gz
COPY upstream/LICENSE /usr/share/licenses/nofx/LICENSE
USER 10000:10000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1
CMD ["nginx", "-g", "daemon off;"]
